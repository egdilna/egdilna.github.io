        {
          "id": "id_mkr37lpvi8jx4cyvb",
          "values": {
            "id_mjqo2i3i50g0eoj1w": "Provozovatel informačního systému veřejné správy",
            "id_mjqo44yzjpelps71r": "",
            "id_mjqp7suwt1injd047": "osoba nebo její součást, která zajišťuje funkčnost technických a programových prostředků tvořících informační systém veřejné správy. Provozováním informačního systému veřejné správy může správce pověřit jiné osoby nebo jejich součásti, pokud to jiný zákon nevylučuje",
            "id_mjqp87xh98zo7hdox": "",
            "id_mjqp95th01n847106": "Definice",
            "id_mjqpenwtvuh963ijm": "zákon 365/2000 o ISVS",
