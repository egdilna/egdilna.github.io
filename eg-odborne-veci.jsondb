        {
          "id": "id_mjwr4djv9qci2bmir",
          "values": {
            "id_mjwqawhi1gvh1otlw": "Obsah IK",
            "id_mjwqgvyxxb35j7mc4": "Zákon",
            "id_mjwqhtkknelrb51qs": "Zákona",
            "id_mjwqipnab1kur7znd": "č. 365/2000 Sb.",
            "id_mjwqj96wla995qmhu": "§ 5a, odst. 2, věta druhá",
            "id_mjwqjs2yz942q5idg": "V informační koncepci orgánu veřejné správy orgány veřejné správy stanoví své dlouhodobé cíle v oblasti řízení spravovaných informačních systémů veřejné správy a vymezí obecné principy pořizování, architektonických změn, vytváření, správy, provozování, užívání a rozvoje svých informačních systémů veřejné správy.",
            "id_mjwqmfxj0ao9afh8t": "§ 5a, odst. 2, věta druhá, Zákona č. 365/2000 Sb.: V informační koncepci orgánu veřejné správy orgány veřejné správy stanoví své dlouhodobé cíle v oblasti řízení spravovaných informačních systémů veřejné správy a vymezí obecné principy pořizování, architektonických změn, vytváření, správy, provozování, užívání a rozvoje svých informačních systémů veřejné správy.",
            "id_mjwqoo72g4bodu93i": "Zákon č. 365/2000 Sb. v § 5a, odst. 2, věta druhá říká: V informační koncepci orgánu veřejné správy orgány veřejné správy stanoví své dlouhodobé cíle v oblasti řízení spravovaných informačních systémů veřejné správy a vymezí obecné principy pořizování, architektonických změn, vytváření, správy, provozování, užívání a rozvoje svých informačních systémů veřejné správy.",
            "id_mjwqqyay31l3bnpia": "Zákon č. 365/2000 Sb."
          }
        },
        {
