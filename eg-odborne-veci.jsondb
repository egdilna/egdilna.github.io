          "fields": {
            "id_mjwqgvyxxb35j7mc4": "Zákon",
            "id_mjwqawhi1gvh1otlw": "Rejstříkový soud změny rejstříku do týdne",
            "id_mjwqhtkknelrb51qs": "Zákona",
            "id_mjwqipnab1kur7znd": "č. 304/2013",
            "id_mjwqj96wla995qmhu": "§ 56 odst. 1",
            "id_mjwqjs2yz942q5idg": "Rejstříkový soud provede zápis nebo rozhodne o návrhu usnesením ve lhůtě stanovené jiným zákonem, jinak nejpozději do 5 pracovních dnů."
