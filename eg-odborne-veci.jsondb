          "values": {
            "id_mjqo2i3i50g0eoj1w": "Kvalifikovaná elektronická pečeť",
            "id_mjqo44yzjpelps71r": "QSEAL",
            "id_mjqp7suwt1injd047": "zaručená elektronická pečeť, která je vytvořena pomocí kvalifikovaného prostředku pro vytváření elektronických pečetí a která je založena na kvalifikovaném certifikátu pro elektronickou pečeť",
