          "values": {
            "id_mjqo2i3i50g0eoj1w": "Uživatel informačního systému veřejné správy",
            "id_mjqo44yzjpelps71r": "",
            "id_mjqp7suwt1injd047": "osoba nebo její součást, která do informačního systému veřejné správy zapisuje data nebo data, případně i provozní údaje obsažené v informačním systému veřejné správy, využívá",
            "id_mjqp87xh98zo7hdox": "",
            "id_mjqp95th01n847106": "Definice",
