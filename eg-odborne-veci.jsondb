            "id_mjwqipnab1kur7znd": "2014/910",
            "id_mjwqj96wla995qmhu": "čl. 3 odst. 10",
            "id_mjwqjs2yz942q5idg": "elektronickým podpisem se rozumí data v elektronické podobě, která jsou připojena k jiným datům v elektronické podobě nebo jsou s nimi logicky spojena a která podepisující osoba používá k podepsání.",
            "id_mjwqmfxj0ao9afh8t": "čl. 3 odst. 10, Nařízení EU 2014/910: elektronickým podpisem se rozumí data v elektronické podobě, která jsou připojena k jiným datům v elektronické podobě nebo jsou s nimi logicky spojena a která podepisující osoba používá k podepsání.",
            "id_mjwqoo72g4bodu93i": "Nařízení EU 2014/910 v čl. 3 odst. 10 říká: elektronickým podpisem se rozumí data v elektronické podobě, která jsou připojena k jiným datům v elektronické podobě nebo jsou s nimi logicky spojena a která podepisující osoba používá k podepsání.",
            "id_mjwqqyay31l3bnpia": "Nařízení EU 2014/910"
          }
