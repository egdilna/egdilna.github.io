        {
          "id": "id_mjqqcyznesovtmc8h",
          "values": {
            "id_mjqo2i3i50g0eoj1w": "Pracovní workflow",
            "id_mjqp7suwt1injd047": "Proces, kdy se nad daty či nad dokumentem v příslušném systému provádí změny, úpravy, diskuse, vyjadření či kroky vedoucí k vyřízení dané věci. Skládá se z jednotlivých kroků, jejichž posloupnost je dána příslušným pracovním postupem a tyto kroky jsou vázány na zúčastněné uživatele. Narozdíl od schvalování se dokument či data mohou v průběhu tohoto procesu měnit.",
            "id_mjqp95th01n847106": "Vysvětlení",
            "id_mjqpenwtvuh963ijm": "zavedené názvosloví",
            "id_mjqpfb18n8oov2qye": "28.8.2025",
            "id_mjqpi9r8vgf39kqyr": "**Pracovní workflow** () : Proces, kdy se nad daty či nad dokumentem v příslušném systému provádí změny, úpravy, diskuse, vyjadření či kroky vedoucí k vyřízení dané věci. Skládá se z jednotlivých kroků, jejichž posloupnost je dána příslušným pracovním postupem a tyto kroky jsou vázány na zúčastněné uživatele. Narozdíl od schvalování se dokument či data mohou v průběhu tohoto procesu měnit.",
            "id_mjqpg1zllhdampkma": true
          }
        },
        {
          "id": "id_mjqqcyznzeptbi1wc",
          "values": {
            "id_mjqo2i3i50g0eoj1w": "Primární aktivum",
            "id_mjqp7suwt1injd047": "aktivum v podobě zpracovávané informace nebo poskytované služby",
            "id_mjqp95th01n847106": "Definice",
            "id_mjqpenwtvuh963ijm": "zákon 264/2025",
