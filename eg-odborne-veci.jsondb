          "values": {
            "id_mjqo2i3i50g0eoj1w": "Soukromoprávní mandát",
            "id_mjqp7suwt1injd047": "Zápis o oprávnění k zastupování jiné osoby, který přímo neplyne ze zákona, ale z rozhodnutí zastupované osoby, jako je třeba plná moc, apod. Jde o explicitní oprávnění.",
            "id_mjqp95th01n847106": "Vysvětlení",
            "id_mjqpenwtvuh963ijm": "zavedené názvosloví",
            "id_mjqpfb18n8oov2qye": "18.12.2024",
            "id_mjqpi9r8vgf39kqyr": "**Soukromoprávní mandát** () : Zápis o oprávnění k zastupování jiné osoby, který přímo neplyne ze zákona, ale z rozhodnutí zastupované osoby, jako je třeba plná moc, apod. Jde o explicitní oprávnění.",
            "id_mjqpg1zllhdampkma": true
          }
        },
