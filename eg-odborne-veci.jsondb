        {
          "id": "id_mjwr4djwq8asat9j1",
          "values": {
            "id_mjwqawhi1gvh1otlw": "Zveřejnění provozní dokumentace IS",
            "id_mjwqgvyxxb35j7mc4": "Vyhláška",
            "id_mjwqhtkknelrb51qs": "Vyhlášky",
            "id_mjwqipnab1kur7znd": "č. 360/2023",
            "id_mjwqj96wla995qmhu": "§ 11 odst. 3",
            "id_mjwqjs2yz942q5idg": "Orgán veřejné správy zveřejňuje sady dokumentací Provozní dokumentace informačního systému způsobem umožňujícím dálkový přístup; to neplatí, jestliže zveřejnění vylučuje jiný právní předpis1) nebo úkon anebo právní jednání vyžadované nebo umožněné takovým právním předpisem.",
            "id_mjwqmfxj0ao9afh8t": "§ 11 odst. 3, Vyhlášky č. 360/2023: Orgán veřejné správy zveřejňuje sady dokumentací Provozní dokumentace informačního systému způsobem umožňujícím dálkový přístup; to neplatí, jestliže zveřejnění vylučuje jiný právní předpis1) nebo úkon anebo právní jednání vyžadované nebo umožněné takovým právním předpisem.",
            "id_mjwqoo72g4bodu93i": "Vyhláška č. 360/2023 v § 11 odst. 3 říká: Orgán veřejné správy zveřejňuje sady dokumentací Provozní dokumentace informačního systému způsobem umožňujícím dálkový přístup; to neplatí, jestliže zveřejnění vylučuje jiný právní předpis1) nebo úkon anebo právní jednání vyžadované nebo umožněné takovým právním předpisem.",
            "id_mjwqqyay31l3bnpia": "Vyhláška č. 360/2023"
