      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbt34bat",
      "name": "Dokumenty podepisovat a opatřovat časovým razítkem",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Veřejnoprávní původce každý odesílaný či zveřejňovaný úřední dokument opatří elektronickým podpisem či elektronickou pečetí a kvalifikovaným časovým razítkem, aby byl dokument platný a měl všechny validační prvky.",
        "a_mumelbpfast4": "§ 5 zákona 297/2016",
