    {
      "id": "e_8c873d390a5a3",
      "name": "Rozhodnout o žádosti podle stanovisek dotčených správců dat",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Pokud řízený přístup nevyžaduje propojování dat různých správců dat, Digitální a informační agentura vyhoví žádosti ve vztahu k datům těch správců dat, kteří vydali souhlasné závazné stanovisko nebo vyjádření. Pokud propojování vyžaduje, vyhoví žádosti pouze tehdy, jestliže všichni dotčení správci dat vydali souhlasné závazné stanovisko nebo vyjádření.",
        "a_mumelbpfast4": "§ 17 odst. 2 a 3 věta první zákona 60/2026",
