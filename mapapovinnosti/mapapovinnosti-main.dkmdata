      "attributes": {
        "a_mumelbpegwrf": "Dojde-li v době, kdy je cloud computing předmětem nabídky cloud computingu zapsané v katalogu cloud computingu nebo kdy je poskytován orgánu veřejné správy, ke změně údajů vedených v katalogu cloud computingu, které poskytuje poskytovatel cloud computingu, anebo skutečností vyjádřených v podkladech podle § 6q odst. 5 nebo § 6t odst. 6 až 8, poskytovatel cloud computingu o této změně bezodkladně vyrozumí ministerstvo a současně mu předloží aktuální podklady",
        "a_mumelbpfast4": "§ 6y odst. 1 zákona 365/2000",
        "a_mumelbphpxua": 2092,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 1,
        "a_mumelbpgzy0h": [
          "Poskytovatelé cloud computingu"
        ]
