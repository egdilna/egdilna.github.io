    {
      "id": "e_mumelbsms25e",
      "name": "Vykonávat spisovou službu",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Podle § 63 a souvisejících, zákona 499/2004 musí původci vykonávat spisovou službu. Většina vykonává povinně v elektronické podobě v ESSL a ISSD, někteří si stále mohou vybrat i listinnou podobu, ovšem ostatní EG povinnosti jim zůstávají.",
