    {
      "id": "e_mumelc0nqaps",
      "name": "Realizovat programy ICT a pořízení a rozvoje informačních systémů jen se souhlasným stanoviskem OHA",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Orgány veřejné správy jsou povini uskutečnit programy obsahující pořízení nebo architektonické změny určených informačních systémů, jejichž návrhy dokumentace jsou povinny předložit agentuře k vyjádření, investiční záměry akcí pořízení nebo architektonické změny určených informačních systémů, které jsou povinny předložit agentuře k vyjádření, a projekty určených informačních systémů nebo jejich architektonických změn, které jsou povinny předložit agentuře k vyjádření, až po souhlasném vyjádření agentury nebo souhlasném rozhodnutí vlády,",
        "a_mumelbpfast4": "§ 5 odst. 2 písm. g) zákona 365/2000",
        "a_mumelbphpxua": 2019,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
          "Orgány veřejné správy",
          "Správci informačních systémů"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelc0o6nv5",
      "name": "Oznámit OHA zahájení a fungování zkušebního provozu určeného informačního systému",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Orgány veřejné správy jsou povini oznámit DIA zahájení zkušebního provozu určeného informačního systému souvisejícího s jeho pořízením nebo architektonickou změnou před tím, než tato skutečnost nastane, vést záznam o průběhu zkušebního provozu a zpřístupnit záznam agentuře dálkovým přístupem",
        "a_mumelbpfast4": "§ 5 odst. 2 písm. h) zákona 365/2000",
        "a_mumelbphpxua": 2020,
        "a_mumelbpjp2r8": "2023-04-07",
