    },
    {
      "id": "e_mumelbvqbs4h",
      "name": "Zapsat referenční údaje nebo jejich změnu",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
