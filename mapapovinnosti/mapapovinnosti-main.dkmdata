    {
      "id": "e_mumelbvn7rvh",
      "name": "Spravovat Centrální registr výročních zpráv",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Zřizuje se centrální registr jako informační systém veřejné správy, který slouží ke zveřejňování výročních zpráv podle § 18. Správcem centrálního registru je Ministerstvo vnitra.",
        "a_mumelbpfast4": "§ 18a odst. 1 zákona 106/1999",
        "a_mumelbphpxua": 637,
