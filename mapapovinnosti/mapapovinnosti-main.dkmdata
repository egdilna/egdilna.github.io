      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Povinný subjekt vyřizuje stížnosti na postup při vyřizování žádosti o poskytnutí informací. Postupuje podle § 16a zákona 106/1999.",
        "a_mumelbpfast4": "§ 16a zákona 106/1999",
