    {
      "id": "e_mumelbxodpm9",
      "name": "Vést Rejstřík orgánů veřejné moci a soukromoprávních uživatelů",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "DIA vede v informačním systému registru práv a povinností rejstřík orgánů veřejné moci a soukromoprávních uživatelů údajů. V rejstříku orgánů veřejné moci a soukromoprávních uživatelů údajů jsou vedeny o orgánu veřejné moci údaje stanovené v § 51 odst. 1 a údaj o datu zániku orgánu veřejné moci a o soukromoprávním uživateli údajů údaje stanovené v § 51 odst. 3.",
        "a_mumelbpfast4": "§ 52b odst. 1 zákona 111/2009",
        "a_mumelbphpxua": 772,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 3,
        "a_mumelbpgzy0h": [
          "Digitální a informační agentura"
        ]
      },
