    {
      "id": "e_mumelbt5v8hl",
      "name": "Zpracovat dokumenty doručené do datové schránky",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Držitel datové schránky řeší jemu doručené dokumenty a datové zprávy jež jsou doručeny do jeho datové schránky. Zpracování a evidence dokumentů se řídí souvisejícími povinnostmi i podle toho, od koho je dokument doručen a jaké povinnosti stran správy a evidence dokumentů má daný příjemce.",
        "a_mumelbpfast4": "Zákon 300/2008 a související třeba Zákon 499/2004 a Zákon 500/2004 a Zákon 297/2016",
