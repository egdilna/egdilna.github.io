    {
      "id": "e_mumelbuyfj7q",
      "name": "Zveřejnit postupy a životní situace",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Povinné subjekty musí zveřejnit a ve svém sídle zpřístupnit také postup, který musí povinný subjekt podle § 2 odst. 1 zákona 106/1999 dodržovat při vyřizování podání nebo podnětů, zveřejněný Ministerstvem vnitra na portálu veřejné správy v podobě popisu úkonů orgánu veřejné moci a úkonů subjektu, který při vykonávání těchto úkonů nepůsobí jako orgán veřejné moci, vedeného v základním registru agend, orgánů veřejné moci, soukromoprávních uživatelů údajů a některých práv a povinností.",
        "a_mumelbpfast4": "§ 5 odst. 2 písm. c) zákona 106/1999",
        "a_mumelbphpxua": 610,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 3,
        "a_mumelbpgzy0h": [
          "Povinné subjekty podle ZINF"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
