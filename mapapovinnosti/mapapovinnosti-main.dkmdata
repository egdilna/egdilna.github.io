    {
      "id": "e_mumelbsc7asx",
      "name": "Vést údaje o identifikátorech",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "V národním bodu se vede identifikátor prostředku pro elektronickou identifikaci a údaj o úrovni záruky tohoto prostředku, agendový identifikátor držitele pro agendu autentizace, identifikátor držitele v rámci kvalifikovaného systému a identifikátor držitele v rámci on-line služby nebo jiné činnosti splňující požadavky stanovené přímo použitelným předpisem Evropské unie upravujícím rámec interoperability. Tyto údaje se uchovávají po dobu 15 let od skončení platnosti prostředku pro elektronickou identifikaci.",
        "a_mumelbpfast4": "§ 21 odst. 1 písm. a) až d) a odst. 5 zákona 250/2017",
        "a_mumelbphpxua": 366,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 3,
        "a_mumelbpgzy0h": [
          "Digitální a informační agentura"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
