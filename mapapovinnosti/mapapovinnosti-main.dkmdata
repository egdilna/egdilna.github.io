    {
      "id": "e_mumelbpy1cmr",
      "name": "Vedení znalostní báze k informačním činnostem a informačním systémům",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Digitální a informační agentura ve spolupráci s orgány veřejné správy vyhledává, zpracovává, ukládá a vytváří nové informace, které jsou znalostní základnou pro kvalitní vytváření a rozvoj informačních systémů veřejné správy",
