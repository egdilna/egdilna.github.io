    {
      "id": "e_mumelbyjyt55",
      "name": "Řešit žádost o poskytnutí údajů z ROB a RPP jako oslovený obecní úřad",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Žádost o poskytnutí údajů z registru obyvatel a registru práv a povinností v listinné podobě může subjekt údajů zaslat kterémukoliv obecnímu úřadu obce s rozšířenou působností, krajskému úřadu a v případě údajů z registru obyvatel také Agentuře; žádost musí být opatřena úředně ověřeným podpisem. Úředně ověřený podpis se nevyžaduje, je-li žádost podepsána před zaměstnancem zařazeným ve správním orgánu, vůči kterému směřuje.",
        "a_mumelbpfast4": "§ 58 odst. 3 zákona 111/2009",
        "a_mumelbphpxua": 803,
        "a_mumelbpjp2r8": "2024-10-02",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 4,
        "a_mumelbpgzy0h": [
          "Digitální a informační agentura",
          "Obecní úřady"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbykr37j",
      "name": "Poskytnout údaje z ROB a RPP na kontaktním místě veřejné správy",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "O poskytnutí údajů z registru obyvatel a registru práv a povinností může subjekt údajů požádat osobně u kontaktního místa veřejné správy, u kteréhokoli obecního úřadu obce s rozšířenou působností nebo krajského úřadu a v případě údajů z registru obyvatel také u Agentury; subjekt údajů sdělí rozsah požadovaných údajů. Subjekt údajů provede svoji identifikaci pomocí elektronicky čitelného identifikačního dokladu a autentizuje se pomocí bezpečnostního osobního kódu, má-li ho zadán a je-li to technicky umožněno.",
        "a_mumelbpfast4": "§ 58 odst. 5 zákona 111/2009",
        "a_mumelbphpxua": 804,
        "a_mumelbpjp2r8": "2024-10-02",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 3,
        "a_mumelbpgzy0h": [
          "Digitální a informační agentura",
          "Kontaktní místa veřejné správy",
          "Orgány poskytující výpisy z RPP a ROB"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbylxkla",
      "name": "Poskytnout údaje z Registru obyvatel a Registru práv a povinností na základě ověřené plné moci",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Za subjekt údajů může požádat o poskytnutí údajů zmocněnec na základě zvláštní plné moci s úředně ověřeným podpisem zmocnitele; údaje se poskytnou zmocněnci.",
        "a_mumelbpfast4": "§ 58 odst. 10 zákona 111/2009",
        "a_mumelbphpxua": 805,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
          "Kontaktní místa veřejné správy",
          "Orgány poskytující výpisy z RPP a ROB"
        ]
      },
