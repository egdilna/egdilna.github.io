    {
      "id": "e_mumelc33s4v4",
      "name": "Předat údaje a výstup z informačního systému pro jeho vydání",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Správci informačních systémů veřejné správy jsou povinni předat ověřující osobě na požádání bezodkladně výstup z informačního systému veřejné správy opatřený datem a časem s uvedením hodiny, minuty a sekundy, kdy byl výstup vytvořen, a datem a časem s uvedením hodiny, minuty a sekundy okamžiku, ke kterému správce odpovídá za soulad výstupu se stavem zápisu v informačním systému veřejné správy (dále jen \"okamžik platnosti údajů\"), a zabezpečený způsobem zajišťujícím integritu, případně původ dat.",
        "a_mumelbpfast4": "§ 9c odst. 1 zákona 365/2000",
        "a_mumelbphpxua": 2109,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
