      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelc03bept",
      "name": "Sdělit shodu identifikačních údajů a BSI",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "V případě, že kombinace identifikačních údajů, které uživateli služby o sobě poskytla fyzická osoba, odpovídá kombinaci údajů vedených o fyzické osobě jako referenční údaje v registru obyvatel, správce národního bodu pro identifikaci a autentizaci vydá uživateli služby bezvýznamový směrový identifikátor fyzické osoby.",
        "a_mumelbpfast4": "§ 12a odst. 5 věta první zákona 12/2020",
        "a_mumelbphpxua": 946,
        "a_mumelbpjp2r8": "2023-04-07",
