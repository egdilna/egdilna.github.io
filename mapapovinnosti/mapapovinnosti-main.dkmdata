    {
      "id": "e_mumelbtxxm6d",
      "name": "Doručovat dokumenty mezi OVM datovou schránkou",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Umožňuje-li to povaha dokumentu, orgán veřejné moci jej doručuje jinému orgánu veřejné moci prostřednictvím datové schránky, pokud se nedoručuje na místě. Umožňuje-li to povaha dokumentu a má-li fyzická osoba, podnikající fyzická osoba nebo právnická osoba zpřístupněnu svou datovou schránku, orgán veřejné moci doručuje dokument této osobě prostřednictvím datové schránky, pokud se nedoručuje veřejnou vyhláškou nebo na místě. Doručuje-li se způsobem podle tohoto zákona, ustanovení jiných právních předpisů upravující způsob doručení se nepoužijí.",
        "a_mumelbpfast4": "§ 17 odst. 1 a 2 zákona 300/2008",
        "a_mumelbphpxua": 455,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
