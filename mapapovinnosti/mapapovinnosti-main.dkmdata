    },
    {
      "id": "e_mumelbtsaypm",
      "name": "Vést veřejný seznam držitelů datových schránek",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "DIA vede veřejný seznam fyzických osob, podnikajících fyzických osob, právnických osob a orgánů veřejné moci, které mají zřízenu a zpřístupněnu datovou schránku (dále jen „seznam držitelů datových schránek“), který je přístupný způsobem umožňujícím dálkový přístup. Seznam je součástí informačního systému datových schránek. Seznam držitelů datových schránek se člení na samostatné části vedené pro fyzické osoby, pro podnikající fyzické osoby, pro právnické osoby a pro orgány veřejné moci.",
        "a_mumelbpfast4": "§ 14b odst. 1 - 3 zákona 300/2008",
        "a_mumelbphpxua": 450,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 3,
        "a_mumelbpgzy0h": [
          "Digitální a informační agentura"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbttzq3m",
      "name": "Vymazat držitele datové schránky z veřejného seznamu na jeho žádost",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Na žádost fyzické osoby, která má zřízenu a zpřístupněnu datovou schránku, se údaje o ní vedené v seznamu držitelů datových schránek zlikvidují.",
        "a_mumelbpfast4": "§ 14b odst. 4 zákona 300/2008",
        "a_mumelbphpxua": 451,
        "a_mumelbpjp2r8": "2023-04-07",
