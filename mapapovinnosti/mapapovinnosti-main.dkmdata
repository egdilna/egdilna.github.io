      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Povinnost zveřejnit výroční zprávu lze splnit zveřejněním údajů podle odstavce 1 ve lhůtě podle odstavce 1 prostřednictvím centrálního registru.“.",
        "a_mumelbpfast4": "§ 18 odst. 2 zákona 106/1999",
