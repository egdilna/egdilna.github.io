    },
    {
      "id": "e_mumelbswiqc6",
      "name": "Zahrnout ESSL a ISSD systémy a věci k nim do svojí informační koncepce úřadu",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Orgán veřejné moci, který má podle zákona 365/2000 povinnost mít svojí informační koncepci, musí v této informační koncepci uvést jako svoje systémy veškeré ESSL a ISSD systémy a u systémů podle § 1, odst. 4 také musí zajistit soulad se zákonem 365/2000, včetně řádného rozvoje těchto systémů a řádného zajištění technického zabezpečení výkonu spisové služby.",
        "a_mumelbpfast4": "zákon 365/2000 a vyhláška 529/2006",
        "a_mumelbphpxua": 418,
        "a_mumelbpjp2r8": "2023-04-07",
