      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbsvwkvi",
      "name": "Vydávat a udržovat provozní a bezpečnostní dokumentaci k ESSL a ISSD systémům",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Orgán veřejné moci, který provozuje ESSL či ISSD systémy, musí u nich zajistit plný soulad s povinnostmi podle zákona 365/2000 (podle § 1, odst. 4, písm. c), a to včetně vydávání, udržování a aktualizace provozní dokumentace k těmto systémům, bezpečnostní dokumentace k těmto systémům a dodržování principů jejich realizace.",
        "a_mumelbpfast4": "zákon 365/2000 a vyhláška 529/2006",
        "a_mumelbphpxua": 417,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
          "Orgány veřejné moci",
          "Správci informačních systémů",
          "Veřejnoprávní původci"
        ]
      },
