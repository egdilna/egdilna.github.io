    {
      "id": "e_mumelbt90r0y",
      "name": "Oznámit působnost v agendě Spisová služba",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Původci, kteří jsou orgány veřejné správy musejí vést Jmenný rejstřík a popřípadě dělat další činnost v rámci agendy Spisová služba. Každý orgán veřejné moci automaticky ze zákona vykonává povinně působnost v agendě spisové služby a jeho [Jmenný rejstřík], [Elektronický systém spisové služby] a každý [Informační systém spravující dokumenty] jsou agendovými informačními systémy pro výkon v této agendě.",
        "a_mumelbpfast4": "§ 55 zákona 111/2009",
        "a_mumelbphpxua": 431,
