    },
    {
      "id": "e_mumelc2zzpra",
      "name": "Výstup z informačního systému opatřit ověřovací doložkou",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Ověřovací doložku vyhotoví ověřující na listině, která vznikla převedením výstupu z informačního systému veřejné správy z elektronické do listinné podoby, nebo ověřovací doložku vyhotoví zvlášť a s touto listinou ji pevně spojí. Listina, která vznikla převedením výstupu z informačního systému veřejné správy z elektronické do listinné podoby, a na ní vyhotovená nebo s ní pevně spojená ověřovací doložka, se považují za jednu listinu.",
        "a_mumelbpfast4": "§ 9a odst. 2 zákona 365/2000",
        "a_mumelbphpxua": 2105,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 1,
        "a_mumelbpgzy0h": [
          "Kontaktní místa veřejné správy"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelc30v7pw",
      "name": "Vydávat pouze fyzicky čitelné výstupy z informačního systému",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Ti, kteří vydávají ověřené výstupy (dále jen \"ověřující\"), jsou povinni při ověřování výstupu z informačního systému veřejné správy používat pouze takové technické zařízení, které výstup z informačního systému veřejné správy, který má být ověřen, zobrazí do formy, v níž je jeho obsah pro fyzickou osobu čitelný tak, aby jeho interpretace odpovídala zápisu v informačním systému veřejné správy.",
        "a_mumelbpfast4": "§ 9b odst. 1 zákona 365/2000",
        "a_mumelbphpxua": 2106,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 1,
        "a_mumelbpgzy0h": [
          "Kontaktní místa veřejné správy"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelc31bq3v",
      "name": "Ověřit bezpečnost a integritu výstupu z informačního systému před vydáním",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Ověřující je povinen provést veškeré úkony potřebné k tomu, aby ověřil tu skutečnost, že výstup z informačního systému veřejné správy je zabezpečen způsobem zajišťujícím integritu, případně původ dat.",
        "a_mumelbpfast4": "§ 9b odst. 2 zákona 365/2000",
