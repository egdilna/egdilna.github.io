    {
      "id": "e_mumelbsoyx3o",
      "name": "Vydat Spisový plán a realizovat ho",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Určení původci vydají spisový řád.. Součástí spisového řádu je spisový a skartační plán. Spisový a skartační plán obsahuje seznam typů dokumentů roztříděných do věcných skupin s vyznačenými spisovými znaky, skartačními znaky a skartačními lhůtami. Určení původci zasílají spisový a skartační plán příslušnému archivu bezodkladně po jeho vydání nebo změně. Příslušný archiv spisový a skartační plán uloží.",
        "a_mumelbpfast4": "§ 66 odst. 2 zákona 499/2004",
        "a_mumelbphpxua": 409,
        "a_mumelbpjp2r8": "2023-04-07",
