    {
      "id": "e_mumelbvol6em",
      "name": "Zveřejňovat a publikovat Centrální registr výročních zpráv",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Centrální registr je bezplatně a neomezeně veřejně přístupný způsobem umožňujícím dálkový přístup. Tedy se musí publikovat také jako otevřená data.",
        "a_mumelbpfast4": "§ 18a odst. 2 zákona 106/1999",
