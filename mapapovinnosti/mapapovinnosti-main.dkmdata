    },
    {
      "id": "e_mumelby184wz",
      "name": "Zajistit stanoviska správců registrů a informačních systémů",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "DIA zašle správci základního registru a správci agendového informačního systému, do něhož je požadován přístup, ohlášení podle odstavce 1 ke stanovisku z hlediska způsobilosti základního registru nebo agendového informačního systému zpřístupnit požadované údaje pro výkon agendy a vhodnosti zpřístupnit požadované údaje pro výkon agendy; to neplatí v případě, kdy přístup k požadovaným údajům stanoví zvláštní právní předpis. DIA dále zašle správci referenčního rozhraní ohlášení podle odstavce 1 ke stanovisku z hlediska realizovatelnosti vazeb mezi agendovými informačními systémy. Správci zasílají stanoviska prostřednictvím informačního systému registru práv a povinností ve struktuře, kterou DIA zveřejní způsobem umožňujícím dálkový přístup.",
        "a_mumelbpfast4": "§ 54 odst. 4 zákona 111/2009",
        "a_mumelbphpxua": 785,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
