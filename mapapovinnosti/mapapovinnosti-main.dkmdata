    {
      "id": "e_mumelbvg94wx",
      "name": "Neomezovat užití v licenční smlouvě na licencované informace",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Podmínky poskytnutí informace v licenční smlouvě musí umožňovat další užití informace žadatelem v souladu se žádostí, pokud tento zákon nestanoví jinak. Licence se poskytuje jako nevýhradní, s výjimkou případů podle odstavce 4.",
