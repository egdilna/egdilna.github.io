    {
      "id": "e_mumelc01vj48",
      "name": "Poskytnout informaci o shodě identifikačních údajů fyzické osoby",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Uživatel služby má právo na informaci, zda kombinace identifikačních údajů, které mu o sobě poskytla fyzická osoba nebo které obdržel od jiné osoby na základě prokazatelného právního vztahu, který měl právo uzavřít, odpovídá kombinaci údajů vedených o fyzické osobě jako referenční údaje v registru obyvatel. Právo uplatní uživatel služby u správce národního bodu pro identifikaci a autentizaci.",
        "a_mumelbpfast4": "§ 12a odst. 1 a 2 zákona 12/2020",
        "a_mumelbphpxua": 944,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
          "Digitální a informační agentura"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelc024o18",
      "name": "Poskytnout identifikační údaje k informaci o shodě",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Uživatel služby je povinen při uplatnění práva podle § 12a odstavce 1 prokázat správci národního bodu pro identifikaci a autentizaci svou totožnost a sdělit mu kombinaci poskytnutých identifikačních údajů v rozsahu: a) příjmení, b) jméno, popřípadě jména, c) adresa místa pobytu, d) datum narození a e) čísla a druhy identifikačních dokladů.",
        "a_mumelbpfast4": "§ 12a odst. 3 zákona 12/2020",
        "a_mumelbphpxua": 945,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
