      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Uživatel služby nesmí získaný bezvýznamový směrový identifikátor sdělovat třetím osobám s výjimkou orgánu veřejné moci.",
        "a_mumelbpfast4": "§ 12a odst. 6 zákona 12/2020",
