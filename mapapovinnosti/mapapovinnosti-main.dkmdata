    {
      "id": "e_mumelc2au4l0",
      "name": "Rozhodnout o žádosti o zápis nabídky cloudu",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "DIA rozhodne o žádosti o zápis nabídky cloud computingu podle podmínek a požadavků zákona o ISVS. Je-li žádosti v plném rozsahu vyhověno, písemné vyhotovení rozhodnutí se nevydává. Takové rozhodnutí nabývá právní moci dnem zápisu nabídky cloud computingu do katalogu cloud computingu. DIA o zápisu do katalogu cloud computingu vyrozumí poskytovatele cloud computingu, který o zápis požádal.",
        "a_mumelbpfast4": "§ 6t odst. 1 a 2 zákona 365/2000",
