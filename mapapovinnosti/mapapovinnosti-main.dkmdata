      "aspects": [
        "asp_mumieioe8paitd"
      ],
      "attributes": {
        "a_mumieioeanecjr": "2026-09-29",
        "a_mumieioezphjia": "Součástí této aplikace a databáze je i Mapa povinností, níže najdete informace právě k práci s touto verzí mapy.\n\n**Mapa povinností** je datová sada o základních EG povinnostech, ve které jsou dekomponovány nejdůležitější EG zákony do jednotlivých povinností a u povinností jsou uvedeny podrobnosti, včetně určení, koho se týká apod. Povinnosti lze vyhledávat, filtrovat a třídit, vazbit na jiná data v DKM a exportovat.",
        "a_mumieioeynsjq5": [
          "aktualizační robot",
          "EGdílna"
        ],
        "a_mumieioebxapeb": [
          "balíček DKM Mapa povinností"
        ]
      },
