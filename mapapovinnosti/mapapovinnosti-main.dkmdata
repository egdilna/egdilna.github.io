    {
      "id": "e_mumelbtrekee",
      "name": "Vést seznam poskytovatelů využívající přístupové rozhraní ISDS",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "DIA vede seznam poskytovatelů internetových služeb, kteří využívají přístupové rozhraní, a zveřejňuje jej způsobem umožňujícím dálkový přístup.",
        "a_mumelbpfast4": "§ 14a odst. 8 zákona 300/2008",
