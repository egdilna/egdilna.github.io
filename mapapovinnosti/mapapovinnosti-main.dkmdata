    {
      "id": "e_mumelbu5qbqn",
      "name": "Hradit za poštovní datové zprávy",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Za dodání dokumentu podle odstavce 1 náleží provozovateli informačního systému datových schránek odměna, která se stanoví podle cenových předpisů. Odměnu hradí fyzická osoba, podnikající fyzická osoba nebo právnická osoba, z jejíž datové schránky byl dokument odeslán. Tato osoba může určit, že bude hradit i dodání dokumentu, který je odpovědí na dokument dodaný podle předchozí věty. Odměnu podle věty první může za fyzickou osobu, podnikající fyzickou osobou nebo právnickou osobu, z jejíž datové schránky byl dokument odeslán, hradit rovněž jiná fyzická osoba, podnikající fyzická osoba nebo právnická osoba, předloží-li provozovateli informačního systému datových schránek písemný souhlas fyzické osoby, podnikající fyzické osoby nebo právnické osoby, z jejíž datové schránky byl dokument odeslán, s tímto způsobem úhrady odměny nebo jeho výstup z autorizované konverze dokumentů; podpis osoby v písemném souhlasu musí být úředně ověřen. Provozovatel informačního systému datových schránek vyrozumí prostřednictvím informačního systému datových schránek fyzickou osobu, podnikající fyzickou osobu nebo právnickou osobu, z jejíž datové schránky mají být odesílány dokumenty hrazené způsobem podle věty třetí nebo čtvrté, o tomto způsobu úhrady.",
        "a_mumelbpfast4": "§ 18a odst. 3 zákona 300/2008",
        "a_mumelbphpxua": 463,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
          "Držitelé soukromoprávní DS"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
