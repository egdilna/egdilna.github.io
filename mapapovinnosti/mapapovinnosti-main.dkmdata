      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbtywnxe",
      "name": "Správně zaevidovat datum doručení dokumentu odeslaného datovou schránkou",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Dokument, který byl dodán do datové schránky, je doručen okamžikem, kdy se do datové schránky přihlásí osoba, která má s ohledem na rozsah svého oprávnění přístup k dodanému dokumentu.",
        "a_mumelbpfast4": "§ 17 odst. 3 a 5 zákona 300/2008",
