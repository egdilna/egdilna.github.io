    },
    {
      "id": "e_mumelbt2v6ap",
      "name": "Sledovat a hlídat správní lhůty u spisů a dokumentů",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Původce, který je jako OVM vázán Správním řádem či jinými správně-procesními předpisy, musí zajistit dodržování lhůt pro svoje úřední a správní činnosti. Vzhledem k tomu, že [Elektronický systém spisové služby] a každý úřední [Informační systém pro správu dokumentů] slouží jako evidence pro správní činnosti, musí být takový systém připraven na záznam a sledování a hlídání lhůt pro vyřízení věci ve správní lhůtě. To se týká i vyřizování a reakce na dokumenty a spisy.",
        "a_mumelbpfast4": "zákon 500/2004 a ostatní procesní předpisy",
        "a_mumelbphpxua": 424,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 2,
        "a_mumelbpgzy0h": [
          "Orgány veřejné moci",
          "Veřejnoprávní původci"
        ]
      },
