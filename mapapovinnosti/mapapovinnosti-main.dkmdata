    },
    {
      "id": "e_mumelbsdmk59",
      "name": "Vést údaje o využívání údajů z Národního bodu",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "V národním bodu se jako provozní údaj vede alespoň datum prvotního zápisu údaje do národního bodu, datum poslední změny údaje vedeného v národním bodu a záznam o využití údaje z národního bodu. Tyto údaje se uchovávají po dobu 15 let od skončení platnosti prostředku pro elektronickou identifikaci.",
        "a_mumelbpfast4": "§ 21 odst. 2 písm. a) až c) a odst. 5 zákona 250/2017",
        "a_mumelbphpxua": 367,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
