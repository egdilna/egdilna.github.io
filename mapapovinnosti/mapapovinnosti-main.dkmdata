      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Zákon 499/2004 udává původcům vést v komponentě Jmenný rejstřík údaje o subjektech a vazbu dokumentů, které se subjektů týkají. Primárním účelem je zdroj údajů o tom, v jakých dokumentech se vyskytují osobní údaje subjektu, což je potřebné pro GDPR.",
        "a_mumelbpfast4": "§ 63 odst. 4 až 8 zákona 499/2004",
        "a_mumelbphpxua": 406,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
