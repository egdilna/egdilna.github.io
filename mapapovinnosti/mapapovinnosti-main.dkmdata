    },
    {
      "id": "e_mumelbwv8af5",
      "name": "Poskytovat záznamy o využívání údajů",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Správce příslušného základního registru umožní osobě uvedené v odstavci 3 obstarat si bezplatně záznam o využívání údajů vedených v základním registru způsobem stanoveným zákonem o informačních systémech veřejné správy pro obstarání si výstupu z informačního systému veřejné správy s využitím prostředku pro elektronickou identifikaci. Správce příslušného základního registru zašle do datové schránky osoby uvedené v odstavci 3 na žádost této osoby bezplatně záznam o využívání údajů vedených v základním registru. Záznam o využívání údajů v základním registru se vydává rovněž v podobě ověřeného výstupu z informačního systému veřejné správy.",
        "a_mumelbpfast4": "§ 14 odst. 4 zákona č. 111/2009 SB o základních registrech",
        "a_mumelbphpxua": 743,
        "a_mumelbpjp2r8": "2023-04-07",
        "a_mumelbpleuge": "Verified",
        "a_mumelbpm6cgm": "EG",
        "a_mumelbpijs2i": 3,
        "a_mumelbpgzy0h": [
          "Správci základních registrů"
        ]
      },
      "customAttributes": [],
      "relations": [],
      "comments": [],
      "objects": [],
      "createdAt": "2026-09-29T08:17:25.000Z",
      "updatedAt": "2026-09-29T08:17:25.000Z"
    },
    {
      "id": "e_mumelbwwc5ag",
      "name": "Zaslat výpis o změně údaje do datové schránky",
      "typeId": "t_mumelbprw766",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "attributes": {
        "a_mumelbpegwrf": "Dojde-li ke změně údaje vedeného v základním registru, s výjimkou provozního nebo autentizačního údaje, zašle bez zbytečného odkladu správce základního registru osobě uvedené v odstavci 3, které se tato změna týká, má-li zřízenu a zpřístupněnu datovou schránku, bezplatně výpis údajů, s výjimkou provozních a autentizačních údajů, z příslušného základního registru do datové schránky.",
        "a_mumelbpfast4": "§ 14 odst. 5 zákona č. 111/2009 SB o základních registrech",
