<?xml version="1.0" encoding="UTF-8"?>
<!--
  Neoficiální XSD pro datové XML zjednodušených formulářů EasyForms (DIA)
  Soubor: data-dokumentu-formuláře-pro-elektronické-podání.xml, kořen <detail_podání>

  Zdroj: DIA, „Formuláře EasyForms – dokumentace ke strojovému vytěžování dat“ (kap. 3, přílohy 1–8)
  a vzorové podání z archi.gov.cz. Schéma odvodil Michal Rada / EGdílna (s pomocí Claude), 2026-11-11.
  DIA k datovému XML vlastní XSD nezveřejňuje.

  Verze XSD 1.0 (validuje např. xmllint, lxml, Xerces).

  Princip:
  - Datové XML nemá jmenný prostor, schéma proto nemá targetNamespace.
  - Obsah <detail_podání> je otevřený (xs:any lax), protože pole „Předmět podání“
    se jmenují podle popisků v katalogu RPP a liší se formulář od formuláře.
  - Pevné bloky (hlavička, příjemce, žadatel, zástupce, přílohy) jsou deklarovány
    globálně, takže je validátor díky „lax“ zkontroluje přísně, kdykoli se v podání objeví.
  - Omezení XSD 1.0: nelze vynutit pořadí bloků ani povinnost bloku žadatel
    (otevřený obsah a pevné prvky nelze v 1.0 kombinovat bez porušení pravidla UPA).
  - Všechny položky uvnitř bloků jsou nepovinné: prázdné hodnoty EasyForms do XML nezapisuje.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified"
           version="0.1">

  <!-- ===================== Kořen ===================== -->

  <xs:element name="detail_podání">
    <xs:annotation>
      <xs:documentation xml:lang="cs">Datová věta podání z EasyForms. Typické pořadí: hlavička, příjemce, žadatel, zástupce_žadatele, pole formuláře, přílohy.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##local" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ===================== Hlavička ===================== -->

  <xs:element name="identifikátor" type="NeprázdnýText">
    <xs:annotation><xs:documentation xml:lang="cs">ID formuláře, např. RppForms-2 (starší výstup: EasyForms-01-14).</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="typ" type="NeprázdnýText">
    <xs:annotation><xs:documentation xml:lang="cs">Interní typový kód formuláře, např. F603 (nepovinný).</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="popis" type="xs:string">
    <xs:annotation><xs:documentation xml:lang="cs">Popisný text formuláře (nepovinný).</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="agenda_kód" type="KódAgendy"/>
  <xs:element name="agenda_název" type="NeprázdnýText"/>
  <xs:element name="služba_kód" type="KódSlužby"/>
  <xs:element name="služba_název" type="NeprázdnýText"/>
  <xs:element name="úkon_kód" type="KódÚkonu"/>
  <xs:element name="verze" type="NeprázdnýText">
    <xs:annotation><xs:documentation xml:lang="cs">Verze formuláře z katalogu RPP.</xs:documentation></xs:annotation>
  </xs:element>
  <xs:element name="platnost_od" type="xs:date">
    <xs:annotation><xs:documentation xml:lang="cs">Datum platnosti verze formuláře (nepovinné).</xs:documentation></xs:annotation>
  </xs:element>

  <!-- ===================== Účastníci ===================== -->

  <xs:element name="příjemce" type="Příjemce"/>
  <xs:element name="žadatel" type="Žadatel"/>
  <xs:element name="zástupce_žadatele" type="ZástupceŽadatele"/>

  <!-- ===================== Přílohy ===================== -->

  <xs:element name="přílohy" type="Přílohy"/>

  <!-- ===================== Typy: účastníci ===================== -->

  <xs:complexType name="Příjemce">
    <xs:annotation><xs:documentation xml:lang="cs">Úřad (OVM), kterému se podání doručuje.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="obchodní_firma" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="ičo" type="IČO" minOccurs="0"/>
      <xs:element name="datová_schránka" type="IdDatovéSchránky" minOccurs="0"/>
      <xs:element name="sídlo" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="adresní_místo" type="AdresníMísto"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AdresníMísto">
    <xs:sequence>
      <xs:element name="kód_adresního_místa" type="KódAdresníhoMísta" minOccurs="0"/>
      <xs:element name="obec" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="okres" type="NeprázdnýText" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Žadatel">
    <xs:annotation><xs:documentation xml:lang="cs">Právě jedna varianta podle typu osoby přihlášené na Portálu občana.</xs:documentation></xs:annotation>
    <xs:choice>
      <xs:element name="fyzická_osoba" type="FyzickáOsoba"/>
      <xs:element name="fyzická_podnikající_osoba" type="OsobaSIČO"/>
      <xs:element name="právnická_osoba" type="OsobaSIČO"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="ZástupceŽadatele">
    <xs:annotation><xs:documentation xml:lang="cs">Jen při podání zástupcem. Varianta „fyzická podnikající osoba“ u zástupce není.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="kód_zastoupení" type="UUID">
        <xs:annotation><xs:documentation xml:lang="cs">Identifikátor zastoupení z Registru zastupování (odpovídá okz v metadatovém XML).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:choice>
        <xs:element name="fyzická_osoba" type="FyzickáOsoba"/>
        <xs:element name="právnická_osoba" type="OsobaSIČO"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FyzickáOsoba">
    <xs:sequence>
      <xs:element name="jméno" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="příjmení" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="datum_narození" type="xs:date" minOccurs="0"/>
      <xs:element name="kontakt" type="Kontakt" minOccurs="0"/>
      <xs:element name="adresa" type="Adresa" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OsobaSIČO">
    <xs:annotation><xs:documentation xml:lang="cs">Podnikající fyzická osoba nebo právnická osoba.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="ičo" type="IČO" minOccurs="0"/>
      <xs:element name="název" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="kontakt" type="Kontakt" minOccurs="0"/>
      <xs:element name="adresa" type="Adresa" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Kontakt">
    <xs:sequence>
      <xs:element name="email" type="Email" minOccurs="0"/>
      <xs:element name="telefon" type="Telefon" minOccurs="0"/>
      <xs:element name="id_datové_schránky" type="IdDatovéSchránky" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Adresa">
    <xs:annotation><xs:documentation xml:lang="cs">Vyplněno bývá číslo popisné (+ orientační), nebo číslo evidenční.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="obec" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="část_obce" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="ulice" type="NeprázdnýText" minOccurs="0"/>
      <xs:element name="číslo_popisné" type="ČísloDomovní" minOccurs="0"/>
      <xs:element name="číslo_evidenční" type="ČísloDomovní" minOccurs="0"/>
      <xs:element name="číslo_orientační" type="ČísloOrientační" minOccurs="0"/>
      <xs:element name="psč" type="PSČ" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== Typy: přílohy ===================== -->

  <xs:complexType name="Přílohy">
    <xs:sequence>
      <xs:element name="příloha" type="Příloha" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Příloha">
    <xs:sequence>
      <xs:element name="název" type="TextSJazykem">
        <xs:annotation><xs:documentation xml:lang="cs">Titulek přílohy z RPP; u vícenásobné přílohy text „Další přiložený soubor“.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="název_souboru" type="NeprázdnýText"/>
      <xs:element name="typ_média" type="NeprázdnýText">
        <xs:annotation><xs:documentation xml:lang="cs">MIME typ (application/pdf) nebo IRI IANA (http://www.iana.org/assignments/media-types/...).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="obsah" type="xs:base64Binary" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="cs">Obsah souboru v base64 (objevuje se ve starším výstupu).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== Jednoduché typy ===================== -->

  <xs:simpleType name="NeprázdnýText">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TextSJazykem">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:anyAttribute namespace="http://www.w3.org/XML/1998/namespace" processContents="skip"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="KódAgendy">
    <xs:restriction base="xs:string"><xs:pattern value="A[0-9]{1,6}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="KódSlužby">
    <xs:restriction base="xs:string"><xs:pattern value="S[0-9]{1,6}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="KódÚkonu">
    <xs:restriction base="xs:string"><xs:pattern value="U[0-9]{1,8}"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IČO">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{8}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="IdDatovéSchránky">
    <xs:restriction base="xs:string"><xs:pattern value="[a-z0-9]{7}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="KódAdresníhoMísta">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{1,9}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UUID">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Email">
    <xs:restriction base="xs:string"><xs:pattern value="[^@\s]+@[^@\s]+"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Telefon">
    <xs:restriction base="xs:string"><xs:pattern value="\+?[0-9 ]{3,20}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PSČ">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{3} ?[0-9]{2}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ČísloDomovní">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{1,4}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ČísloOrientační">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{1,3}[a-zA-Z]?"/></xs:restriction>
  </xs:simpleType>

</xs:schema>
