    <element xsi:type="archimate:BusinessProcess" name="Řízení motivací, inovací a udržitelného rozvoje" id="id-c2eb28e741ad48f9bbf8efd53d3cb148">
      <documentation>Aktivity řízení motivací, inovací a udržitelného rozvoje spočívají v Přípravě a realizaci motivačního programu, Řízení a akceleraci inovací podpůrných a korporátních procesů úřadu a Definici rámce a rozvojových oblastí potřebných pro zajištění udržitelného rozvoje.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Příprava strategií a politik" id="id-a6ebb236b8e84e0c9afa27133cbba843">
      <documentation>Aktivity přípravy strategií a politik spočívají v Komplexním posouzení stavu potřeb a příležitostí organizace, Sestavení vlastní strategie úřadu, Vytvoření akčního plánu strategie organizace, Provázané implementaci strategických rámců, Stanovení a schválení rozpočtu a Kontrole jeho plnění.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Zpětná vazba organizace" id="id-c0aa3014c8ba459697fe1e227acd042b">
      <documentation>Aktivity Zpětné vazby organizace spočívají v Průběžné analýze stavu organizace, Hodnocení vyspělosti vlastní organizace/architektury, Hodnocení zralosti poskytovanách služeb a Reportingu stavu organizace pro vyšší úroveň řízení VS.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Strategické plánování a rozhodování" id="id-90e23683f17443a99cc0de17382c833a">
      <documentation>Aktivity strategického plánování a rozhodování zahrnují definici Procesů a organizaci podpory stategického rozhodování, Plán strategických nákupů (investic) a Plán pesonálního rovoje.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Plánování a řízení rozvoje a změn schopností organizace" id="id-a3aba96dd100479b93d576a77bf69af7">
      <documentation>Aktivity plánování a řízení rozvoje a změn schopností organizace spočívají v Řízení portfolií, programů a projektů, Řízení enterprise architektury úřadu, Řízení organizačních změn (OCM), Evidence a řízení požadavků (podnětů) na změny, Řízení změnových iniciativ, Řízení průběžného zlepšování, Řízení rozvoje a změnových procesů (BPM), Řízení byznys pravidel (BRM) a Řízení rozvoje podřízených organizací.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení výkonnosti, kvality a zodpovědnosti (GRC)" id="id-81b2df1f59ba42d1a2df48a502e15842">
      <documentation>Aktivity Řízení výkonnosti, kvality a zodpovědnosti (Government - Risk - Compliance) spočívají ve Vytvoření a správě rámce řízení výkonnosti a kvality dodávky služeb, Řízení výkonnosti veřejných služeb, Řízení výkonnosti a zodpovědnosti zaměstnanců, Řízení (celkové) kvality veřejných služeb, Správa anonymních stížností, Měření a monitoring, Informace a komunikace, Získání certifikátů a ocenění, Řízení výkonnosti, kvality a zodpovědnosti PO a OO.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení bezpečnosti a rizik (GRC)" id="id-2159d224316343ad9ca1a84dac6ec1c5">
      <documentation>Aktivity Řízení bezpečnosti a rizik (Government - Risk - Compliance) spočívají v Identifikaci rizik a návrhu způsobu jejich ošetření, Komplexním řízením bezpečnosti v organizaci a Ochraně osobních údajů (GDPR).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení komunikace" id="id-00dba02ab445423aa41a54c38b3a4fd6">
      <documentation>Aktivity Řízení komunikace spočívají v Nastavení a řízení procesu interní komunikace a řízení externí komunikace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení standardizace, shody s předpisy a dlouhodobé udržitelnosti (GRC)" id="id-e3e026c249c845e0915bf09b9278d45f">
      <documentation>Aktivity Řízení standardizace, shody s předpisy a dlouhodobé udržitelnosti (Government - Risk - Compliance) spočívají v Nastavení kontrolního prostředí VŘKS, Řízení standardů, Řízení shody s předpisy, Řízení aktivit vedoucích k dlouhodobé udržitelnosti, Řízení ochrany zdraví a životního prostředí (EHS), Rozdělení pravomocí (kontrola 4 očí, SoD), Interní audit a finanční kontrola, Veřejnosprávní kontrola shody, a Kontroly úřadu externími organizacemi.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Strategická partnerství" id="id-6caa657ee3f1466cbb2a2a892d1f7347">
      <documentation>Aktivity Strategického partnerství spočívají ve Spolupráci a rozhodování pro zajištění bezpečnosti území, Strategických partnerstvích s velkými korporacemi, Strategických partnerstvích veřejné správy s nestátními neziskovými organizacemi a Strategických partnerstvích na podporu vzdělávání, odborné přípravy, mládeže a sportu (Erasmus+).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Celkové řízení znalostí úřadu (KM, Knowledge Management)" id="id-f259565adb53469f8d47af52a8d9faed">
      <documentation>Mezi aktivity Celkového řízení znalostí úřadu (KM, Knowledge Management) patří Stanovení strategie řízení znalostí, Posuzování zralosti procesu řízení znalostí a Přenost dobrých praxí z/do úřadu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Jednání vedoucích orgánů organizace" id="id-f87ea99e97c14ad9b48d030f0d3d543b">
      <documentation>Aktivity Jednání vedoucích orgánů organizace spočívají v Přípravě a konání zasedání Rady OVS</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Provoz centra sdílených služeb v korporátním prostředí" id="id-9de3d1fb73984c66804e1fae53ad9fe2">
      <documentation>Lokální podpora formou sdílených služeb pro korporátní/resortní organizace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Koordinace partnerů při dodávce veřejných služeb" id="id-db02b66edb58409699a77215df5bf38f">
      <documentation>Lokální koordinace mezi partnery na úrovni korporace/resortu při dodávce veřejných služeb.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení rozpočtu a dluhu v rámci korporace" id="id-f45303a150ed4e04a55fff26277c99e5">
      <documentation>Participativní řízení rozpočtu a dluhu v rámci korporátních/resortních organizací.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Zajištění příjmů korporace" id="id-c0a7781cddc549cf8946c1f04699cc21">
      <documentation>Lokální zajišťování příjmů subjektů v rámci korporace/resortu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa poskytovaných grantů a dotací" id="id-52fe8c15793a44b7b499dbda27f627c4">
      <documentation>Správa poskytovaných grantů a dotací pro subjekty korporace/resortu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Reporting řízených organizací" id="id-c46b7a47ce0240a4ae3a0306acdb823e">
      <documentation>Reporting podřízených organizací na úroveň řízení korporace/resortu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Struktura a nástroje veřejné správy" id="id-2ec4df9f8ddf4cb0897f4c0f5cc8fe40">
      <documentation>Procesy budování struktury a nástrojů veřejné správy v rámci korporace/resortu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Podpora voleb a volených orgánů" id="id-d469b6432a3a47e3a2c0e5f103ae505d">
      <documentation>Korporátní/resortní procesy pro podporu voleb a volených orgánů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa vlastního a dohled svěřeného majetku" id="id-e379741e859946229c58349667ff9ea0">
      <documentation>Procesy správy a dohledu nad svěřeným  majetkem korporátních/resortních organizací.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Rozvoj politik a služeb" id="id-17fabd87a54d448ea9e53a0a20887b45">
      <documentation>Procesy rozvoje politik a služeb zahrnují Rozvoj (životního) prostředí (prostoru), ekonomický rozvoj podnikatelského prostředí, socilální a kulturní rozvoj, rozvoj pořádku, bezpečnosti, rozvoj způsobů poskytování služeb v rámci působnosti a rozvoj vnitřních procesů a rámci organizace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Vývoj produktů a služeb" id="id-436fe34310d042e3af945d37e500985a">
      <documentation>Procesy vývoje produktů a služeb zahrnují správu produktových programů, výzkum trhu a sběr nápadů, vývoj a zavedení služeb, správu katalgu produktů a služeb, řízení životního cyklu produktu a bezpečnost výrobků a služeb organizace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Propagace, marketing produktů a služeb" id="id-51935960f777487e88ada948b1f19029">
      <documentation>Procesy propagace, marketingu produktů a služeb zahrnují průzkumy veřejnosti a plánování marketingových kampaní, definici marketingové strategie, plánování a řízení propagace, provedení kampaní a průzkumů trhu, tvorbu a distribuci propagačních materiálů, řízení událostí a sponzoroství, partnerství a patronátů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Prodej a odběr produktů a služeb" id="id-88356318e8eb443cb8a0283166ecb0ed">
      <documentation>Proces prodeje a odběru produktů a služeb zahrnuje definici strategie a vlastní řízení prodeje a odběru.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Komunikace a plošné informace o službách VS" id="id-e243eb84f8454a81b48e7df2f548c74f">
      <documentation>Proces komunikace a plošné informace o službách VS zahrnuje řízení komunikace s medii a informování o nabídce služeb vlastními prostředky.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení dodávky produktů a služeb" id="id-49a6864da47440eeb19c1f0c6b587b7b">
      <documentation>Proces řízení dodávky produktů a služeb zahrnuje plánování a koordinaci zdrojů, řízení lidských zdrojů a proces požízení materiálů a služeb pro dodávku.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Publikace dat veřejnosti" id="id-63327297bcd14f83b55a43807eead0af">
      <documentation>Proces publikování dat veřejnosti na základě zákona o svobodnm přístupu k informacím (opendata v národním Katalogu OD) a veřejných dat úřadu - nejčastěni na jeho vlastních webových stránkách.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Hromadné hlavní procesy" id="id-677161dd497a4993996cdc9cf2184f02">
      <documentation>Hromadné hlavní procesy zahrnují výkon agend státní správy, přenesené působnosti, uzemní samosprávy a výkon veřejných služeb.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Obsluha a komunikace s klienty (Front Office)" id="id-642aeb024a574292bf0509aef3362cc4">
      <documentation>Proces obsluhy a komunikace s klienty (Front-Office) zahrnuje následující skupiny procesů: Podpora klientských samoobsluh, Provoz asistovaných přepážek, Příjem podání, Poskytování informací, Vyřizování komunikace (telefon, mail), Správa kontaktů, Podpora a řízení dodávky služeb zákazníkům, Podpora listinných kanálů, Spolupráce a participace a skupinu púrocesů Poskytování služeb a dodávek zboží.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Odborné agendy poskytující individuální, adresné služby pro klienty (Middle Office)" id="id-d18893c59a1447168a9a96e623acf22d">
      <documentation>Proces odborné agendy (Middle-Office) - tj. individuální, adresné služby pro klienty, zahrnuje následující skupiny procesů: Služby územní samosprávy, Služby státní správy v přenesené působnosti, Služby a produkty podnikání obce (soukromoprávní), Dodávky projektově orientovaných řešení pro klienty, Služby pro opravné prostředky řízení VS (stížnosti, reklamace), a procesy zajišťující Individuální (věcné) veřejné služby.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Zázemí odborných agend (Back Office)" id="id-413a142fa767416dac2a4e746d0d11e3">
      <documentation>Proces zázemí odborných agend (Back-Office) obsahuje následující skupiny procesů: Správa účtů (pohledávek a závazků) klientů, Upomínání a vymáhání pohledávek za klienty a skupinu procesů zajišťujících Správu datového kmene klientů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Péče o klienty" id="id-5ab983f9b8d14421baf6c68f2e6a8ba2">
      <documentation>Proces péče o klienty zahrnuje stanovení strategie služeb pro podporu klientů, plánování a řízení kontaktních center služeb, poporodejní servis, řízení dodávek a měření a vyhodnocování spokojenosti klientů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Doplňkové činnosti organizace nad rámec výkonu agend" id="id-cf0ec268e1e84dc1895fb070ae10600a">
      <documentation>Proces doplňkové činnosti veřejné organizace zahrnuje následující skupiny procesů: Hostinské činnosti, Krátkodobé pronájmy nemovitého majetku do 30 dnů, Silniční motorová doprava nákladní a skupinu procesů Zprostředkování obchodu a služeb.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení případů, spisů a dokumentů" id="id-193aa330178546c1a63cc635af291e9a">
      <documentation>Proces řízení případů, spisů a dokumentů zahrnuje skupiny podprocesů: Podatelna a výpravna, Spisová služba a Správa případů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Společné aktivity v oblasti přenesené působnosti" id="id-d0fdd2c521a94cc7859df252c58aa8a0">
      <documentation>Jedná se o očekávané společné a legislativně určené procesy a aktivity na krajské, městské i obecní úrovni (nezbytné součinnosti Krajů, Statutárních měst a Obcí s rozšířenou působností).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Společné aktivity v oblasti samostatné působnosti" id="id-7d13235d1b084ba281e35ff66fb91e3a">
      <documentation>Jedná se o očekávané společné a legislativně určené procesy a aktivity na městské a obecní úrovni (nezbytné součinnosti Statutárních měst nebo Obcí s rozšířenou působností).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Interakce ve specifických resortních odvětvích" id="id-c60523f7c4594ebfbb22445fed5ed454">
      <documentation>Jedná se o specifické odvětvové aktivity v oblasti financí, dopravy, kultury, rozvoje, obrany, sociální, spravedlnosti, průmyslu a obchodu, školství, mládeže a tělovýchovy, vnitřních i zahraničních věcí, zdravotnictví a životního prostředí a jejich vzájemné interakce na státní, přenesené i samostané úrovni působnosti.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Zajištění výměny údajů mezi organizacemi VS a komerčními subjekty a poskytování dat a informací veřejnosti" id="id-244b6c5f9bcf4975bd62354316dcd801">
      <documentation>Procesy zahrující podporu a zajištění služeb výměny autoritativních údajů, oběhu nestrukturovaných dat, využívání centrálních služeb, výměnu udajů s komercí a služby poskytování dat a informací zveřejňované na základě  zákona o svobodném přístupu k informacím.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Společné aktivity v oblasti samosprávy" id="id-50a3c41153a74b77b7c962b08610c4fd">
      <documentation>Jedná se o očekávané společné a vyhláškami upravené aktivity na obecní úrovni (nezbytné součinnosti obcí v území).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Nákup, veřejné zakázky a správa dodavatelů" id="id-b8ec4a731c20460f88af14cfc8033674">
      <documentation>Proces nákupu, veřejných zakázek a správy dodavatelů zahrnuje sběr a schgvalování požadavků na nákup, plánovánání nákupů a obkjednávky, správu dodavatelů smluv a nákupních katalogů, zálohy externím subjektům a evidenci plnění a likvidaci faktur.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Prodej, fakturace a správa odběratelů" id="id-875bc822ac134c85bdb92c58d3953ff3">
      <documentation>Proces prodej, fakturace a správa odběratelů zahrnuje plánování prodeje, tvorbu nabídek, příjem objednáveksprávu odběratelů, prodejních smluv a katalogů, evidenci dodávek a plnění poskytovaných služeb a fakturaci za prodej materiálu, zboží a služeb.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Logistika a evidence zásob (MTZ)" id="id-92fd80a9fe7942f99ca2309be71a5005">
      <documentation>Proces logitika a evicence zásob zahrnuje Plánování a sledování stavu materiálního zabezpečení, správu kmenových dat materiáll a zboží, Skladování a řízení skladů, Fyzické inventury materiálů a zboží.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení pořízení, údržby a správy inv. majetku" id="id-7dec5cbf561f4fa4bb321ae7a98bd0f1">
      <documentation>Procesy řízení pořízení, údržby a správy inv. majetku obsahuje Plánování získání aa rozvoje majetku, návrh a vystavba nemovitostí a zařízení, Provoz, údržba a správa nemovitostí a zařízení, Požírní ochrana a zabezpeční objektů a vyřazování a likvidace majetku.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa informačních technologií" id="id-82bf25d982844fad8dbf9d559226f03d">
      <documentation>Procesy správy informačních technologií zahrnuje IT Governance a Architketura řešení, Strategické plánování a řízení IT, Správa vztahů s klienty IT, Pořízení a zavádění řešení a služeb, Provoz řešení a dodávka IT služeb, Řízení IT schopnstí a zdrojů a Monitoring, hodnocení a zlepšování IT služeb.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa lidských zdrojů" id="id-428cdc05e87641b69d337fff5a673e6c">
      <documentation>Procesy Spravy lidských zdrojů zahrnují Správu personálních plánů, politik a strateií, Řízení vztahů a konfliktů na pracovišti, Řízení pracovních cest,, Návor a výběr pracovníků, Řízení personálních transakcí, Ochrana zdraví a bezpečnost práce, Řízení vývoj zaměstnanců v průběhu zaměstnání, Poskytování personálních služeb, Řízení komunikace se zaměstnanci, Řízení odměňování a udržení zaměstnanců, Nasazení zaměstnanců - řízení kapacit, Personální výkaznictví a analýzy, Přeložení a odhos zaměstnanců, Řízení systemizovaných pozic ve VS a Řízení vztahů s odbory.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa znalostí a informací" id="id-c509bfebfc0b49e4a4a399d00bd02813">
      <documentation>Procesy Správy znalostí a informací zahrnují Řízení informací úřadu, Kvalitu a čistotu dat, Sběr a ukládání informací a znalostí, Ochranu dat a soukromí, Přístup k informacím, Archivaci a skartaci, Správu znalostí a správu knihoven a zdrojů informací.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení financování (Treasury)" id="id-ee010ca323f74d47b6222209eba93f5e">
      <documentation>Procesy Správy znalostí a informací zahrnují Nastavení politiky řízení financování, Řízení pojistění, Řízení finančních toků, a rizik, Řízení úvěrů a spoření, Správu případů finančních podvodů a sporů, Řízení přijatých dotací a fondů, Řízení financování investic, Řízení záruk a Řízení interní korporátní banky.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Finanční a ekonomické řízení, vč. Účetnictví" id="id-2220b88c0f1547738d9ca376a689bbca">
      <documentation>Praocesy Finanační a ekonomické řízení a Účetnictví zahrnují Řízení ekonomických procesů a pravidel, Evidenci a Inventarizaci materiálových záslob, zboží a majetků, Rozpočetnictví, Rozhodnutí o poskytování fiančních prostředků, Finanční účetnictví, Manažerské účetnictví (controlling), Správu výnosů a pohledávek, Řízení nákladů, Zpracování zázvazků za dodavatlele a náhrady zaměstnancům, Řízení placení daní, Zúčtování a výplata mezd, Platební styk a banku, Výkaznictví a Správu organizace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Manažerské, právní, administrativní a sekretářské aktivity" id="id-5ebf2143aa2a46bc8a9199091a23eddd">
      <documentation>Aktivity Manažerské, právní, administrativní a sekretářské zahrnují Právní podporu a etické otázky, Administrativní podporu, Výkon řídící kontroly a Základní manažerské řízení.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Komunikace s externími subjekty (Public Relations)" id="id-50d7608e691a416b8c5e528be11cbf4f">
      <documentation>Procesy Komunikace s externími subjekty zahrnují Říení Public Relation programů, Řízení vztahů s veřejnou správou, průmyslem a veřejností, ˇ5ízení vztahů k investorům a Řízení vztaů s Radou a Zastupetestvem organizace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby poskytované zveřejněním na základě zákona svobodném přístupu k informacím (OD)" id="id-58c15161c3374b7798b53f30a67ebc1c">
      <documentation>Služby poskytované zveřejněním na základě zákona svobodném přístupu k informacím, buď na žádost klienta nebo jako povinně zveřejňované informace na portálu organizace a dále jako publikovaná Otevřená Data.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby poskytující veřejně dostupné informace (VDF)" id="id-a41e17c9ecd74eee8e695a5b41251ebf">
      <documentation>Soubor služeb zajišťující publikaci a využívaní informací sdílených mezi OVS v rámci nově budovaného Veřejného Datového Fondu (TOBE), využívající garantovaná opendata organizace, která mohou sloužit jako podklady pro následná rozhodování jiného subjektu veřejné správy nebo soukromo-právnímu uživateli údajů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Centrální využívané služby (CMS, ZR, PPDF)" id="id-da4943f294b54b71b53a3f8488c3e71e">
      <documentation>Slupina služeb, která zajištuje zavedení a čerpání centrálních služeb eGovernmentu. Typicky se jedná o zajišťování a podporu při využívání služeb Centrálního místa služeb, služeb Základních registrů nebo služeb Propojeného Datového fondu pro potřeby výkonu agend státní správy, výkonu agend přenesené působnosti nebo samosprávy.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Sdílené služby pro spolupráci s komercí" id="id-2bd13e0b038c42df9f5df2fde45ae5ab">
      <documentation>Skupina služeb organizace zajišťující a podporující spolupráci organizace veřejné správy s komerčními subjekty. Mezi vlastní služby  spolupráce mohou patřit jak služby konzumované úřadem, tak i služby poskytované úřadem i služby poskytované a konzumované komerčním subjetem.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Sdílené služby pro kooperaci s podřízenými organizacemi" id="id-f14f71fcfb6b4ef3b99e8a212ddd7a40">
      <documentation>Služby, které poskytují svým podřízeným organizacím subjekt veřejné správy. Typicky se jedná o služby realizované buď resortními nebo korporátnímí procesy. Cílem těchto  služeb je zajistit součinnost a sdílením snižovat náklady na procesy u podřízených organizací.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby výměny autoritativních údajů (záznamy)" id="id-8cda732edbf9452b9a375041f95473ec">
      <documentation>Skupina služeb zajišťujících výměnu a sdílení autoritativních údajů klientů organizace, prostřednictvím rozhraní ISSS, se subjekty veřejné správy na základě pravidel a oprávnění agend stanovených v Registru Práv a Povinností.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby oběhu nestrukturovaných dat (dokumenty)" id="id-3a5b3c5d02604832aa861f05e6d03a00">
      <documentation>Skupina služeb zajišťujících oběh, příjem a výdej nestrukturovaných dat klientského i interního charakteru organizace, prostřednictvím partnerských a veřejných komunikačních rozhraní, s jinými subjekty veřejné správy zejména za účelem zpracování dokumentů, žádostí, podání, stanovisek a vydání rozhodnutí. Typickým obslužným kanálem je Datová schránka a zpracujícím systémem je spisová služba. Pokud je v organizaci zaveden elektronický oběh dokumentů takovým způsobem, že je možné všechny aktivity od podání až po rozhodnutí činit elektronicky, hovoříme o úplném elektronickém podání.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby vykonávaných agend" id="id-5c183e86de1e406ea4a7c4666d573dd6">
      <documentation>Skupina služeb zahrnující služby vykonávané v rámci agend státní správy, služby agend přenesené působnosti, služby uzemní samosprávy a veřejné služby.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby obsluhy a komunikace s klienty" id="id-db5d1fae5877439a83a67d6097735e7f">
      <documentation>Služby Obsluhy a komunikace s klienty zahrnují služby klientských samoobsluh, služby asistovaných přepážek, služby příjmu podání a poskytování informací, služby vyřizování komunikace (telefon, mail), služby správy kontaktů, služby podpory a řízení dodávky služeb zákazníkům, služby podpory listinných kanálů, služby pro zajištění spolupráce a participace a skupinu  služeb pro zajištění dodávek zboží.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby poskytované na žádost" id="id-c6400f51c741429c9347529e9513bdf8">
      <documentation>Služby poskytované na žádost zahrnují specifické požadavky vyžádané z podnětu klienta.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby podpory pro klienty" id="id-5a87eb13733d43b29fb5837dd3837277">
      <documentation>Služby podpory pro klienta představují soubor služeb, které jsou vykonávány s cílem definovat strategii služeb pro  podporu klientů, plánování a řízení kontaktních center služeb, poprodejní servis k produktům, řízení dodávek  služeb podpory klientům a interní proces měření a vyhodnocování spokojenosti se službami péče o klienty.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Pošta (papírová)" id="id-5520b27fc60f4242a3fb1161bd5da172">
      <documentation>Rozhraní klasické pošty</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Podatelna a Elektronická úřední deska" id="id-4c2a62c7dce542318bb82adc5e324390">
      <documentation>Rozhraní pro vstup podání subjektu a publikování informací veřejnosti.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Telefon" id="id-869c26f9180d495fa5f1bbb186ee1abc">
      <documentation>Rozhraní pro hlasovou komunikaci.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="API Integrační platformy" id="id-520f027b161a4956895adaf49c17cda1">
      <documentation>Aplikační programové rozhraní integrační platformy (ESB), které slouží pro propojení aplikací v rámci úřadu, pokročilou kompozici a orchestraci služeb, organizaci katalogu služeb a integraci na další IS stejné/nižší korporátní úrovně nebo centrální ISVS pro zajiění čerpání centrálních služeb,  interoprabilitu a vybudování tzv. jednoho kontaktního aplikačního bodu úřadu (end point).</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Open API" id="id-3f0f85f84167412d93a67281006e348b">
      <documentation>Aplikační programové rozhraní pro publikaci a dotazování Otevřených dat a Veřejného datového forndu organizace.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="API Agendového IS" id="id-f42014b8add54fb7a88bada4abc6a554">
      <documentation>Aplikační programové rozhraní agendového informačního systému VS, kter slouží pro vnistřní integraci v rámci úřadu nebo pro komunikaci s okolím.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Portál úřadu (web)" id="id-344468fbe0734ec7b986ce65f45d8071">
      <documentation>Rozhraní pro návštěvníky úřadu realizované prostřednictvím internetu a webu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Rozhraní CMS" id="id-7be4b14bcbe842a1a06952c54d82ba9d">
      <documentation>Rozhraní Centrálního místa služeb.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Rozhraní pro výměnu souborů P2P" id="id-e87438e2d8da4301b94f1febe640fac1">
      <documentation>down/upload, FTP</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Rozhraní ISZR" id="id-ec0653bc9e4040b2bfe42737b16e3ce5">
      <documentation>Informační systém základních registrů je spravován Správou základních registrů. Systémem jsou realizovány vazby mezi jednotlivými základními registry a dále mezi registry a agendovými informačními systémy.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Rozhraní ISSS" id="id-af34f6c2125048ac8e92f7f04032d563">
      <documentation>ISSS je unifikované rozhraní pro sdílení údajů mezi jednotlivými informačními systémy veřejné správy. Je součást referenčního rozhraní umožňující jednotlivým AIS čerpat a publikovat údaje vedené o jednotlivých subjektech práva.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="CzPoint" id="id-91c6d915d97c4fcf9a7c508a97dbb1f3">
      <documentation>Czech Point je asistenční interaktivní obslužný kanál pro klienta, kterému jsou služby poskytovány na Kontaktních místech veřejné správy.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Dálkový přístup" id="id-723bb759786f4848aafc3ddbd495e16f">
      <documentation>Dálkový přístup je interaktivní nebo reakční digitální obslužný kanál klienta CS. Typicky se jedná o komunikaci aplikace klienta (prohlížeč nebo mobilní aplikace) s ISVS/AIS vybraného OVM prostřednictvím otevřeného internetu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Datová schránka" id="id-a3e6c63e2fb3436892da831026fa9445">
      <documentation>Datová schránka je korepondenční digitální obslužný kanál klienta, pro příjem odpovědí /rozhodnutí OVM. Datovou schránkou disponují i OVM, ty slouží klientovi veřejné správy pro odesílání žádostí / podání.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="El. podpis" id="id-1fcd54e1eaba402cb8a593efc8313fc5">
      <documentation>Elektronický podpis (též digitální podpis) je označení specifických dat, které nahrazují klasický vlastnoruční podpis, respektive ověřený podpis. Je připojen k datové zprávě nebo je s ní logicky spojen, takže umožňuje ověření totožnosti podepsané osoby ve vztahu k datové zprávě. Elektronický podpis je prostředek k tomu, jak v anonymním světě internetu ověřit totožnost odesílatele.
Elektronický podpis je  je reakční digitální obslužný kanál klienta.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Osobně" id="id-0e83fd3918854adf8ef1954caaab28c9">
      <documentation>Osobní je interaktivní asistenční obslužný kanál klienta.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Portál" id="id-f1e1db6450314c4d885e29a127dfe814">
      <documentation>Kanál, který využívá </documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Pošta" id="id-57605e1ffdfb4536ae5ea13890fd99b7">
      <documentation>Organizace provozující poštovní služby</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Jiný způsob" id="id-4557baad5c0c432f9d0938de9580bd85">
      <documentation>Jiný způsob je obslužný kanál pro klienta, nad rámec existujících typů obslužných kanálů definovaných v Katalogu služeb RPP.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Obec s rozšířenou působností (ORP)" id="id-c532e662290f4281bc5270bf191e69cb">
      <documentation>Obce s rozšířenou působností (tzv. obce III. stupně) jsou mezičlánkem přenesené působnosti samosprávy mezi krajskými úřady a ostatními obecními úřady a mají oproti ostatním obecním úřadům některé oblasti působnosti navíc, a to nejen pro svůj vlastní, základní správní obvod, ale zpravidla i pro další obce v okolí.
V ČR existuje 205 obcí s rozšířenou působností</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Hlavní procesy výkonu aktivit pro klienty" id="id-d05d4a919ba644e883027f03888b114d">
      <documentation>Hlavní procesy výkonu aktivit pro klienty předtavují agendy, které současně využívají Podpůrné procesy úřadu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Aktivity pro spolupráci s organizacemi" id="id-214b4db3afa64289bfc874eccabbb7bd">
      <documentation>Aktivity pro spolupráci s organizacemi nabízí služby komerčním subjektům a současně využívají Korporátní procesy a spráavu sdílených zdrojů.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řídící a strategické procesy" id="id-f6a425d9984c4f50ba30fc1e99bb7297">
      <documentation>Řídící a strategické procesy koordinují operativní a taktické procesy organizace a určují směr a cíle úřadu. </documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Podpůrné procesy úřadu" id="id-bd4541db4a5e4b90854c1bf927d2f25a">
      <documentation>Podpůrné procesy úřadu obsluhují Hlavní procesy výkonu aktivit pro klienty  současně poskytují služby pro veřejnost.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Korporátní procesy a správa sdílených zdrojů" id="id-5d11bd02777541238bdabe822a88832f">
      <documentation>Korporátní procesy a správa sdílených zdrojů podporují aktivity pro spolupráci s organizacemi, využívají Podpůrné procesy úřadu a Provozní procesy a zajišťují Sdílené služby pro kooperaci s podřízemými organizacemi.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Provozní procesy" id="id-b1c8f3d701a64ec7adfe839af7ea449f">
      <documentation>Procozní procesy zajišťují provoz podpůrných procesů úřadu a korporátních procesů a správu sdílených zdrojů</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Vlastní služby klientům" id="id-8cfb70b4ab784e67ad9d97e2a4ce0d38">
      <documentation>Vlastní služby klientům vykonávají Hlavní procesy výkonu aktivit pro klienty.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Sdílené služby pro kooperaci s podřízenými organizacemi" id="id-885d2dd8e28e4031b727e2d2e7b4ecd6">
      <documentation>Služby, které poskytují svým podřízeným organizacím subjekt veřejné správy. Typicky se jedná o služby realizované buď resortními nebo korporátnímí procesy. Cílem těchto  služeb je zajistit součinnost a sdílením snižovat náklady na procesy u podřízených organizací.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Využívané centrální služby VS a služby nabízené komerčním subjektům" id="id-79e79da067994f5cb63f956b70da9d1d">
      <documentation>Využívané centrální služby Veřejné správy čerpají hlavní procesy výkonu aktivit pro klienty jako vstupy a služby nabízené komerčním subjektům realizují Aktivity pro spolupráci s organizacemi. </documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Služby pro veřejnost" id="id-302ae4583b2948b2a4e1b69c9bb2c85a">
      <documentation>Služby pro veřejnost poskytují podpůrné procesy úřadu</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-4b08f47159924defad23b54d118523d8" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Šifrovací služby" id="id-de189c4ae01a45bdad9b7ba902faaacf">
      <documentation>Software a / nebo služby, které zajišťují ochranu sítě a zabezpečení informací pomocí šifrování a dešifrování. Definuje metody ochrany informací a informačních systémů před neoprávněným přístupem, použitím, zveřejněním, narušením, změnami nebo zničením za účelem zajištění integrity, důvěrnosti a dostupnosti. Zvláštní oblastí zájmu jsou biometrie, dvoufaktorová identifikace, šifrování a technologie založené na standardech NIST FIPS-140.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Služby zabezpečení aplikací a sítě" id="id-1b6e054d53324f6ca897b1466958c5fb">
      <documentation>Software a / nebo služby na podporu bezpečnostních požadavků v aplikacích a sítích ICT a napříč nimi.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Infrastruktura veřejného klíče (PKI)" id="id-58fdc479ec4343b1a832c32d49e052c5">
      <documentation>Infrastruktura správy a distribuce veřejných klíčů. Umožňuje pomocí přenosu důvěry používat cizí veřejné klíče a ověřovat jimi elektronické podpisy bez nutnosti jejich individuální kontroly.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Bezpečnostní kontroly" id="id-39372f48891e4ac29384d774d83f233c">
      <documentation>Aplikace s funkcemi pro provedení bezpečnostních kontrol</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Digitální forenzní služby" id="id-c7c9341012974612892a6071ddc71658">
      <documentation>Aplikace vykonávající forenzní služby (forenzní analýzu)</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Podniková správa zabezpečení" id="id-3ab48f13f54248a2a963217c46ebc964">
      <documentation>Aplikace zajišťující správu zabezpečení v podniku</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa identit a odpovědností rolí" id="id-8da3ce1acf9041fc985345f3b8614bc7">
      <documentation>Software a / nebo služby, u kterých entity vytvářejí, monitorují a prosazují pravidla, pokyny a požadavky pro provádění funkčních prvků IDESG napříč komunitami nebo aktéry. Na rozdíl od vrstvy správy a provozu je vrstva správy a odpovědnosti konkrétně určena k řešení úsilí napříč entitami, nikoli k podnikové nebo interní správě.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Interakce identit a operace" id="id-20277bcba0704d0aa610744088d8e7d0">
      <documentation>Software a / nebo služby pro správu a podporu základních operací a funkcí, které mohou nastat při online interakcích souvisejících s identitou, seskupených do hlavních operací. Ne všechny prvky budou vyvolány v každé interakci identity a některé mohou být vyvolány vícekrát. Zatímco logicky je pravděpodobné, že některé funkce nastanou před nebo po ostatních, v modelu není zadáno žádné explicitní pořadí.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Ověřovací služby" id="id-931e56f93a6441b58ff32de091233a74">
      <documentation>Software nebo služby používané k potvrzení identity uživatele.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Služby autorizace a správy přístupu" id="id-af015e984850451c90fe65a31a7c74a4">
      <documentation>Software a / nebo služby zajišťující autorizovanou správu přístupu ke zdrojům.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Adresářové služby" id="id-298f1ccfff524ed086a13e678af711a1">
      <documentation>Software a / nebo služby zajišťující autorizovanou správu přístupu ke zdrojům.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Komponenty funkčního jádra identity" id="id-d77890e19e2d4c15bff56b18b1d67b5e">
      <documentation>Software a / nebo služby, které poskytují základní operace identity, ke kterým může dojít při online interakcích souvisejících s identitou seskupených do hlavních operací. Ne všechny prvky budou vyvolány v každé interakci identity a některé mohou být vyvolány vícekrát. Zatímco logicky je pravděpodobné, že některé funkce nastanou před nebo po ostatních, v modelu není zadáno žádné explicitní pořadí.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ICT komponenty pro výkon a podporu" id="id-4922655ac007430289641f3f3b7522a7">
      <documentation>Komponenty ICT, které lze použít k vytváření nových aplikací a služeb, které se používají ve výkonných a podpůrných procesech.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Nástroje pro správu procesů organizace" id="id-bd7f7b43821043a18ca5e6a59382d908">
      <documentation>Software a / nebo služby, které organizacím umožňují oddělit procesy od technologické architektury a podporovat manažerský přístup prostřednictvím technologií, tj. překlenout organizační a technologická sila.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Vývojové prostředí a nástroje" id="id-26207f3f59ea4e75b96264ba211ceb2e">
      <documentation>Software a / nebo služby, které tvoří vývojová prostředí a související nástroje.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Nástroje pro správu životního cyklu ICT" id="id-f2e0146bba50412d9352c92baf2fc8bc">
      <documentation>Nástroje pro správu ICT podporují každodenní provoz a správu ICT. Zahrnuje nástroje umožňující organizaci podpory ICT rychle vyřešit nebo eskalovat problémy a problémy, zlepšit izolaci hlavních příčin a poskytnout vyšší úroveň spokojenosti podnikových uživatelů. Pomocí tohoto obchodního pohledu organizace podpory IT spravují incidenty, problémy a požadavky na služby po celou dobu jejich životnosti efektivnějším a efektivnějším způsobem.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Cloud Služby" id="id-9fbf2868c7fd44a5947708ead69ec089">
      <documentation>Oblast Cloud Services obsahuje řadu služeb ICT, které jsou úřadu poskytovány externě. Jsou to velké skupiny vzdálených serverů v síti, které umožňují centralizované ukládání dat a online přístup k počítačovým službám nebo prostředkům. Služby cloud computingu mohou podporovat různé modely „X jako služba“, jako jsou SaaS, PaaS, IaaS.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa obchodních pravidel a podpora tvorby legislativy" id="id-cb4945f4d2d241d29076cde6c1582851">
      <documentation>Software a / nebo služby, které organizacím umožňují abstrahovat a provádět obchodní pravidla z technologické architektury a podporovat manažerský přístup prostřednictvím aktivace technologie, překlenutí organizačních a technologických sil.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa konfigurace koncového uživatele" id="id-ae6d93f3ecf04f7a90460e3e046490a1">
      <documentation>Software a / nebo služby, které řídí hardwarové a softwarové prostředí, jakož i dokumenty koncových uživatelů (jednotlivců nebo organizací).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Koncové uživatelské nástroje" id="id-514bd748668d4ae88eb060548f6b3bb4">
      <documentation>Nástroje koncového uživatele se skládají ze všech obslužných aplikací, které jsou k dispozici uživatelům standardního operačního prostředí (SOE). Mezi zařízeními bude požadována různost obslužných programů. Některé operační systémy navíc poskytují tyto funkce jako součást nativních schopností operačního systému. Je proto třeba věnovat pozornost tomu, abyste neposkytli pouze obslužný program, protože je v tomto seznamu, ale místo toho zajistěte, aby tyto funkce byly poskytovány úplným SOE při minimalizaci počtu obslužných programů dodávaných jako samostatné aplikace.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Mobilní aplikace" id="id-a2b49e6150714fbf886b21cb2a59f0ae">
      <documentation>Mobilní aplikace jsou softwarové aplikace, které jsou vytvořeny a nasazeny pro podporu mobilních zařízení, jako jsou chytré telefony, tablety, emulátory a další.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sady produktivity" id="id-5dd639ecec4546d2bf7d63627d592e8e">
      <documentation>Productivity Suite je základní sada dodávaných aplikací, které podporují nejčastěji používané kancelářské činnosti, jako například; Textový procesor, tabulkový procesor, e-mailoví klienti, prezentační software, kreslicí nástroje, publikační software a databázová aplikace.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Grafika a multimédia" id="id-64a9596da49945eb9eea98a884bb427d">
      <documentation>Software nebo služby podporující vizualizaci.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Výkon agend a zpracování podání (AIS)" id="id-a2db18ad5dd749b09488a2f2726adc3c">
      <documentation>Software a / nebo služby, které podporují správu životního cyklu konkrétního podání v rámci úřadu, včetně vytváření, směrování, trasování, přiřazování, rozhodování a uzavírání podání, jakož i spolupráce mezi zpracovateli jednotlivýžch úkonů. Podání spojují informace týkající se jedné nebo více stran za účelem koordinace různých aktivit, služeb a produktů za účelem dosažení úspěšného výsledku.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Marketing" id="id-ffb9984fe41a42769900878240019810">
      <documentation>Software a / nebo služby k usnadnění marketingu a propagace produktů a služeb.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Řízení vztahů se zákazníky (CRM)" id="id-da6d155691c6406c8fcb6ccc3ad931bc">
      <documentation>Software a / nebo služby na podporu řízení vztahů se zákazníky (CRM). Software používaný k plánování, plánování a řízení činností mezi zákazníkem a podnikem před a po nabídce produktu nebo služby.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Řízení partnerských vztahů (PRM)" id="id-1876c6f917d24fcc8b21a57c1e57b849">
      <documentation>Software a / nebo služby, které podporují efektivní spolupráci mezi organizací a jejími obchodními partnery, poskytovateli, zejména členy distribučního řetězce (např. Kanály a alianční partneři, prodejci, agenti, makléři a prodejci) a dalšími třetími stranami, které podporují provoz a poskytování služeb zákazníkům organizace; zahrnuje hodnocení výkonu partnerů, je-li to nutné.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Finanční transakce zákazníka" id="id-8f53a594896b44f984518a45e0274e54">
      <documentation>Software a / nebo služby pro finanční transakce se zákazníky státní správy, organizacemi i jednotlivci. Relevantní finanční transakce budou pravděpodobně zahrnovat poplatky, pokuty, daně, granty, výhody, dotace a další výplaty. Tuto kategorii vyberte, pouze pokud jsou příslušné funkce prováděny mimo váš FMIS (Financial Management Information Systems.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Front-end zákaznického servisu" id="id-8ce96c2e0c724ad8bcc15fbd715312fa">
      <documentation>Software a / nebo služby, které podporují aktivity spojené s poskytováním informací agenturním zákazníkům o nabídkách služeb agentury a správě front-end interakcí.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa grantů a dotací" id="id-a9485d29a6af40669334fd8ef8465d45">
      <documentation>Software, který podporuje správu grantů, kdy organizace nebo jednotlivec poskytuje peníze za určitým účelem.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Služby krizového řízení" id="id-90a08744edf748b4b7e59421489c3fd7">
      <documentation>Software, který podporuje poskytování služeb v rámci aktivit krizového řízení.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Produkty a správa služeb (ITSM)" id="id-bd8cca6aca51470198edfaa64e7b55b3">
      <documentation>Software a / nebo služby, které usnadňují vytváření a údržbu produktů a služeb v rámci řízení životního cyklu ISVS, správy katalogu a řízení výkonu agend.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Multifunkční podpora" id="id-f777ddd5f0194125a2b6e2df02a09a43">
      <documentation>Tyto aplikace a software v této kategorii nelze často nějak kategorizovat, protože podporují mnoho funkcí. Často se jedná o vysoce specializované vertikálně integrované aplikace, které podporují jedinečné í funkce v rámci úřadu. Aplikace tohoto druhu byly obvykle vyvinuty v minulosti, když ještě převažujícím vzorem návrhu byly velké monolitické systémy integrující velké množství funkcí.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Systém řízení byznys procesů (BPMS)" id="id-1ad2827232044fbf8c684d9a39d8dd28">
      <documentation>Systém Business Process Management System (BPMS) je považován za kritickou součást řešení provozní inteligence (Operation Intelligence), která poskytuje informace v reálném čase, na které je nutno reagovat. Na tyto informace lze reagovat různými způsoby - lze zasílat výstrahy nebo přijímat výkonná rozhodnutí pomocí řídicích panelů v reálném čase. Řešení OI používají informace v reálném čase k provádění automatizovaných akcí na základě předdefinovaných pravidel, aby bylo možné zahájit bezpečnostní opatření nebo procesy správy výjimek.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa aplikačních rozhraní" id="id-968715e687504a689eae206379e1727d">
      <documentation>Software nebo služby podporující komunikaci, přepravu a výměnu informací prostřednictvím společného dialogu nebo metody. Dodací kanály poskytují informace k dosažení zamýšleného cíle, zatímco rozhraní umožňují interakci na základě předem určeného rámce.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Datová interoperabilita" id="id-bdeaa06589d3434ba36941ab098867ad">
      <documentation>Data Interoperability definuje software nebo služby pro sdílení dat a služeb napříč různými systémy a prodejci.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Brány a aplikační proxy" id="id-4fd920939ef140b3a7fa58d143377a0c">
      <documentation>Software a / nebo služby používané pro brány informační vrstvy a automatizovaná elektronická rozhraní mezi sítěmi nebo systémy. Nezahrnuje zařízení hraniční ochrany. Poskytuje různé brány, které se používají k poskytování automatizovaných elektronických rozhraní s externími organizacemi nebo stranami a interně mezi zájmovými komunitami nebo síťovými doménami.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Servisně orientovaná architektura a katalog služeb (SOA)" id="id-77314a23bdb14ee09cbccd77b68f0631">
      <documentation>V systémech / službách vyhovujících SOA poskytuje funkce aplikace pro správu integrace založené na SOA, včetně katalogu služeb</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Podniková sběrnice služeb (ESB)" id="id-9e0e345cd8234041a2ef9a82f6ea5916">
      <documentation>Enterprise Service Bus (ESB) je integrační metoda, při které je specializovaný subsystém vyhrazen pro komunikaci mezi jinými subsystémy. To umožňuje snížit počet připojení (rozhraní) pouze na jedno na subsystém, který se bude připojovat přímo k ESB. ESB je schopen převést rozhraní na jiné rozhraní. To umožňuje snížit náklady na integraci a poskytuje extrémní flexibilitu. Se systémy integrovanými pomocí této metody je možné zcela nahradit jeden subsystém jiným subsystémem, který poskytuje podobnou funkčnost, ale exportuje různá rozhraní, to vše je zcela transparentní pro ostatní subsystémy. Jedinou požadovanou akcí je implementace nového rozhraní mezi ESB a novým subsystémem .</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Podniková integrace aplikací (EAI)" id="id-aeb2891abb4048929bbd047c5970d609">
      <documentation>Podporujte redesign různorodých informačních systémů do jednoho systému, který používá společnou sadu datových struktur a pravidel .</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Podnikové plánování zdrojů (ERP)" id="id-513cfcc0a76a486a8c199809a5d4b353">
      <documentation>Plánování podnikových zdrojů (ERP) je software pro správu podnikových procesů, který umožňuje organizaci používat systém integrovaných aplikací ke správě úřadu a automatizaci mnoha funkcí back office souvisejících s technologiemi, službami a lidskými zdroji.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Finanční řízení (FMIS)" id="id-f2a8add6a996412696ab9398b13c7bb7">
      <documentation>Informační systém finančního řízení (FMIS) podporuje finanční účetnictví a manažerské účetnictví.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa lidských zdrojů (HRM)" id="id-9a807749b0384740b23e57df08f65e85">
      <documentation>Aplikace, software nebo služby podporující správu lidských zdrojů. Řízení lidských zdrojů (HRM nebo jednoduše HR) je funkce v organizacích navržená k maximalizaci výkonu zaměstnanců ve službách strategických cílů jejich zaměstnavatele. HR se primárně zabývá tím, jak jsou lidé řízeni v rámci organizací, se zaměřením na politiky a systémy. Personální oddělení a jednotky v organizacích jsou obvykle odpovědné za řadu činností, včetně náboru zaměstnanců, školení a rozvoje, hodnocení výkonu a odměňování (např. Řízení systémů odměňování a dávek). HR se také zabývá průmyslovými vztahy, tedy vyvážením organizačních postupů s předpisy vyplývajícími z kolektivního vyjednávání a vládních zákonů .</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa pracovních sil" id="id-e2054d8f21014b9e923236216756811b">
      <documentation>Aplikace, software nebo služby podporující správu pracovních sil. Správa pracovních sil zahrnuje všechny činnosti potřebné k udržení produktivní pracovní síly. Může být součástí nebo se může částečně překrývat s řízením lidských zdrojů a systémy ERP .</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa a strategie organizace" id="id-51e7dc58474a42cf9d0ec9d8732e1070">
      <documentation>Aplikace, software nebo služby, které podporují funkce správy a řízení společnosti. Správa a řízení společností obecně odkazuje na mechanismy, procesy a vztahy, kterými jsou společnosti řízeny a řízeny. Struktury správy určují rozdělení práv a odpovědností mezi různé účastníky společnosti (například představenstvo, manažery, akcionáře, věřitele, auditory, regulační orgány a další zúčastněné strany) a zahrnují pravidla a postupy pro rozhodování v záležitostech společnosti. Správa a řízení společností zahrnuje procesy, kterými jsou stanovovány a sledovány cíle společností v kontextu sociálního, regulačního a tržního prostředí. Mezi mechanismy správy patří monitorování akcí, zásad a rozhodnutí společností a jejich zástupců. Postupy správy a řízení společnosti jsou ovlivněny pokusy o sladění zájmů zúčastněných stran.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Korporátní administrativa" id="id-2fe395a364df42ae8ccd8701da5988a0">
      <documentation>Aplikace, software nebo služby, které podporují každodenní správu a údržbu interních administrativních operací.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Řízení dodavatelských řetězců (SCM)" id="id-b4d7aec3ed0f4b2c891c45fc2898f84f">
      <documentation>Řízení dodavatelského řetězce (SCM) je dohled nad materiály, informacemi a financemi, které procházejí procesem od dodavatele k výrobci přes velkoobchodníka po maloobchodníka po spotřebitele. Řízení dodavatelského řetězce zahrnuje koordinaci a integraci těchto toků v rámci i mezi společnostmi. Říká se, že konečným cílem jakéhokoli efektivního systému řízení dodavatelského řetězce je snížení zásob (za předpokladu, že produkty jsou k dispozici v případě potřeby). Jako řešení pro úspěšnou správu dodavatelského řetězce konkurují sofistikované softwarové systémy s webovými rozhraními webovým poskytovatelům aplikačních služeb (ASP), kteří slibují, že poskytnou část nebo celou službu SCM pro společnosti, které si své služby pronajímají</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Software a služby pro zajištění kontinuity" id="id-dc9ee4ee362343b9a43840693f699b53">
      <documentation>Software nebo služby na podporu kontinuity podnikání. To zahrnuje správu zdraví a bezpečnosti, správu katastrof.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sjednocená komunikace a spolupráce" id="id-a3879fb4a39d4c3bb4643712d12ddbed">
      <documentation>Software nebo služby podporující sjednocenou komunikaci a spolupráci.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Změnová řízení" id="id-3a3c29441bff417bbb4998af0de52455">
      <documentation>Software nebo služby podporující správu změn. Change Management je proces, nástroje a techniky pro řízení změn na straně lidí k dosažení požadovaného obchodního výsledku. Zahrnuje také organizační nástroje, které mohou být použity k tomu, aby jednotlivcům pomohly úspěšné osobní přechody vedoucí k přijetí a realizaci změny.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa vztahů se zainteresovanými stranami" id="id-f7773f0d7a524e1d97c2c8a54013749a">
      <documentation>Řízení vztahů se zúčastněnými stranami umožňuje agenturám vstupovat a seskupovat lidi a instituce, které mají o agenturu interní i externí zájem, a poskytovat jim informace o agentuře. Poskytuje agentuře prostředky ke sledování a správě toho, jaké informace a komunikace byly poskytnuty jednotlivým zúčastněným stranám.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Mzdy a daně" id="id-9afd9116b23845ff86112bd5d39ab5c5">
      <documentation>Mzdový software, který podporuje správu, výpočet a výplatu mezd zaměstnanců, bonusů a odpočtů včetně daně.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Datová a informační architektura" id="id-ff090c2d622c4f1dbac1957b335eb9bb">
      <documentation>Software a / nebo služby podporující architekturu dat a informací v organizaci, která se skládá z daových modelů, zásad, pravidel nebo standardů, které určují, která data se shromažďují a jak jsou ukládána, uspořádána, integrována a užívána v datových systémech a v organizaci. Data a informace jsou jednou z dimenzí architektury, které tvoří pilíře podnikové architektury a/nebo architektury řešení.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa údajů" id="id-3906eaa7d80648d38c56a1ba93737189">
      <documentation>Software nebo služby podporující správu dat. Správa dat zahrnuje lidi, procesy a informační technologie potřebné k vytvoření konzistentního a správného zacházení s údaji vednými v rámci organizace. Jedná se o sadu procesů, které zajišťují formální správu důležitých datových aktiv. Správa údajů zajišťuje, že údajům lze důvěřovat a že lidé musí být odpovědni za jakoukoli nepříznivou událost, ke které dojde kvůli nízké kvalitě dat. Jde o to, dát lidem na starosti řešení a prevenci problémů s údaji, aby se organizace mohla stát efektivnější a d§věryhopdnou. Správa údajů také popisuje evoluční proces vývoje údajů pro veřejnost, mění způsob myšlení společnosti a nastavuje procesy pro zpracování informací tak, aby je mohla využívat celá organizace a její okolí.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Ochrana dat" id="id-7ea2d98f99dd4f0c9b0a44101ad9a9ad">
      <documentation>Software a / nebo služby, které podporují zabezpečení a ochranu dat, definic přistupových oprávnění, archivaci, výmaz, maskování a replikaci dat.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa databází" id="id-8fff6ffe9af0422192265bd9e4be7ddd">
      <documentation>Software zajišťující správu a provoz databází včetně zálohování, obnovy dat a ladění výkonu databází.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Data, informační a analytické služby" id="id-9b1d812af8414359b43f1e790ca1a148">
      <documentation>Data a informační a analytické služby představují: digitální práva, vyhledávání a scanování dokumentů, optické rozpoznávání textů, anlýzy textu, hlasu, videa a zvuku, správu verzí a tvorbua pubilkaci otevřených dat</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Znalostní báze (KM)" id="id-e0c61d28372740fda2b98a747e703aec">
      <documentation>Nástroje pro sběr, konsolidaci a ukládání dat, nástroje pro základní statistický reporting, pokročilou prediktivní analýzu informací, tvorbu, ukládání a publikaci znalostí . Synergie oblastí Knowledge Management (KM) a Business Intelligence (BI) je sada strategií, procesů, aplikací, dat, produktů, technologií a technických architektur, které se používají na podporu sběru, analýzy, prezentace, šíření informací a tvorbu znalostí. KM a BI nástroje poskytují historický, aktuální a budoucí pohled na kvalitu a výkonnost procesů organizace. Běžnými funkcemi jsou reporting, online analytické zpracování, analytika, dolování dat, dolování procesů, zpracování složitých událostí, řízení výkonu, benchmarking, dolování textů, prediktivní analytika a preskriptivní analytika, které jsou schopné zvládnout velké množství strukturovaných a nestrukturovaných dat, která pomáhají identifikovat, rozvíjet a vytvářet nové strategické příležitosti a naplňovat klavlitu poskytovaných služeb. Cílem je umožnit snadnou interpretaci velkých dat a přehlednou vizualizaci znalostí. Identifikace nových příležitostí a implementace efektivní strategie založené na poznatcích může organizacím poskytnout přehled, konkurenční výhodu a dlouhodobou stabilitu.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Registry a specializované databáze" id="id-1b131eca903447abb0d0245dd2b48c35">
      <documentation>Napříč veřejnou správou existují registry informací nařízené legislativou a další vysoce specializované databáze. Mezi příklady patří registr obyvatel, registr územních prvků, obchodní registr právnických a podnikajících fyzických osob.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Geoprostorový informační systém (GIS)" id="id-144ce0b6dbac440e97f0267f1da8c87e">
      <documentation>Software nebo služby podporující geoprostorové informace.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Content Management System (CMS)" id="id-95999552bec2402a82def8b51646d9a5">
      <documentation>Systém pro správu obsahu (CMS) je aplikační software nebo služby, které umožňují publikování, úpravy a úpravy, organizaci a mazání obsahu. Systémy pro správu obsahu obecně nahrazují starší systémy správy dokumentů (DMS) a správa podnikového obsahu (ECM) zase zahrnuje správu obsahu na úrovni organizce.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Správa webového obsahu (WCM)" id="id-f0b42259845c49a0a5d586d25400d96f">
      <documentation>Web Content Management je software a / nebo služby, které poskytují nástroje pro tvorbu, spolupráci a správu webových stránek navržené tak, aby uživatelům s nízkou znalostí programovacích jazyků webu nebo značkovacích jazyků mohli relativně snadno vytvářet a spravovat obsah webových stránek. Robustní systém pro správu webového obsahu poskytuje základ pro spolupráci a nabízí uživatelům možnost spravovat dokumenty a výstup pro úpravy a účast více autorů.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Aplikace pro správu záznamů udržované v provozu (RM)" id="id-71edd7402a2946f795874616320a4306">
      <documentation>Aplikace a software udržované v provozu a funkční, protože informace v nich obsažené představují záznamy, které musí být uchovány a dostupné podle zákona o správě záznamů. Funkce se často migrují do nových aplikací, softwaru nebo služeb, ale staré systémy se zachovají, protože původní systém nesplňoval požadavky na správu záznamů a tyto záznamy se migrují do nového systému. Dříve v těchto aplikacích mohla být použita nějaká jiná kategorie, což by platilo pro současný systém, ale primární účel těchto systémů je nyní čistě jako úložiště správy záznamů (Record Management).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Umělá inteligence (AI)" id="id-00b3a7d53aa644bf8e089b9f7e080ee1">
      <documentation>Umělá inteligence je definována jako pokročilé digitální technologie, které umožňují strojům reprodukovat nebo překonávat schopnosti, které by vyžadovaly inteligenci, pokud by je lidé měli provádět. To zahrnuje technologie, které umožňují strojům učit se a přizpůsobovat se, vnímat a komunikovat, uvažovat a plánovat, optimalizovat postupy a parametry, pracovat samostatně, být kreativní a získávat znalosti z velkého množství dat.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Řízení životního cyklu obsahu (ECM)" id="id-d833d4df66fb4af18157cc5f6c61ec10">
      <documentation>Software nebo služby podporující správu podnikového obsahu (ECM) je zastřešující pojem zahrnující správu dokumentů, správu webového obsahu, vyhledávání, spolupráci, správu záznamů, správu digitálních aktiv (DAM), správu pracovních toků, snímání a skenování. ECM je primárně zaměřen na správu životního cyklu informací od počátečního zveřejnění nebo vytvoření až po archivaci a případnou likvidaci.</documentation>
    </element>
