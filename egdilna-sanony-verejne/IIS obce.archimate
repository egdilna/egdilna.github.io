    <element xsi:type="archimate:Grouping" name="Přestupky " id="id-596311a9eefa473881f14ec23dd532b5"/>
    <element xsi:type="archimate:Grouping" name="Poplatky " id="id-7f56efcda5d64d1b8aeb07903a2250a1"/>
    <element xsi:type="archimate:Grouping" name="Sociální oblast " id="id-3ecd8eb6dc904f35a48efbd0a58843e2"/>
