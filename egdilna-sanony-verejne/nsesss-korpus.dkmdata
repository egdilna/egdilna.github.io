      "archived": false
    },
    {
      "id": "e_poz_0016",
      "name": "2.3.2 ESSL zajišťuje využití následujících služeb informačního systému datových schránek: ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "2.3.2",
        "a_nazev": "ESSL zajišťuje využití následujících služeb informačního systému datových schránek: ➡",
        "a_poz_podrobnosti": "a) doručení datové zprávy,\nb) odeslání datové zprávy,\nc) ověření datové zprávy,\nd) získání informace o dodání a doručení datové zprávy,\ne) získání informace o odesílateli datové zprávy,\nf) vyhledání datové schránky a údajů o majiteli,\ng) kontrola přístupnosti datové schránky.\nPravidla pro realizaci rozhraní eSSL vůči informačnímu systému datových schránek pro využívání jednotlivých služeb se řídí Provozním řádem informačního systému datových schránek a jeho přílohami s definicí jednotlivých webových služeb informačního systému datových schránek.",
        "a_id_nsesss": 2302
      },
      "customAttributes": [],
      "relations": [
