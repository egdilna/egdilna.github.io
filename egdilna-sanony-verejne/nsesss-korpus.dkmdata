    {
      "id": "e_poz_0203",
      "name": "7.2.1 ESSL neumožní zničení komponenty, dokumentu, spisu, typového spisu, součásti typového spisu nebo dílu typového spisu nebo jejich metadat, s výjimkou zničení ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "7.2.1",
        "a_nazev": "ESSL neumožní zničení komponenty, dokumentu, spisu, typového spisu, součásti typového spisu nebo dílu typového spisu nebo jejich metadat, s výjimkou zničení ➡",
        "a_poz_podrobnosti": "a) po dokončeném skartačním řízení,\nb) na základě uděleného trvalého skartačního souhlasu,\nc) po úspěšném dokončení přenosu,\nd) po evidenčním převedení do jiné evidenční pomůcky,\ne) znepřístupněných dokumentů a spisů,\nf) samostatné komponenty došlého kontejneru po uzavření spisu, pokud došlo k úspěšnému vyjmutí všech obsažených komponent podle požadavku 2.4.3,\ng) prázdného dílu typového spisu podle požadavku 3.3.14 a 3.4.6.\nPři zničení musí být zachována hlavička metadat podle požadavku 7.2.9.",
        "a_id_nsesss": 7201
      },
      "customAttributes": [],
      "relations": [
