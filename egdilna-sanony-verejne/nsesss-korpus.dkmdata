    {
      "id": "e_poz_0042",
      "name": "2.8.8 ESSL umožňuje uživatelské roli ztotožnit záznam ve jmenném rejstříku prostřednictvím zadání údajů potřebných pro jeho ztotožnění. Za údaje potřebné pro ztotožnění osoby se považují alespoň: ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "2.8.8",
        "a_nazev": "ESSL umožňuje uživatelské roli ztotožnit záznam ve jmenném rejstříku prostřednictvím zadání údajů potřebných pro jeho ztotožnění. Za údaje potřebné pro ztotožnění osoby se považují alespoň: ➡",
        "a_poz_podrobnosti": "a) jméno, příjmení, datum narození a adresa trvalého pobytu u fyzické osoby,\nb) jméno, příjmení, datum narození, adresa sídla a právní forma u fyzické osoby podnikající,\nc) obchodní firma nebo název nebo označení a právní forma u právnické osoby,\nd) identifikační číslo osoby u právnické osoby nebo fyzické osoby podnikající, e) identifikátor datové schránky.",
        "a_id_nsesss": 2808
      },
      "customAttributes": [],
      "relations": [
