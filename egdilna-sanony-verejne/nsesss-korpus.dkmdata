    {
      "id": "e_poz_0024",
      "name": "2.5.2 ESSL při změně datového formátu podle požadavku 2.5.1 připojí doložku obsahující informace uvedené v právním předpisu upravujícím podrobnosti výkonu spisové služby ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "2.5.2",
        "a_nazev": "ESSL při změně datového formátu podle požadavku 2.5.1 připojí doložku obsahující informace uvedené v právním předpisu upravujícím podrobnosti výkonu spisové služby ➡",
        "a_poz_podrobnosti": "a) do stejné komponenty za obsah vstupu změny datového formátu, umožňuje-li to formát výstupu změny datového formátu, nebo\nb) do nové komponenty ve výstupním formátu statických textových dokumentů; v takovém případě bude součástí doložky hash výstupní komponenty ze změny datového formátu a název použité hashovací funkce.",
        "a_id_nsesss": 2502
      },
