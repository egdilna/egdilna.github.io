      "archived": false
    },
    {
      "id": "e_poz_0274",
      "name": "9.2.2 ESSL zajistí, že datový balíček SIP je tvořen ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "9.2.2",
        "a_nazev": "ESSL zajistí, že datový balíček SIP je tvořen ➡",
        "a_poz_podrobnosti": "a) právě jedním dílem typového spisu, a to případně včetně entit, které k němu byly podle předchozí právní úpravy připojeny pevnými křížovými odkazy,\nb) právě jedním spisem,\nc) spisy, pokud jsou navzájem propojeny pevnými křížovými odkazy,\nd) právě jedním samostatným dokumentem, pokud byl podle předchozí právní úpravy zatříděn přímo do věcné skupiny.\nPísmeno d) se použije obdobně i na dokumenty samostatné evidence dokumentů, která sama nevytváří spisy.",
        "a_id_nsesss": 9202
      },
      "customAttributes": [],
      "relations": [
        {
          "id": "r_ns_00303",
          "relationTypeId": "rt_je_soucasti",
