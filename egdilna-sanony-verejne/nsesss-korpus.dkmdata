    {
      "id": "e_poz_0284",
      "name": "9.2.12 ESSL zajistí, že název datového balíčku SIP je v rámci eSSL jedinečný, přičemž obsahuje pouze písmena latinské abecedy bez diakritiky, čísla a znaky „_\" (podtržítko) a „--\" (pomlčka) a jeho délka nepřekročí 64 znaků.",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "9.2.12",
        "a_nazev": "ESSL zajistí, že název datového balíčku SIP je v rámci eSSL jedinečný, přičemž obsahuje pouze písmena latinské abecedy bez diakritiky, čísla a znaky „_\" (podtržítko) a „--\" (pomlčka) a jeho délka nepřekročí 64 znaků.",
        "a_id_nsesss": 9212
      },
