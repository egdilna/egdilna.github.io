    },
    {
      "id": "e_poz_0149",
      "name": "5.2.6 ESSL znázorní uživatelské roli alespoň tato metadata: ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "5.2.6",
        "a_nazev": "ESSL znázorní uživatelské roli alespoň tato metadata: ➡",
        "a_poz_podrobnosti": "a) jednoznačný identifikátor,\nb) číslo jednací dokumentu (požadavek 2.7.4),\nc) spisový znak,\nd) část transakčního protokolu zachycující historii entity, zejména oběh,\ne) spisovou značku spisu,\nf) název typového spisu a součásti typového spisu,\ng) datum uzavření věcné skupiny, spisu, typového spisu, součásti typového spisu a dílu typového spisu,\nh) skartační režim,\ni) křížové odkazy na jiné entity,\nj) informaci o umístění analogové části spisu,\nk) podobu dokumentu (analogová, nebo digitální); jestliže je alespoň jedna z částí dokumentu analogová, podoba celého dokumentu se považuje za analogovou.",
        "a_id_nsesss": 5206
      },
