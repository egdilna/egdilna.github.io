      "name": "9.2.10 ESSL zajistí, že komponenty se ukládají do adresáře (složky) s názvem „komponenty\". Příklad: ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "9.2.10",
        "a_nazev": "ESSL zajistí, že komponenty se ukládají do adresáře (složky) s názvem „komponenty\". Příklad: ➡",
        "a_poz_podrobnosti": "jednoznacny_nazev_sip [dir] |-komponenty [dir]\n|-nazev_souboru_pdfA.pdf\n|-mets.xml",
