    {
      "id": "e_poz_0262",
      "name": "8.1.25 Přístup k entitám je vždy výhradní, tedy události týkající se dané entity smí vytvářet pouze systém, který má aktuálně entitu ve své výhradní správě. Změna výhradní správy z jednoho systému na druhý je možná pouze prostřednictvím příslušných událostí. Výjimka je přípustná pouze jedna a je popsána požadavkem 8.1.27.",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "8.1.25",
        "a_nazev": "Přístup k entitám je vždy výhradní, tedy události týkající se dané entity smí vytvářet pouze systém, který má aktuálně entitu ve své výhradní správě. Změna výhradní správy z jednoho systému na druhý je možná pouze prostřednictvím příslušných událostí. Výjimka je přípustná pouze jedna a je popsána požadavkem 8.1.27.",
        "a_id_nsesss": 8125
