    {
      "id": "e_poz_0243",
      "name": "8.1.6 V rámci jednoho volání synchronní webové služby podle požadavku 8.1.8 musí být jednotlivá událost buď zcela a bezezbytku zpracována, nebo v případě vzniku chyby nebo stavu, kdy příjemce aktivně odmítne událost zpracovat, nesmí být zpracována vůbec. Částečné zpracování události je nepřípustné.",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "8.1.6",
        "a_nazev": "V rámci jednoho volání synchronní webové služby podle požadavku 8.1.8 musí být jednotlivá událost buď zcela a bezezbytku zpracována, nebo v případě vzniku chyby nebo stavu, kdy příjemce aktivně odmítne událost zpracovat, nesmí být zpracována vůbec. Částečné zpracování události je nepřípustné.",
        "a_id_nsesss": 8106
