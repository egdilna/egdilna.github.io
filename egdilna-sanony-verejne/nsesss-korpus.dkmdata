    {
      "id": "e_poz_0265",
      "name": "8.1.28 V rámci konfigurace vazby mezi eSSL a informačním systémem spravujícím dokumenty musí být ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "8.1.28",
        "a_nazev": "V rámci konfigurace vazby mezi eSSL a informačním systémem spravujícím dokumenty musí být ➡",
        "a_poz_podrobnosti": "a) sjednoceny všechny hodnoty ve všech propojených systémech, nebo\nb) vytvořeny a implementovány převodní můstky mezi hodnotami použitými v jednotlivých systémech.\nJedná se alespoň o následující metadata:\n1) uživatel („provedlKdo\", „novyZpracovatel\", „VlastniKdo\"),\n2) spisový a skartační plán („SpisovyPlan\"),\n3) spisový znak („SpisovyZnak\"),\n4) druh dokumentu („DruhDokumentu\"),\n5) podací deník („PodaciDenik\"),\n6) způsob vyřízení spisu nebo dokumentu („ZpusobVyrizeni\"),\n7) skartační režim,\n8) spouštěcí událost.",
        "a_id_nsesss": 8128
      },
      "customAttributes": [],
      "relations": [
        {
          "id": "r_ns_00294",
          "relationTypeId": "rt_je_soucasti",
          "targetId": "e_podk_0025"
        }
      ],
      "aspects": [],
      "createdAt": "2026-09-02T13:00:00.000Z",
      "updatedAt": "2026-09-02T13:00:00.000Z",
      "archived": false
    },
    {
      "id": "e_poz_0266",
      "name": "8.1.29 ESSL umožní pomocí rozhraní postoupit entitu ke zpracování informačnímu systému spravujícímu dokumenty na žádost uživatele podanou prostřednictvím informačního systému spravujícího dokumenty. Uživatel informačního systému spravujícího dokumenty si může vyžádat seznam přidělených dokumentů, spisů a součástí typových spisů prostřednictvím informačního systému spravujícího dokumenty bez toho, že by musel pracovat s eSSL.",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "8.1.29",
        "a_nazev": "ESSL umožní pomocí rozhraní postoupit entitu ke zpracování informačnímu systému spravujícímu dokumenty na žádost uživatele podanou prostřednictvím informačního systému spravujícího dokumenty. Uživatel informačního systému spravujícího dokumenty si může vyžádat seznam přidělených dokumentů, spisů a součástí typových spisů prostřednictvím informačního systému spravujícího dokumenty bez toho, že by musel pracovat s eSSL.",
