    {
      "id": "e_poz_0096",
      "name": "3.3.2 ESSL při založení nového typového spisu v dané věcné skupině automaticky otevře součásti a díly typového spisu podle šablony typového spisu definované pro tuto věcnou skupinu.",
      "typeId": "t_poz",
