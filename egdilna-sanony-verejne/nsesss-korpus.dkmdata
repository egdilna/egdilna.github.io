      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "5.1.3",
        "a_nazev": "ESSL umožňuje roli podle přístupových oprávnění vyhledat a vybrat ➡",
        "a_poz_podrobnosti": "a) dokumenty,\nb) jakoukoli úroveň věcné skupiny, spisu, typového spisu a součásti typového spisu a jejich příslušná metadata.",
