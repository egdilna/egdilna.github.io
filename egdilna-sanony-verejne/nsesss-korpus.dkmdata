    {
      "id": "e_poz_0015",
      "name": "2.3.1 ESSL zajišťuje stahování a odesílání přes ISDS ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "2.3.1",
        "a_nazev": "ESSL zajišťuje stahování a odesílání přes ISDS ➡",
        "a_poz_podrobnosti": "a) automatizované stahování a uložení datových zpráv doručených prostřednictvím informačního systému datových schránek,\nb) odesílání datových zpráv prostřednictvím informačního systému datových schránek,\nc) stahování a uložení informace o dodání datové zprávy do datové schránky adresáta a o doručení datové zprávy (zásilky).",
        "a_id_nsesss": 2301
      },
      "customAttributes": [],
      "relations": [
