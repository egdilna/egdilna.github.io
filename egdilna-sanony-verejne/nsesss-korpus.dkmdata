    {
      "id": "e_poz_0241",
      "name": "8.1.4 Rozhraní mezi informačními systémy spravujícími dokumenty je založeno na nedělitelných událostech podle požadavků 8.1.8 a 8.1.10 a pracuje s entitami a jejich metadaty. Každá událost je označena identifikátorem; identifikátor události je jednoznačný v rámci daného systému a jeho součástí je jednoznačný identifikátor systému podle požadavku 8.1.2.",
      "typeId": "t_poz",
