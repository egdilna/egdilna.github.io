    {
      "id": "e_poz_0196",
      "name": "7.1.5 ESSL do okamžiku uzavření spisu umožní uživatelské roli podle přístupových oprávnění změnit metadata dokumentu a spisu zapsaná uživatelskou rolí. Po uzavření spisu eSSL umožní správcovské roli změnit metadata dokumentu a spisu zapsaná uživatelskou rolí.",
      "typeId": "t_poz",
