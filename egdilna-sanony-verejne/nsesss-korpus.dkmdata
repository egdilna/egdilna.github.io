    },
    {
      "id": "e_poz_0151",
      "name": "5.2.8 ESSL pro hromadný tisk zajistí uživatelské roli znázornění údajů stanovených v požadavcích 5.2.3 až 5.2.7.",
      "typeId": "t_poz",
      "inInbox": false,
