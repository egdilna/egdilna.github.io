      "archived": false
    },
    {
      "id": "e_poz_0204",
      "name": "7.2.2 ESSL zabrání změně komponenty, která je ➡",
      "typeId": "t_poz",
      "inInbox": false,
      "attributes": {
        "a_cislo": "7.2.2",
        "a_nazev": "ESSL zabrání změně komponenty, která je ➡",
        "a_poz_podrobnosti": "a) schválena, pokud nedojde k odvolání schválení příslušnou rolí,\nb) komponentou doručeného dokumentu, s výjimkou provádění požadavků 2.4.1, 2.4.2 a 2.5.1.",
