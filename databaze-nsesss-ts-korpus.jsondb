      "records": [
        {
          "id": "id_abc91b4a7e3e4a4db80c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "PŘÍJEM A EVIDENCE DOKUMENTŮ",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 2000
          }
        },
        {
          "id": "id_1f0077e3c56248b5b76d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Příjem",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2100
          }
        },
        {
          "id": "id_98631cb147234660a1df",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automaticky čísluje všechny verze komponent dokumentu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2101
          }
        },
        {
          "id": "id_1b16260d747d409bb312",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je přijímaný dokument složen z několika komponent, eSSL přijme všechny jeho komponenty a dále spravuje dokument jako jedinou entitu tak, aby byly zachovány vztahy mezi komponentami a aby byla uchována struktura dokumentu.",
            "id_mkh1re80717c6gqi7": "ESSL současně automaticky zaznamená počet komponent do metadat dokumentu.",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2102
          }
        },
        {
          "id": "id_8cf3717bb11747d7ae49",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při příjmu komponenty dokumentu automaticky identifikuje její datový formát, včetně verze formátu podle vnitřní struktury komponenty. ESSL tyto informace ukládá do metadat komponenty.",
            "id_mkh1re80717c6gqi7": "Informace pro automatickou identifikaci datových formátů poskytuje například registr PRONOM (www.nationalarchives.gov.uk/PRONOM/).",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2103
          }
        },
        {
          "id": "id_564bfd04f16b4998879a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL přijímá entity a metadata v souladu s XML schématy uvedenými v přílohách č. 1, 5, 6 a 8.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2104
          }
        },
        {
          "id": "id_b6feb099dd164c61815e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL od příjmu do vyřazení entity průběžně zaznamenává metadata v rozsahu podle přílohy č. 8.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2105
          }
        },
        {
          "id": "id_f4e7fef6d41e48d3b93e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní předat doručený dokument příslušné fyzické osobě, pokud byl určen k rukám nebo do vlastních rukou.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2106
          }
        },
        {
          "id": "id_dd26599005f24dab9acd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na pokyn uživatelské role při příjmu dokumentu neuloží komponentu dokumentu v případě, že se jedná o komponentu v nepřijímaném datovém formátu, nepřijímané velikosti nebo s jinou vadou, na jejímž základě je odesílatel vyzván k opravě vad dokumentu. ESSL nahradí neuloženou komponentu ztvárněním informací o důvodu jejího neuložení do nové komponenty.",
            "id_mkh1re80717c6gqi7": "ESSL vždy zaznamená údaje o odesílateli a datu doručení dokumentu bez ohledu na uložení, nebo neuložení jeho komponent.",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2107
          }
        },
        {
          "id": "id_daec939e2e0947b18264",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při příjmu zaznamená do metadat velikost jednotlivých komponent obsažených v datové zprávě doručené datovou schránkou.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2108
          }
        },
        {
          "id": "id_5482b3599faa42418cfa",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "E-mailové schránky",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2200
          }
        },
        {
          "id": "id_223e4f031cd140cab359",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje stahování a odesílání e-mailových zpráv ➡",
            "id_mkh1re80717c6gqi7": "a) automatizované stahování a uložení e-mailových zpráv doručených na elektronické adresy podatelny,\nb) odesílání e-mailových zpráv prostřednictvím elektronické adresy podatelny.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2201
          }
        },
        {
          "id": "id_ab9f369f97a849028a5e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL prostřednictvím funkčního rozšíření poštovního klienta nebo prostředky eSSL umožňuje uživatelské roli přijetí touto rolí vybrané e-mailové zprávy, která byla doručena na jinou e-mailovou adresu, než je elektronická adresa podatelny.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2202
          }
        },
        {
          "id": "id_62cae93acd0140ce85c9",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je e-mailová zpráva přijata, eSSL uchová jako samostatné komponenty dokumentu ➡",
            "id_mkh1re80717c6gqi7": "a) e-mailovou zprávu v původním formátu postupem podle požadavku 2.4.2,\nb) obsah (tělo) e-mailové zprávy a\nc) jednotlivé připojené přílohy.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2203
          }
        },
        {
          "id": "id_52c9468add1f45248bf4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL z přijaté e-mailové zprávy automaticky vyjímá následující metadata (pokud jsou obsažena v hlavičce e-mailové zprávy): ➡",
            "id_mkh1re80717c6gqi7": "a) datum a čas odeslání e-mailové zprávy,\nb) předmět (věc),\nc) odesílatel e-mailové zprávy ve vazbě na jmenný rejstřík.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2204
          }
        },
        {
          "id": "id_e57deab1f6b64645a24e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli při příjmu e-mailové zprávy upravit metadata automaticky vyjmutá z e-mailové zprávy podle požadavku 2.2.4.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2205
          }
        },
        {
          "id": "id_e05eac5ec1d7443f9cfd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automatizovaně zašle potvrzení ➡",
            "id_mkh1re80717c6gqi7": "a) o přijetí zprávy,\nb) o nepřijetí/vadě zprávy.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2206
          }
        },
        {
          "id": "id_259de44b90814f53b4f8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.3",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Datové schránky",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2300
          }
        },
        {
          "id": "id_965d46b3e3dd45d78f10",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.3.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje stahování a odesílání přes ISDS ➡",
            "id_mkh1re80717c6gqi7": "a) automatizované stahování a uložení datových zpráv doručených prostřednictvím informačního systému datových schránek,\nb) odesílání datových zpráv prostřednictvím informačního systému datových schránek,\nc) stahování a uložení informace o dodání datové zprávy do datové schránky adresáta a o doručení datové zprávy (zásilky).",
            "id_mkh1ruycu0iq9beiq": "id_259de44b90814f53b4f8",
            "id_mkh21fijkx4bety3t": 2301
          }
        },
        {
          "id": "id_360c71d0e7db4d088f8d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.3.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje využití následujících služeb informačního systému datových schránek: ➡",
            "id_mkh1re80717c6gqi7": "a) doručení datové zprávy,\nb) odeslání datové zprávy,\nc) ověření datové zprávy,\nd) získání informace o dodání a doručení datové zprávy,\ne) získání informace o odesílateli datové zprávy,\nf) vyhledání datové schránky a údajů o majiteli,\ng) kontrola přístupnosti datové schránky.\nPravidla pro realizaci rozhraní eSSL vůči informačnímu systému datových schránek pro využívání jednotlivých služeb se řídí Provozním řádem informačního systému datových schránek a jeho přílohami s definicí jednotlivých webových služeb informačního systému datových schránek.",
            "id_mkh1ruycu0iq9beiq": "id_259de44b90814f53b4f8",
            "id_mkh21fijkx4bety3t": 2302
          }
        },
        {
          "id": "id_e575f3db57db467e96ad",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.3.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vyhledání datové schránky v informačním systému datových schránek.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_259de44b90814f53b4f8",
            "id_mkh21fijkx4bety3t": 2303
          }
        },
        {
          "id": "id_cd9128aa6176490a8450",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.3.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje stahování údajů z obálek doručených datových zpráv a jejich uložení do metadat eSSL v rozsahu: ➡",
            "id_mkh1re80717c6gqi7": "a) datum a čas dodání,\nb) datum a čas doručení,\nc) odesílatel.",
            "id_mkh1ruycu0iq9beiq": "id_259de44b90814f53b4f8",
            "id_mkh21fijkx4bety3t": 2304
          }
        },
        {
          "id": "id_3306bf7f223e44a7a74e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.3.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je datová zpráva přijata, eSSL uchová jako samostatné komponenty dokumentu ➡",
            "id_mkh1re80717c6gqi7": "a) datovou zprávu v původním formátu postupem podle požadavku 2.4.2,\nb) hlavičku datové zprávy ztvárněnou do samostatné komponenty a\nc) jednotlivé připojené komponenty.",
            "id_mkh1ruycu0iq9beiq": "id_259de44b90814f53b4f8",
            "id_mkh21fijkx4bety3t": 2305
          }
        },
        {
          "id": "id_56a9a68fccca4d13a264",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.4",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Kontejnerové datové formáty",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2400
          }
        },
        {
          "id": "id_650ddee926684205b42c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.4.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí při příjmu doručeného dokumentu automatizované zpracování komponenty dokumentu v datovém formátu, který má charakter kontejneru, podle požadavků 2.4.3 a 2.4.4, a to alespoň pro formáty ASiC, FO/ZFO, EML, ISDOCX, ZIP, PDF/A. Povinnost automatického zpracování se nevztahuje na šifrované komponenty v datovém formátu, který má charakter kontejneru, a na již zpracované datové zprávy.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_56a9a68fccca4d13a264",
            "id_mkh21fijkx4bety3t": 2401
          }
        },
        {
          "id": "id_e84b8f04b89f43659fbc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.4.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL uchová kontejner doručeného dokumentu v nezměněné podobě jako samostatnou komponentu alespoň do okamžiku uzavření spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_56a9a68fccca4d13a264",
            "id_mkh21fijkx4bety3t": 2402
          }
        },
        {
          "id": "id_78c0c81d514348139d1f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.4.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při automatizovaném zpracování kontejneru zajistí vyjmutí všech komponent vnořených v první úrovni kontejneru a jejich uložení jako samostatných komponent. Pokud je vyjmutá komponenta v datovém formátu uvedeném v požadavku 2.4.1, proces automatického zpracování se opakuje. ESSL v případě selhání automatického zpracování kontejneru poskytne zpracovateli informaci o selhání.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_56a9a68fccca4d13a264",
            "id_mkh21fijkx4bety3t": 2403
          }
        },
        {
          "id": "id_e576ab88e8424773b2af",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.5",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Změna datového formátu komponenty a převod dokumentu",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2500
          }
        },
        {
          "id": "id_1c0da80d5ae74cbf8c26",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.5.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL po provedení požadavků kapitoly 2.6 v případě statických textových dokumentů, statických kombinovaných textových a obrazových dokumentů a statických obrazových dokumentů (alespoň DOC, DOCX, XLS, XLSX, PPT, PPTX, ODT, ODS, ODP, RTF, TXT, PDF, HTM, HTML, BMP) automatizovaně provede změnu datového formátu komponenty na výstupní a výstup změny datového formátu uloží jako novou verzi téže komponenty.",
            "id_mkh1re80717c6gqi7": "Převod datových formátů lze řešit i jako asynchronní operaci tak, aby nebylo blokováno další zpracování dokumentu.",
            "id_mkh1ruycu0iq9beiq": "id_e576ab88e8424773b2af",
            "id_mkh21fijkx4bety3t": 2501
          }
        },
        {
          "id": "id_d8873ec041df4f5199d7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.5.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při změně datového formátu podle požadavku 2.5.1 připojí doložku obsahující informace uvedené v právním předpisu upravujícím podrobnosti výkonu spisové služby ➡",
            "id_mkh1re80717c6gqi7": "a) do stejné komponenty za obsah vstupu změny datového formátu, umožňuje-li to formát výstupu změny datového formátu, nebo\nb) do nové komponenty ve výstupním formátu statických textových dokumentů; v takovém případě bude součástí doložky hash výstupní komponenty ze změny datového formátu a název použité hashovací funkce.",
            "id_mkh1ruycu0iq9beiq": "id_e576ab88e8424773b2af",
            "id_mkh21fijkx4bety3t": 2502
          }
        },
        {
          "id": "id_d6f45c08f55b4f2ea3c2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.5.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL v případě vlastních dokumentů původce postupuje obdobně jako v požadavku 2.5.1 ➡",
            "id_mkh1re80717c6gqi7": "a) před podepsáním komponenty, a\nb) při uzavření spisu, pokud nebyla komponenta podepsána.\nPřipojení doložky podle požadavku 2.5.2 a časového razítka se nevyžaduje.",
            "id_mkh1ruycu0iq9beiq": "id_e576ab88e8424773b2af",
            "id_mkh21fijkx4bety3t": 2503
          }
        },
        {
          "id": "id_bec17d1920fb4f9aa628",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.5.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL v případě převodu dokumentu z analogové do digitální podoby připojí doložku obsahující informace uvedené v právním předpisu upravujícím podrobnosti výkonu spisové služby obdobně jako v požadavku 2.5.2.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e576ab88e8424773b2af",
            "id_mkh21fijkx4bety3t": 2504
          }
        },
        {
          "id": "id_e51699137b934d20a569",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.5.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL opatří výstup převodu dokumentu podle požadavku 2.5.2 nebo změny datového formátu dokumentu podle požadavku 2.5.4 příslušnými zajišťovacími prvky.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e576ab88e8424773b2af",
            "id_mkh21fijkx4bety3t": 2505
          }
        },
        {
          "id": "id_8355cbddb1ed477fa7ab",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.6",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Ověřování zajišťovacích prvků",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2600
          }
        },
        {
          "id": "id_6827eb5cde2446a7904c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.6.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při příjmu nebo vložení komponenty automatizovaně zajistí ověření platnosti zajišťovacích prvků, které jsou ke komponentám připojeny.",
            "id_mkh1re80717c6gqi7": "Ověření platnosti zajišťovacích prvků lze řešit i jako asynchronní operaci tak, aby nebylo blokováno další zpracování dokumentu.",
            "id_mkh1ruycu0iq9beiq": "id_8355cbddb1ed477fa7ab",
            "id_mkh21fijkx4bety3t": 2601
          }
        },
        {
          "id": "id_0e6ed4bec6e448da872a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.6.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při ověření zajišťovacích prvků v době příjmu nebo vložení zaznamená do metadat údaje stanovené právním předpisem upravujícím podrobnosti výkonu spisové služby nebo k dokumentu připojí samostatnou komponentu, která údaje o ověření obsahuje.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8355cbddb1ed477fa7ab",
            "id_mkh21fijkx4bety3t": 2602
          }
        },
        {
          "id": "id_cc9f635c905e47d79bb0",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Evidence dokumentů",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2700
          }
        },
        {
          "id": "id_1548cf1217e94421b4d7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automatizovaně přidělí každé entitě jednoznačný identifikátor. Jednoznačné identifikátory se přiřazují alespoň k ➡",
            "id_mkh1re80717c6gqi7": "a) spisovému a skartačnímu plánu jako celku,\nb) věcné skupině,\nc) spisu,\nd) typovému spisu,\ne) součásti typového spisu,\nf) dílu typového spisu,\ng) dokumentu (jednoznačný identifikátor dokumentu),\nh) komponentě,\ni) skartačnímu režimu.",
            "id_mkh1ruycu0iq9beiq": "id_cc9f635c905e47d79bb0",
            "id_mkh21fijkx4bety3t": 2701
          }
        },
        {
          "id": "id_de3b532c991e4183991f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL přiřadí dokumentu pořadové číslo v rámci předem určeného časového období, zpravidla konkrétního kalendářního roku. Správcovská role stanoví před začátkem určeného časového období jeho počátek a konec.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_cc9f635c905e47d79bb0",
            "id_mkh21fijkx4bety3t": 2702
          }
        },
        {
          "id": "id_5c9cc221807b467ea5f7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vede číselník organizačních součástí původce nebo jiných údajů stanovených původcem. Číselník udržuje správcovská role a obsahuje alespoň ➡",
            "id_mkh1re80717c6gqi7": "a) údaj,\nb) datum počátku používání údaje,\nc) datum konce používání údaje.\nESSL umožňuje znázornění a export/import číselníku prostřednictvím přílohy č. 7.",
            "id_mkh1ruycu0iq9beiq": "id_cc9f635c905e47d79bb0",
            "id_mkh21fijkx4bety3t": 2703
          }
        },
        {
          "id": "id_e38a26450b14471a86c4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli konfigurovat strukturu čísla jednacího (míněno pořadí metadat a oddělovače) podle právního předpisu upravujícího podrobnosti výkonu spisové služby: ➡",
            "id_mkh1re80717c6gqi7": "a) vycházející z pořadového čísla dokumentu v rámci předem určeného časového období (viz požadavek 2.7.2),\nb) vycházející ze spisové značky doplněním pořadového čísla dokumentu ve spisu.\nNapříklad URAD-EPR/2008-525, kde „525\" je pořadové číslo v rámci určeného časového období, „2008\" určené časové období a „EPR\" označení organizační součásti (požadavek 2.7.3). Obdobně URAD-EPR/2008-222-11, kde „URADEPR/2008-222\" je spisová značka a „11\" pořadové číslo dokumentu ve spisu. Použití variant podle písm. a) nebo b) se řídí v příslušné věcné skupině nebo součásti typového spisu příznakem podle požadavku 3.1.2 písm. h), respektive požadavku 3.3.6 písm. c).",
            "id_mkh1ruycu0iq9beiq": "id_cc9f635c905e47d79bb0",
            "id_mkh21fijkx4bety3t": 2704
          }
        },
        {
          "id": "id_8ad48b5a96374cedaae2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL podporuje sledování oběhu dokumentů a spisů v analogové podobě prostřednictvím funkce předání a převzetí, s cílem zaznamenat jejich umístění, zpracovatele a datum předání, popřípadě převzetí.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_cc9f635c905e47d79bb0",
            "id_mkh21fijkx4bety3t": 2705
          }
        },
        {
          "id": "id_ebfbc2f30b8b48738be8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.7.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní uživateli zaznamenat do metadat pokyny pro schvalování a oběh dokumentu nebo spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_cc9f635c905e47d79bb0",
            "id_mkh21fijkx4bety3t": 2706
          }
        },
        {
          "id": "id_f158eb1f939d47008c93",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Jmenný rejstřík",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2800
          }
        },
        {
          "id": "id_3bf0601f2ab14db28f09",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL neumožní uživatelské roli ukončit příjem doručeného dokumentu bez vytvoření vazby mezi záznamem o osobě odesílatele ve jmenném rejstříku a dokumentem.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2801
          }
        },
        {
          "id": "id_6aab3c3584964ea3b933",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní v rámci odeslání dokumentu výběr adresáta ze jmenného rejstříku a automaticky zaznamená vazbu mezi záznamem o osobě adresáta ve jmenném rejstříku a dokumentem.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2802
          }
        },
        {
          "id": "id_9dabb8383bd14d18bc44",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL do okamžiku vyřazení dokumentu umožní uživatelské roli zaznamenání vazby mezi záznamem o jiné osobě ve jmenném rejstříku a dokumentem.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2803
          }
        },
        {
          "id": "id_8a1eab5ec6a746c98850",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL do okamžiku vyřazení spisu umožní uživatelské roli zaznamenání vazby mezi záznamem ve jmenném rejstříku a spisem.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2805
          }
        },
        {
          "id": "id_fd5d82a132394588838d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vyhledávat ve jmenném rejstříku záznamy o podnikajících fyzických osobách a o právnických osobách.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2806
          }
        },
        {
          "id": "id_8fc21d53ff034c02bb44",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vyhledávat ve jmenném rejstříku záznamy o fyzických osobách a výsledky vyhledávání omezí na záznamy, se kterými má uživatelská role oprávnění disponovat ➡",
            "id_mkh1re80717c6gqi7": "a) na základě nastavených oprávnění nebo\nb) existujících vazeb na dokumenty nebo spisy.",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2807
          }
        },
        {
          "id": "id_715d039a2d0f4ff8840e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli ztotožnit záznam ve jmenném rejstříku prostřednictvím zadání údajů potřebných pro jeho ztotožnění. Za údaje potřebné pro ztotožnění osoby se považují alespoň: ➡",
            "id_mkh1re80717c6gqi7": "a) jméno, příjmení, datum narození a adresa trvalého pobytu u fyzické osoby,\nb) jméno, příjmení, datum narození, adresa sídla a právní forma u fyzické osoby podnikající,\nc) obchodní firma nebo název nebo označení a právní forma u právnické osoby,\nd) identifikační číslo osoby u právnické osoby nebo fyzické osoby podnikající, e) identifikátor datové schránky.",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2808
          }
        },
        {
          "id": "id_f1200a1f2e5c41e4bbf1",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "V případě, že na základě údajů o osobě nelze k dokumentu nebo spisu přiřadit záznam ve jmenném rejstříku: ➡",
            "id_mkh1re80717c6gqi7": "a) jsou-li k dispozici údaje podle požadavku 2.8.8, eSSL umožní ztotožnění ve zdrojích dat o fyzických osobách podle požadavku 2.8.10 nebo o právnických osobách podle požadavku 2.8.11 a zaznamená údaje z použitého zdroje dat do záznamu jmenného rejstříku,\nb) nejsou-li k dispozici údaje podle požadavku 2.8.8 nebo se nepodaří osobu ztotožnit podle písm. a), eSSL umožní vytvoření nového záznamu ve jmenném rejstříku bez ztotožnění osoby a záznam označí jako neztotožněný.",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2809
          }
        },
        {
          "id": "id_5eb2f9718217467a9516",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje ověřování údajů o fyzických osobách alespoň v těchto zdrojích: ➡",
            "id_mkh1re80717c6gqi7": "a) registr obyvatel informačního systému základních registrů,\nb) informační systém datových schránek.",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2810
          }
        },
        {
          "id": "id_c18b2bad2d7f4891ac2e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje ověřování údajů o právnických osobách a fyzických osobách podnikajících alespoň v těchto zdrojích: ➡",
            "id_mkh1re80717c6gqi7": "a) registr osob informačního systému základních registrů,\nb) informační systém datových schránek.",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2811
          }
        },
        {
          "id": "id_76e0df794f5447bdb8b8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL je možné konfigurovat tak, že využívá notifikační služby informačního systému základních registrů pro automatickou aktualizaci údajů u záznamů jmenného rejstříku ztotožněných v informačním systému základních registrů.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2812
          }
        },
        {
          "id": "id_477dca0d62284556b7e2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při příjmu a odeslání dokumentu spojeného se záznamem ve jmenném rejstříku zajišťuje automatickou aktualizaci údajů u záznamů osob ztotožněných podle požadavků 2.8.10 a 2.8.11; s výjimkou případů, kdy eSSL využívá notifikační službu podle požadavku 2.8.12.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2813
          }
        },
        {
          "id": "id_29c7942c92a04fd4ac04",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automaticky identifikuje vícečetné záznamy ve jmenném rejstříku na základě shody položek podle požadavku 2.8.8 a o nalezeném stavu informuje uživatelskou roli oprávněnou ke správě jmenného rejstříku. ESSL umožní této uživatelské roli manuálně identifikovat vícečetné záznamy ve jmenném rejstříku.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2814
          }
        },
        {
          "id": "id_22c5851b72ba4e8ab849",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní správcovské roli nastavit lhůtu pro automatické vymazání údajů ➡",
            "id_mkh1re80717c6gqi7": "a) o fyzické osobě vedené ve jmenném rejstříku, která nemá vazbu na dokument nebo spis, a\nb) o právnické osobě vedené ve jmenném rejstříku, která nemá vazbu na dokument nebo spis.",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2815
          }
        },
        {
          "id": "id_4eb740429efb4e5c9abd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.16",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní správcovské roli manuální zničení údajů o osobě vedené ve jmenném rejstříku, která nemá vazbu na dokument nebo spis.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2816
          }
        },
        {
          "id": "id_38f041d4b352496e8850",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.17",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL provádí identifikaci záznamů ve jmenném rejstříku, které nemají vazbu na dokument nebo spis, a u těchto záznamů sleduje lhůtu pro jejich zničení podle požadavku 2.8.15. Pokud je k záznamu ve jmenném rejstříku nově připojena vazba na dokument nebo spis a u tohoto záznamu již plyne lhůta pro zničení, je plynutí této lhůty zrušeno.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2817
          }
        },
        {
          "id": "id_5f81089a32f143a3b6ea",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.18",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL provádí automaticky zničení záznamů ve jmenném rejstříku, kterým uplynula lhůta pro zničení podle požadavku 2.8.15 a které nemají vazbu na dokument nebo spis.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2818
          }
        },
        {
          "id": "id_71ad6bbb32af44d78362",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.19",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli nastavit specifické podmínky ochrany osobních údajů v podobě určení uživatelské role oprávněné ke čtení, zápisu, úpravě a správě jmenného rejstříku a rozsahu oprávnění této uživatelské role ve vztahu k vedení jmenného rejstříku.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2819
          }
        },
        {
          "id": "id_ff96b24a11e44a8382f4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.8.20",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vyhledávat, filtrovat a setřídit záznamy ve jmenném rejstříku.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f158eb1f939d47008c93",
            "id_mkh21fijkx4bety3t": 2820
          }
        },
        {
          "id": "id_8cf4e82fbfa846029212",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Samostatná## evidence dokumentů",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2900
          }
        },
        {
          "id": "id_9fcddb42282e4fdd91c7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Je-li samostatná evidence dokumentů napojena na eSSL, musí tak být realizováno rozhraním podle kapitoly 8.1, jehož prostřednictvím samostatná evidence dokumentů zajišťuje správu entit v eSSL, není-li jiný způsob napojení efektivnější.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2901
          }
        },
        {
          "id": "id_a85d4978030745568ba1",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů, která je napojena na eSSL, nemusí splňovat požadavky 2.9.3 až 2.9.16, pokud je zajišťuje prostřednictvím eSSL. Pokud samostatná evidence dokumentů využívá integraci na eSSL, musí taková samostatná evidence podporovat tvorbu spisů v souladu s požadavkem 2.9.9.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2902
          }
        },
        {
          "id": "id_843eb8a229ca49a4882e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Jestliže samostatná evidence dokumentů zajišťuje příjem dokumentů, musí splňovat alespoň požadavky 2.1.1 až 2.1.3 a požadavky kapitoly 2.6.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2903
          }
        },
        {
          "id": "id_cfbc2111f2f94025bac8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Jestliže samostatná evidence dokumentů zajišťuje příjem e-mailů, musí zajišťovat alespoň ➡",
            "id_mkh1re80717c6gqi7": "a) automatizované stahování a uložení e-mailových zpráv doručených na určené elektronické adresy,\nb) označení stažených e-mailových zpráv z určené elektronické adresy příznakem, že byly staženy,\nc) odesílání e-mailových zpráv prostřednictvím určené elektronické adresy,\nd) uchování e-mailové zprávy v původním formátu postupem podle požadavku 2.4.2 jako samostatné komponenty,\ne) uchování obsahu (těla) e-mailové zprávy jako samostatné komponenty a\nf) uchování jednotlivých připojených příloh jako samostatných komponent.",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2904
          }
        },
        {
          "id": "id_f5bbf51e4f3b41588144",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Jestliže samostatná evidence dokumentů zajišťuje příjem a odesílání dokumentů prostřednictvím informačního systému datových schránek, musí splňovat požadavky kapitoly 2.3.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2905
          }
        },
        {
          "id": "id_3b6c04045628460d84cc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů musí splňovat požadavky 2.4.1, 2.4.3, 2.4.4 a 2.5.1 až 2.5.5 týkající se datových formátů komponent.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2906
          }
        },
        {
          "id": "id_511dde29854043abb6d0",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů musí splňovat při evidenci dokumentu alespoň požadavky 2.7.1 a 2.7.5.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2907
          }
        },
        {
          "id": "id_80f8dc8cea074cfab712",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů zajišťuje, že dokumenty nebo spisy jsou vkládány do věcných skupin splňujících alespoň požadavky 3.1.1, 3.1.2, 3.1.8 až 3.1.12.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2908
          }
        },
        {
          "id": "id_4254c96730f04a3d9083",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "V případě, že samostatná evidence dokumentů spravuje spisy, musí splňovat alespoň požadavky 3.2.1, 3.2.2, 3.2.4 až 3.2.7.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2909
          }
        },
        {
          "id": "id_cd76948a461b4a34a23b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud samostatná evidence dokumentů spravuje typové spisy, musí splňovat požadavky kapitoly 3.3.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2910
          }
        },
        {
          "id": "id_e6d74116e6d841abb156",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů musí splňovat alespoň požadavky 3.4.1, 3.4.4 a 3.4.5 týkající se vazeb mezi entitami.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2911
          }
        },
        {
          "id": "id_6d1132a9d2b34f36817c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů zajišťuje vedení a ztvárnění transakčního protokolu podle požadavku 5.2.12 a kapitoly 7.4.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2912
          }
        },
        {
          "id": "id_ee537c77e35e4122bb80",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů musí splňovat požadavky 6.1.4, 6.1.6 písm. a) až d), 6.1.7, 6.1.10, 6.1.11 a 6.1.12 týkající se skartačního režimu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2913
          }
        },
        {
          "id": "id_e10d5be5a47a4592922e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů při skartačním řízení musí splňovat alespoň požadavky kapitoly 6.2 a požadavky 7.2.1 až 7.2.10. V případě požadavku 7.2.10 se pro samostatnou evidenci jedná o doporučený seznam metadat.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2914
          }
        },
        {
          "id": "id_bf1f168acbd34e95a7d0",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů v případě exportu, importu nebo přenosu dat musí splňovat alespoň požadavek 6.3.1.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2915
          }
        },
        {
          "id": "id_b41f0f71e2044085b532",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.9.16",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Samostatná evidence dokumentů musí splňovat požadavky kapitoly 2.8 týkající se jmenného rejstříku.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_8cf4e82fbfa846029212",
            "id_mkh21fijkx4bety3t": 2916
          }
        },
        {
          "id": "id_30316734f21e4c6d8f17",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "SPISOVÝ A SKARTAČNÍ PLÁN A ORGANIZACE SPISŮ",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 3000
          }
        },
        {
          "id": "id_f09b3d6ef8ef411abcd5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Věcné skupiny",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_30316734f21e4c6d8f17",
            "id_mkh21fijkx4bety3t": 3100
          }
        },
        {
          "id": "id_d501c93d3b8e45f39a5f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL spravuje věcné skupiny v souladu se spisovým a skartačním plánem původce. ESSL zajišťuje, že věcné skupiny jsou uspořádány hierarchicky, přičemž spisy a typové spisy smí být zatříděny pouze do věcných skupin na nejnižší úrovni hierarchie (neobsahují jiné věcné skupiny).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3101
          }
        },
        {
          "id": "id_4766cfabd5ed43b5993a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vede o věcné skupině alespoň tato metadata: ➡",
            "id_mkh1re80717c6gqi7": "a) jednoznačný identifikátor,\nb) spisový znak,\nc) obsah -- slovní popis,\nd) datum otevření,\ne) datum uzavření.\nO věcné skupině na nejnižší úrovni hierarchie eSSL dále vede alespoň tato metadata:\nf) odkaz na skartační režim,\ng) příznak, že věcná skupina je určena pro typové spisy,\nh) příznak, který stanoví způsob přidělování čísla jednacího dokumentům v zakládaných spisech dané věcné skupiny (požadavek 2.7.4) s výjimkou věcné skupiny určené pro typové spisy podle písm. g),\ni) příznak, že na obsah věcné skupiny je uplatněn trvalý skartační souhlas vydaný příslušným archivem a s vyznačením, zda má být realizován požadavek 3.2.9 písm. a).",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3102
          }
        },
        {
          "id": "id_daa4eacf3aa34012aa2b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli ➡",
            "id_mkh1re80717c6gqi7": "a) přidat nové věcné skupiny,\nb) uzavřít stávající věcné skupiny pro vkládání\nc) pro jednotlivé věcné skupiny samostatně stanovit datum otevření věcné skupiny.\nPrimární entitou je věcná skupina, spisový a skartační plán je časový řez aktuálně platných věcných skupin",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3104
          }
        },
        {
          "id": "id_9a9c0872705447179e79",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli upravit v metadatech obsah -- slovní popis stávající věcné skupiny, aniž by vznikla nová věcná skupina.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3105
          }
        },
        {
          "id": "id_1d57111ff0944f0eab21",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli v každé konkrétní věcné skupině spisového plánu nastavit možnost vytvářet typové spisy. ESSL zajistí, že v této věcné skupině nesmí být vložena jiná věcná skupina nebo spis.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3106
          }
        },
        {
          "id": "id_124ca2f038d44dbb8ddd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL spravuje spisové a skartační plány, které jsou souhrnem věcných skupin používaných v danou dobu. ESSL vede o spisovém a skartačním plánu alespoň tato metadata: ➡",
            "id_mkh1re80717c6gqi7": "a) jednoznačný identifikátor,\nb) název spisového a skartačního plánu,\nc) popis spisového a skartačního plánu,\nd) platnost od,\ne) platnost do,\nf) odkaz na věcné skupiny, které tvoří spisový a skartační plán.",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3107
          }
        },
        {
          "id": "id_bdb3a01bc2bf41b59b51",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vkládat spisy a typové spisy pouze do otevřených věcných skupin, tj. do aktuálně platného spisového a skartačního plánu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3108
          }
        },
        {
          "id": "id_9dd380716647474fac7d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje posuzovateli skartační operace hromadné přetřídění uzavřených spisů z věcné skupiny do jiné věcné skupiny; tyto věcné skupiny mohou být uzavřené nebo otevřené.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3109
          }
        },
        {
          "id": "id_641270d6308a471794cc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje, aby všechny spisové znaky byly jednoznačné v rámci konkrétního spisového a skartačního plánu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3111
          }
        },
        {
          "id": "id_ee5fc1a7a8634107ab3b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.1.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli v rámci výchozí konfigurace eSSL zajistit, že spisové znaky tvořené zřetězením jednoduchých spisových znaků budou odděleny právě jedním z následujících znaků: ➡",
            "id_mkh1re80717c6gqi7": "a) „.\" (tečka, ASCII kód 46),\nb) „--\" (pomlčka, ASCII kód 45),\nc) „/\" (lomítko, ASCII kód 47),\nd) „ \" (mezera, ASCII kód 32).",
            "id_mkh1ruycu0iq9beiq": "id_f09b3d6ef8ef411abcd5",
            "id_mkh21fijkx4bety3t": 3112
          }
        },
        {
          "id": "id_00e80ad736dd4304875f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Spisy",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_30316734f21e4c6d8f17",
            "id_mkh21fijkx4bety3t": 3200
          }
        },
        {
          "id": "id_7ad71897737f412b97ca",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že podle volby uživatelské role se nový spis otevře ➡",
            "id_mkh1re80717c6gqi7": "a) ve věcné skupině, nebo\nb) v dílu typového spisu zvolené součásti typového spisu.",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3201
          }
        },
        {
          "id": "id_f5491d49e7a34e74aaa2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při založení spisu automaticky přiřadí spisu jednoznačný identifikátor, spisovou značku, spisový znak a způsob přidělování čísla jednacího podle věcné skupiny nebo součásti typového spisu, ve které byl spis založen. ESSL automaticky zaznamená datum založení spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3202
          }
        },
        {
          "id": "id_5df647f13ca34fddae3e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při vložení dokumentu do spisu automaticky přiřadí dokumentu pořadové číslo ve spisu a číslo jednací podle požadavku 2.7.4.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3203
          }
        },
        {
          "id": "id_ba46fd3d68794aae89ec",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí založení spisu ➡",
            "id_mkh1re80717c6gqi7": "a) na základě dokumentu; v tom případě automaticky vyplní stručný obsah spisu podle stručného obsahu dokumentu a umožní jeho bezprostřední editaci, nebo\nb) bez dokumentu; v tom případě stručný obsah spisu vyplní uživatelská role.",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3204
          }
        },
        {
          "id": "id_f6a0399cb85a482782d5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na základě volby uživatelské role zajistí vložení dokumentu do založeného spisu podle přístupových práv uživatelské role.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3205
          }
        },
        {
          "id": "id_4eb356c7692948d38b33",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na základě volby uživatelské role vyřídí spis a datum vyřízení zaznamená do metadat. Vyřízením spisu jsou současně vyřízeny všechny dokumenty v něm, které již dříve nebyly vyřízeny samostatně podle požadavku 3.2.7.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3206
          }
        },
        {
          "id": "id_e0ed970b4ece448db3d6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní uživatelské roli označit jednotlivé dokumenty ve spisu jako vyřízené. Tím není dotčen požadavek 3.2.6.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3207
          }
        },
        {
          "id": "id_813261d28f194685b732",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na základě konfigurace umožní vyznačení vyřízení spisu jeho uzavřením.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3208
          }
        },
        {
          "id": "id_23f8d3288ee04489aac3",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na základě volby uživatelské role uzavře spis. Přitom provede kontrolu ➡",
            "id_mkh1re80717c6gqi7": "a) datových formátů komponent, které popřípadě převede do výstupních datových formátů,\nb) metadat zapisovaných uživatelskou rolí, která jsou nezbytná pro vytvoření SIP balíčku podle přílohy č. 2, přičemž uživatelskou roli případně vyzve k jejich doplnění.",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3209
          }
        },
        {
          "id": "id_a26872d7a4734fdd91a8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že pokud je věcná skupina nebo součást typového spisu, ve kterém se spis v okamžiku svého uzavření nachází, označena příznakem podle požadavku 3.1.2 písm. i), resp. 3.3.6 písm. d), pak neprovede kontrolu a související činnosti ➡",
            "id_mkh1re80717c6gqi7": "a) podle požadavku 3.2.9, nebo\nb) podle požadavku 3.2.9 písm. b).\nV případě delších skartačních lhůt je vhodné i v případě uděleného skartačního souhlasu provést kontrolu a případně převod všech komponent do výstupního formátu, aby původce byl schopen po dobu trvání lhůty realizovat potřeby spojené s ukládaným dokumentem podle požadavku 3.2.10 písm. a).",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3210
          }
        },
        {
          "id": "id_911da3f62e614cc89e8c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na základě volby uživatelské role uzavřený spis otevře. Uzavřený spis vytvořený nebo vložený do dílu typového spisu, který je již uzavřen, se při otevření automaticky přetřídí do otevřeného dílu typového spisu v příslušné součásti.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3211
          }
        },
        {
          "id": "id_4f61fc03cf694c8b9c7b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Jestliže je znovuotevíraný spis v uzavřené věcné skupině eSSL vyzve uživatelskou roli, aby spis přetřídila do otevřené věcné skupiny.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3212
          }
        },
        {
          "id": "id_ca1a9a9f618a4ecb8e64",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Jestliže je znovuotevíraný spis v uzavřeném typovém spisu nebo v uzavřené součásti typového spisu, eSSL provede znovuotevření uzavřeného typového spisu nebo uzavřené součásti typového spisu a otevře spis v nově otevřeném dílu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3213
          }
        },
        {
          "id": "id_e15678ce818f468d8bde",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.2.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Při změně spisového a skartačního plánu, v jejímž rámci dojde k uzavření věcné skupiny, ve které jsou zatříděny spisy, eSSL vyzve správcovskou roli k přetřídění otevřených spisů z uzavírané do otevřené věcné skupiny. Na základě volby správcovské role eSSL hromadně přetřídí označené spisy.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_00e80ad736dd4304875f",
            "id_mkh21fijkx4bety3t": 3214
          }
        },
        {
          "id": "id_20acbb769aef4e06a851",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Typové spisy, součásti typového spisu a díly typového spisu",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_30316734f21e4c6d8f17",
            "id_mkh21fijkx4bety3t": 3300
          }
        },
        {
          "id": "id_a718200a3e0b4c288db8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli zakládat typové spisy. ESSL umožňuje zakládat typové spisy pouze v otevřené věcné skupině k tomu určené.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3301
          }
        },
        {
          "id": "id_01fcf268087947478c4b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při založení nového typového spisu v dané věcné skupině automaticky otevře součásti a díly typového spisu podle šablony typového spisu definované pro tuto věcnou skupinu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3302
          }
        },
        {
          "id": "id_3c4cfc983e974ccf9776",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje, že ➡",
            "id_mkh1re80717c6gqi7": "a) šablona typového spisu obsahuje alespoň jednu součást typového spisu,\nb) součást typového spisu obsahuje alespoň jednu součást typového spisu nebo alespoň jeden díl typového spisu; žádná součást typového spisu nemůže obsahovat jinou součást typového spisu a současně díl typového spisu,\nc) pokud otevřená součást typového spisu neobsahuje jinou součást typového spisu, pak obsahuje právě jeden otevřený díl typového spisu,\nd) díly typového spisu v různých součástech typového spisu jsou na sobě nezávislé.",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3303
          }
        },
        {
          "id": "id_6b6e9c42a50c4a7281c7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při uzavření věcné skupiny s otevřenými typovými spisy zajistí, že správcovská role ➡",
            "id_mkh1re80717c6gqi7": "a) stanoví věcnou skupinu pro typové spisy, do které mají být otevřené typové spisy přetříděny a vytvoří pro ni šablonu typového spisu se shodnou strukturou, jakou měla šablona typového spisu původní věcné skupiny,\nb) namapuje šablonu původní věcné skupiny a nové věcné skupiny,\nc) má možnost přidat do vytvořené šablony typového spisu nové věcné skupiny další součásti typového spisu, které se nemapují podle písm. b), přičemž do těchto nových součástí typového spisu nebudou přetřiďovány žádné entity.\nESSL zajistí hromadné přetřídění otevřených typových spisů do nové věcné skupiny pro typové spisy podle namapování šablon k datu platnosti nového spisového a skartačního plánu, přičemž u přetřiďovaných typových spisů:\n1) přetřídí díly typových spisů výhradně do těch součástí typových spisů, které byly namapovány podle písm. b),\n2) nezmění skartační režimy již uzavřených dílů typových spisů,\n3) uplatní dědičnost skartačního režimu z nové součásti typového spisu na otevřené spisy v otevřených dílech typových spisů,\n4) v otevřených dílech typových spisů nezmění skartační režimy uzavřených spisů, které budou následně podléhat při uzavření dílu typového spisu případnému řešení konfliktu skartačních režimů podle požadavku 6.1.8 písm. b),\n5) automaticky otevře prázdný díl typového spisu pro každou novou součást typového spisu na nejnižší úrovni hierarchie, která nebyla zahrnuta v šabloně původní věcné skupiny.",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3304
          }
        },
        {
          "id": "id_423844d747b64946ab60",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že v rámci vytváření věcné skupiny obsahující typové spisy správcovská role definuje pro tuto věcnou skupinu šablonu typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3305
          }
        },
        {
          "id": "id_b10d5fb6ee5f43a0bda0",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL musí pro určitou věcnou skupinu umožnit správcovské roli vytvoření šablony typového spisu. Každá součást typového spisu v šabloně typového spisu: ➡",
            "id_mkh1re80717c6gqi7": "a) je označena spisovým znakem, který vzniká doplněním zděděného spisového znaku věcné skupiny typového spisu, ve které jsou typové spisy vytvářeny, nebo doplněním zděděného spisového znaku součásti typového spisu, do které je daná součást typového spisu vložena, o jednoduchý spisový znak součásti typového spisu,\nb) má přidělený skartační režim, pokud do ní není vložena jiná součást typového spisu,\nc) má nastavený způsob přidělování čísla jednacího v zakládaných spisech dané součásti typového spisu (požadavek 2.7.4),\nd) příznak, že je na obsah součásti typového spisu uplatněn trvalý skartační souhlas vydaný příslušným archivem a s vyznačením, zda má být realizován požadavek 3.2.9 písm. a).\nNapříklad požadavky na typové spisy týkající se organizací zřizovaných původcem mohou zahrnovat následující součásti: Statutární dokumenty a jejich příprava, Podklady statutárních orgánů a jejich vedení, Vnitřní předpisy, Zápisy vedení zasílané na vědomí, Zprávy a hlášení, Výroční zprávy, Rozbory hospodaření, Audity, Příprava rozpočtu, Zaměstnanecké záležitosti, Investice, Provoz, Členství v mezinárodních organizacích a Ostatní.\nKaždý nový typový spis vytvořený v této věcné skupině je poté automaticky vytvořen s těmito součástmi podle šablony, kterou připraví správcovská role. Spisový znak a skartační režim jsou přidělovány v šabloně například následovně:\n01.2 Věcná skupina původce pro dané typové spisy\nTypový spis zřizované organizace A (vytvořený podle šablony součástí typového spisu)\n01.2.1 Statutární dokumenty a jejich příprava A 10\n01.2.2 Podklady statutárních orgánů a jejich vedení A 10\n01.2.3 Vnitřní předpisy A 5\n01.2.4 Zápisy vedení zasílané na vědomí S 5\n01.2.5 Zprávy a hlášení\n01.2.5.1 Výroční zprávy A 10\n01.2.5.2 Rozbory hospodaření A 10\n01.2.5.3 Audity A 5\n01.2.6 Příprava rozpočtu S 5\n01.2.7 Zaměstnanecké záležitosti A 5\n01.2.8 Investice A 5\n01.2.9 Provoz S 5\n01.2.10 Členství v mezinárodních organizacích A 5 01.2.11 Ostatní S 5",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3306
          }
        },
        {
          "id": "id_defda3a854134fff9c53",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že v případě změny šablony typového spisu bude pro tvorbu nových typových spisů uzavřena stávající věcná skupina a zároveň bude otevřena nová věcná skupina pro tvorbu typových spisů založených na změněné šabloně. ESSL zajistí přetřídění otevřených typových spisů z uzavírané věcné skupiny postupem podle požadavku 3.3.4.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3307
          }
        },
        {
          "id": "id_9784ada20ad3470387fa",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Aniž by se měnila příslušná šablona typového spisu, eSSL umožňuje správcovské roli v šabloně typového spisu pro konkrétní věcnou skupinu upravit ➡",
            "id_mkh1re80717c6gqi7": "a) názvy součástí typového spisu,\nb) určené časové období dílu pro každou součást typového spisu, pokud do ní není vložena jiná součást typového spisu.",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3308
          }
        },
        {
          "id": "id_87c9294d9dda42439b17",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje nastavit určené časové období dílu typového spisu pro konkrétní součást typového spisu v šabloně typového spisu stanovením doby, po kterou má být díl otevřen.",
            "id_mkh1re80717c6gqi7": "Například: 5 let, školní rok, kalendářní rok.",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3309
          }
        },
        {
          "id": "id_1ec4219616a4461b9fed",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje zakládat spisy a vkládat spisy do otevřených dílů typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3310
          }
        },
        {
          "id": "id_f98ca2dcebc342b792aa",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli uzavření typového spisu a součásti typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3312
          }
        },
        {
          "id": "id_6b6da4de68d24fda9193",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL neumožní uzavření typového spisu nebo součásti typového spisu, pokud obsahuje díl typového spisu s neuzavřeným spisem.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3313
          }
        },
        {
          "id": "id_776794777ff34e5fa186",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automaticky uzavře díl typového spisu po uplynutí určeného časového období. ESSL při uzavření dílu typového spisu zajistí v příslušné součásti typového spisu automatické otevření nového dílu typového spisu. Pokud je díl typového spisu v okamžiku uzavírání prázdný, ESSL zajistí automatické zničení uzavíraného dílu typového spisu s výjimkou hlavičky metadat.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3314
          }
        },
        {
          "id": "id_3bbc7759614647c6910e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL kontroluje, zda jsou v případě uzavření dílu typového spisu uzavřeny i všechny v něm vytvořené nebo do něj vložené spisy. Jestliže tyto spisy uzavřeny nejsou, eSSL automaticky vyjme spis z uzavíraného dílu a vloží jej do nově otevřeného dílu v příslušné (otevřené) součásti.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3315
          }
        },
        {
          "id": "id_3e23754990e744b381bf",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.16",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zabraňuje uživatelské roli zakládat spisy v uzavřeném dílu typového spisu nebo vkládat spisy do uzavřeného dílu typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3316
          }
        },
        {
          "id": "id_c55c738f28944a7f8e34",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.17",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL neumožní přiřazení skartačního režimu typovému spisu; typový spis nemá skartační režim.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3317
          }
        },
        {
          "id": "id_ea50403610e1407ba065",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.18",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že součást typového spisu, do které je v šabloně typového spisu ➡",
            "id_mkh1re80717c6gqi7": "a) vložen díl typového spisu, má v daný okamžik právě jeden skartační režim,\nb) vložena jiná součást typového spisu, nemá skartační režim.",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3318
          }
        },
        {
          "id": "id_c1c2456dc20943a28214",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.19",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL v okamžiku otevření dílu typového spisu přiřadí dílu typového spisu skartační režim nadřazené součásti typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3319
          }
        },
        {
          "id": "id_07aa45fabdaa4d44bef0",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.3.20",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při práci s typovými spisy zobrazuje uživatelské roli entity vytvořené nebo vložené v dílech typového spisu jako entity součásti typového spisu, tj. potlačuje zobrazování dílů typového spisu. Informace o dílu typového spisu a jeho obsahu eSSL zobrazí na základě volby uživatelské role, přičemž ➡",
            "id_mkh1re80717c6gqi7": "a) ztvárnit základní metadata dílu typového spisu za účelem vytištění obalu analogových částí podle požadavku 5.2.5 a ztvárnit seznam spisů v dílu typového spisu,\nb) doplnit fyzické umístění analogových částí dílu typového spisu,\nPři běžné práci, pokud například uživatelská role vkládá spisy do dílu typového spisu, eSSL uživatelské roli znázorní pouze příslušnou součást typového spisu. Uživatelská role nesmí být nucena vyhledávat v rámci součásti typového spisu díl typového spisu.",
            "id_mkh1ruycu0iq9beiq": "id_20acbb769aef4e06a851",
            "id_mkh21fijkx4bety3t": 3320
          }
        },
        {
          "id": "id_ad14fc344b734d03b35f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Udržování vazeb mezi entitami",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_30316734f21e4c6d8f17",
            "id_mkh21fijkx4bety3t": 3400
          }
        },
        {
          "id": "id_6b33c06f98724fdcbcd4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že entity typový spis, součást typového spisu, díl typového spisu, spis nebo dokument budou otevřeny, založeny, vloženy nebo zatříděny právě do jedné nadřazené entity. U věcné skupiny hierarchicky podřízené jiné věcné skupině toto platí obdobně.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3401
          }
        },
        {
          "id": "id_02b532cd61664c3db155",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL nedovolí uzavření entity, pokud nejsou uzavřeny všechny jí podřízené entity. ESSL před uzavřením dílu typového spisu všechny v něm otevřené spisy přetřídí do nově otvíraného dílu typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3402
          }
        },
        {
          "id": "id_9767c67cce3a4a379bdd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli hromadně přetřídit (přemístit) veškerý obsah celé věcné skupiny nebo jeho vyznačenou část do jiné věcné skupiny v rámci spisového plánu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3403
          }
        },
        {
          "id": "id_007e878967fb4b67ac7d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje označení spisů nebo typových spisů přetříděných do jiných věcných skupin novými spisovými znaky. Pro označení součástí typového spisu spisovými znaky platí první věta obdobně.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3404
          }
        },
        {
          "id": "id_d21cbb5b30cd4d2c8960",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní roli při přetřiďování spisů rozhodnout, zda budou přetříděny i uzavřené spisy.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3405
          }
        },
        {
          "id": "id_af1a6fa0c8a74167be30",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že do uzavřené entity není možné vkládat ani z ní vyjímat jiné entity. ➡",
            "id_mkh1re80717c6gqi7": "Výjimkou pro vyjmutí je\na) uzavřená věcná skupina nebo uzavřený díl typového spisu, ze kterých je vyjímán spis za účelem jeho znovuotevření v aktuálně otevřené věcné skupině nebo otevřeném dílu typového spisu,\nb) přetřídění uzavřených spisů podle požadavku 3.1.9.\nPokud se vyjmutím spisu podle písm. a) uzavřený díl typového spisu vyprázdní, eSSL zajistí automatické zničení tohoto dílu typového spisu s výjimkou hlavičky metadat.",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3406
          }
        },
        {
          "id": "id_0f1ebda34885414db1d5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je dokument zařazený ve spisu přetříděn do jiného spisu, ve kterém je číslo jednací tvořeno na základě ➡",
            "id_mkh1re80717c6gqi7": "a) spisové značky a pořadí dokumentu ve spisu, eSSL přidělí dokumentu nové číslo jednací,\nb) přiřazeného pořadového čísla v rámci předem určeného časového období podle požadavku 2.7.2, eSSL přidělí dokumentu nové číslo jednací v případě, že původní číslo jednací bylo přiděleno na základě spisové značky a pořadí dokumentu ve spisu.",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3407
          }
        },
        {
          "id": "id_c22ad45f986b4e3aa430",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že po přetřídění podle požadavku 3.4.7 budou požadavek 5.1.8 písm. b) a požadavek 5.2.6 písm. b) realizovány s novým i původním číslem jednacím.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3408
          }
        },
        {
          "id": "id_b78ef57640f242ca8437",
          "values": {
            "id_mkh1pocm7xx7x2o65": "3.4.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že pokud je přetřiďován spis do jiné věcné skupiny nebo součásti typového spisu, nezmění se způsob přidělování čísla jednacího dokumentům, který byl nastaven při jeho založení (požadavky 2.7.2, 3.1.2 a 3.3.6).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ad14fc344b734d03b35f",
            "id_mkh21fijkx4bety3t": 3409
          }
        },
        {
          "id": "id_787e48d99e914efdbcd1",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "ODKAZOVÁNÍ MEZI ENTITAMI",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 4000
          }
        },
        {
          "id": "id_ea09390927334e37820e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Křížové odkazy",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_787e48d99e914efdbcd1",
            "id_mkh21fijkx4bety3t": 4100
          }
        },
        {
          "id": "id_affb5a81362f40cc8234",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vytvořit volný křížový odkaz mezi ➡",
            "id_mkh1re80717c6gqi7": "a) spisy,\nb) dokumenty,\nc) spisy a dokumenty.",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4101
          }
        },
        {
          "id": "id_e09dd663a7984907ab3c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli vytvořit pevný křížový odkaz v případě připojení spisu k jinému spisu, přičemž nezáleží, zda je některý ze spisů uzavřený nebo otevřený. Nejvýše jeden ze spisů propojených pevným křížovým odkazem může být otevřený. Uzavřený spis může být propojen pevným křížovým odkazem pouze v případě, že má vyřešené případné konflikty skartačních režimů podle požadavku 6.1.8 písm. a).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4102
          }
        },
        {
          "id": "id_6db06e83945a48eea25f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL nedovolí vytvářet pevné křížové odkazy na spisy založené v dílu typového spisu nebo vložené do dílu typového spisu. Jestliže je do dílu typového spisu vkládán spis obsahující pevný křížový odkaz na jiný spis, eSSL vloží do dílu typového spisu oba spisy, přičemž zároveň odstraní pevný křížový odkaz mezi vkládanými spisy.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4103
          }
        },
        {
          "id": "id_02c6ee4889204c72ab62",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL nejpozději při uzavření spisu obsahujícího pevný křížový odkaz, nebo v okamžiku propojení dvou uzavřených spisů pevným křížovým odkazem, přetřídí podle konfigurace eSSL (požadavek 4.1.5) jeden ze spisů do věcné skupiny ke druhému spisu. Zároveň eSSL provede kontrolu konfliktu skartačních režimů propojených spisů podle požadavku 6.1.8. Výsledný skartační režim stanovený podle požadavku 6.1.8 odst. 1) eSSL přiřadí všem spisům, které jsou propojeny pevným křížovým odkazem.",
            "id_mkh1re80717c6gqi7": "Jestliže je alespoň jeden ze spisů propojených pevným křížovým odkazem vkládán do dílu typového spisu, eSSL všechny propojené spisy přetřídí do dílu typového spisu a automaticky odstraní pevné křížové odkazy.",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4104
          }
        },
        {
          "id": "id_9db790ca1b1f48c6a4f4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL je možné konfigurovat tak, že v případě spisů, mezi nimiž je vytvořen pevný křížový odkaz, a jsou zatříděny v různých věcných skupinách, automaticky při provádění požadavku 4.1.4 všechny tyto spisy přetřídí do věcné skupiny, ve které je zatříděn ➡",
            "id_mkh1re80717c6gqi7": "a) nejdříve založený spis, nebo\nb) nejpozději založený spis.",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4105
          }
        },
        {
          "id": "id_30bc2a16d3c9494781fc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL povolí odstranění pevného křížového odkazu pouze zpracovateli. ESSL zajistí zadání důvodu odstranění pevného křížového odkazu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4106
          }
        },
        {
          "id": "id_2fe3a8948a4542deae7d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli hromadně zjistit informace o metadatech alespoň v rozsahu hlavičky metadat entit spojených křížovým odkazem. ESSL umožní tyto entity na základě uživatelských práv znázornit.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ea09390927334e37820e",
            "id_mkh21fijkx4bety3t": 4107
          }
        },
        {
          "id": "id_f78a252c50c940358c9b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Druhy dokumentů",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_787e48d99e914efdbcd1",
            "id_mkh21fijkx4bety3t": 4200
          }
        },
        {
          "id": "id_d3a6809dbd074703aec5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL udržuje číselník druhů dokumentů. ESSL omezuje definování a udržování číselníku druhů dokumentů výlučně na správcovskou roli.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f78a252c50c940358c9b",
            "id_mkh21fijkx4bety3t": 4201
          }
        },
        {
          "id": "id_f3134e44423248e48ab4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že dokument má přiřazen nejvýše jeden druh dokumentu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f78a252c50c940358c9b",
            "id_mkh21fijkx4bety3t": 4202
          }
        },
        {
          "id": "id_c4cb12cb8d3a4eaa9912",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje konfigurovat specifické prvky metadat pro druhy dokumentů.",
            "id_mkh1re80717c6gqi7": "Například faktury se odlišují použitím metadat čísel účtů.",
            "id_mkh1ruycu0iq9beiq": "id_f78a252c50c940358c9b",
            "id_mkh21fijkx4bety3t": 4203
          }
        },
        {
          "id": "id_1ad140753726415aa8c6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "4.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní přiřadit novému druhu dokumentu skartační režim, který je pro daný druh dokumentu nadále neměnný.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f78a252c50c940358c9b",
            "id_mkh21fijkx4bety3t": 4204
          }
        },
        {
          "id": "id_33d15c9bb249472bbe55",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "VYHLEDÁVÁNÍ, VÝBĚR, ZNÁZORNĚNÍ A ZTVÁRNĚNÍ",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 5000
          }
        },
        {
          "id": "id_ba8ef7432f594afc9b89",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Vyhledávání a výběr",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_33d15c9bb249472bbe55",
            "id_mkh21fijkx4bety3t": 5100
          }
        },
        {
          "id": "id_0548850e78a449c983ca",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při vyhledávání poskytne uživatelské roli pouze informace (metadata nebo obsah komponent), ke kterým má tato uživatelská role oprávněný přístup.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5101
          }
        },
        {
          "id": "id_c9250a4a21a5415d804f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud uživatel požaduje přístup k entitám, ke kterým nemá přístupová práva, a jejich vyhledávání nebo přístup požaduje provést jiným způsobem, než je uvedeno v požadavku 5.1.1, eSSL ➡",
            "id_mkh1re80717c6gqi7": "a) neposkytne žádné informace o entitě (uživateli není poskytnuta informace, zda entita existuje, nebo nikoliv),\nb) potvrdí existenci entity (znázorní identifikaci spisu, typového spisu, součásti typového spisu nebo dokumentu), popřípadě uvede zpracovatele entity, neznázorní však název entity ani jiná metadata,\nc) znázorní pouze název, druh entity (například u věcné skupiny a dokumentu), datum vytvoření a zpracovatele, nebo\nd) znázorní název a další metadata entity.\nJiným způsobem vyžádání přístupu, než je uveden v požadavku 5.1.1, se myslí zejména pokus o přístup k entitě na základě reference v systému (zahrnutí entity v seznamu nebo výpisu, funkčním dialogu apod.), přímého zadání odkazu na entitu nebo zobrazení entitu zahrnující apod. Rozsah zobrazených informací podle jednotlivých písmen požadavku je řízen kombinací oprávnění uživatele a způsobu vyžádání přístupu k entitám.",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5102
          }
        },
        {
          "id": "id_101af72df12d4b0eb532",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli podle přístupových oprávnění vyhledat a vybrat ➡",
            "id_mkh1re80717c6gqi7": "a) dokumenty,\nb) jakoukoli úroveň věcné skupiny, spisu, typového spisu a součásti typového spisu a jejich příslušná metadata.",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5103
          }
        },
        {
          "id": "id_23d5445f9f0749b99d22",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL poskytuje vyhledávací funkci, která umožňuje v jakékoli vzájemné kombinaci spojit vyhledávací podmínky za použití booleovských operátorů ➡",
            "id_mkh1re80717c6gqi7": "a) A („AND\"),\nb) NEBO („OR\"),\nc) NE („NOT\").",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5104
          }
        },
        {
          "id": "id_08a02f2625f84b3b88aa",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli podle přístupových oprávnění vyhledávat v metadatech a ve strojově čitelné textové vrstvě komponent podle numerického, alfanumerického nebo textového řetězce. Výsledkem vyhledávání ve strojově čitelné textové vrstvě komponent je příslušná komponenta.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5105
          }
        },
        {
          "id": "id_5cb2e0c4e8024089b40c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli omezit rozsah vyhledávání na ty věcné skupiny, spisy, typové spisy, součásti typového spisu, které role určila.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5106
          }
        },
        {
          "id": "id_46b021aeb7ec4c5bb4e4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli stanovit časové intervaly pro vyhledávání, například formou rozsahu nebo počtu dnů.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5107
          }
        },
        {
          "id": "id_04f0254bf0814f41bed6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje vyhledávání a řazení výsledků vyhledávání alespoň podle ➡",
            "id_mkh1re80717c6gqi7": "a) identifikace typového spisu nebo součásti typového spisu,\nb) čísla jednacího nebo části čísla jednacího dokumentu,\nc) spisové značky nebo části spisové značky spisu,\nd) jednoznačného identifikátoru,\ne) zpracovatelů,\nf) data odeslání,\ng) data doručení nebo v případě vlastních dokumentů data zaevidování,\nh) označení a identifikace dokumentu provedených odesílatelem,\ni) názvu (věci) věcné skupiny, dokumentu, spisu, typového spisu nebo součásti typového spisu,\nj) spisového znaku,\nk) skartačního režimu,\nl) způsobu odeslání,\nm) způsobu doručení.",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5108
          }
        },
        {
          "id": "id_08e8a102a7074352bbb4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli vyhledávat v transakčním protokolu specifické operace, entity, uživatele, role, časové údaje nebo časové intervaly.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5109
          }
        },
        {
          "id": "id_2de54f5656534fc8ab45",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.1.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je vyhledán znepřístupněný dokument, eSSL informuje uživatelskou roli podle přístupových oprávnění o existenci původního dokumentu, případně dokument uživatelské roli zpřístupní na základě zvláštního oprávnění.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ba8ef7432f594afc9b89",
            "id_mkh21fijkx4bety3t": 5110
          }
        },
        {
          "id": "id_5f2bf2598df04241a5e8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Znázornění a ztvárnění",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_33d15c9bb249472bbe55",
            "id_mkh21fijkx4bety3t": 5200
          }
        },
        {
          "id": "id_fe42b70b76e74650b083",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL uživatelské roli pracující s věcnou skupinou, spisem, typovým spisem, součástí typového spisu nebo dokumentem znázorní informace o ➡",
            "id_mkh1re80717c6gqi7": "a) všech hierarchicky nadřazených entitách a\nb) všech entitách připojených křížovým odkazem.",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5201
          }
        },
        {
          "id": "id_d17d3e4a001e46b4bc1e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zpřístupňuje uživatelské roli obsah věcných skupin, spisů, typových spisů, součástí typových spisů nebo dílů typových spisů k prohlížení bez rozlišování mezi uzavřenými a otevřenými věcnými skupinami, spisy, typovými spisy, součástmi typového spisu nebo díly typového spisu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5202
          }
        },
        {
          "id": "id_b49e7420eba440b695eb",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí uživatelské roli ztvárnění metadat dokumentu, spisu, součásti typového spisu a typového spisu vedených v eSSL.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5203
          }
        },
        {
          "id": "id_2503a05c12884535b32c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli zobrazit na obrazovce u každého přijatého dokumentu jeho metadata.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5204
          }
        },
        {
          "id": "id_ca646c41a85e4b4c8b22",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí uživatelské roli ztvárnění základních metadat za účelem vytištění obalu analogových částí spisu a dílu typového spisu. Základními metadaty pro ztvárnění jsou alespoň ➡",
            "id_mkh1re80717c6gqi7": "a) spisová značka spisu nebo název typového spisu,\nb) název součásti typového spisu,\nc) stručný obsah (předmět, věc) spisu,\nd) datum založení/uzavření spisu nebo dílu typového spisu,\ne) jednoznačný identifikátor spisu nebo dílu typového spisu včetně vyjádření ve strojově čitelném kódu,\nf) spisový znak,\ng) skartační režim.",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5205
          }
        },
        {
          "id": "id_f8036c0e297e4d74bd3d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL znázorní uživatelské roli alespoň tato metadata: ➡",
            "id_mkh1re80717c6gqi7": "a) jednoznačný identifikátor,\nb) číslo jednací dokumentu (požadavek 2.7.4),\nc) spisový znak,\nd) část transakčního protokolu zachycující historii entity, zejména oběh,\ne) spisovou značku spisu,\nf) název typového spisu a součásti typového spisu,\ng) datum uzavření věcné skupiny, spisu, typového spisu, součásti typového spisu a dílu typového spisu,\nh) skartační režim,\ni) křížové odkazy na jiné entity,\nj) informaci o umístění analogové části spisu,\nk) podobu dokumentu (analogová, nebo digitální); jestliže je alespoň jedna z částí dokumentu analogová, podoba celého dokumentu se považuje za analogovou.",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5206
          }
        },
        {
          "id": "id_0969d377bad74177983e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL roli podle přístupových oprávnění dále znázorní a umožní ztvárnění za účelem vytištění alespoň ➡",
            "id_mkh1re80717c6gqi7": "a) pevný křížový odkaz vzájemně identifikující spojené spisy,\nb) u typového spisu seznam všech spisů zařazených do dílů jednotlivých součástí typového spisu v členění po dílech pro jednotlivá určená časová období,\nc) seznam všech dokumentů ve spisu, jejich jednoznačné identifikátory a čísla jednací.",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5207
          }
        },
        {
          "id": "id_015513edabcf4f87be1e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL pro hromadný tisk zajistí uživatelské roli znázornění údajů stanovených v požadavcích 5.2.3 až 5.2.7.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5208
          }
        },
        {
          "id": "id_283d6846d1ce4be6aa08",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí uživatelské roli znázornění seznamu všech spisů nebo typových spisů včetně zatřídění do věcné skupiny.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5209
          }
        },
        {
          "id": "id_e42be5855a3845d98aee",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí správcovské roli ztvárnění spisového plánu za účelem jeho vytištění.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5210
          }
        },
        {
          "id": "id_8f48437070d44dc9a3ca",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí ztvárnění vyhledaných informací podle kapitoly 5.1 nebo znázorněných podle kapitoly 5.2 do komponenty ve výstupním datovém formátu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5211
          }
        },
        {
          "id": "id_b513067f091c47fe81e8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL obsah transakčního protokolu za stanovený časový úsek, nejdéle však jeden den, automaticky na konci tohoto časového úseku uloží jako dokument s komponentou v datovém formátu PDF/A nebo XML podle přílohy č. 6, který opatří elektronickou pečetí a elektronickým časovým razítkem podle standardu PAdES nebo XAdES-T.",
            "id_mkh1re80717c6gqi7": "Podepisovanou oblastí XML bude vždy kořenový element, kterým je TransakcniLogSystemu. Tato podepisovaná data budou zapouzdřena v elementu Signature/Object. Syntaxe podpisu bude Enveloping. ESSL automaticky dokument zatřídí do spisu.",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5212
          }
        },
        {
          "id": "id_8cc94081ee8446c0b76e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí uživatelské roli hromadné ztvárnění metadat jednoho nebo více spisů. Ztvárněný spis obsahuje metadata spisu, metadata vložených dokumentů a metadata komponent alespoň v rozsahu: ➡",
            "id_mkh1re80717c6gqi7": "a) název původce,\nb) spisový znak,\nc) skartační režim spisu,\nd) spisová značka,\ne) číslo jednací, nebo evidenční číslo ze samostatné evidence dokumentů,\nf) předmět (věc),\ng) zpracovatel,\nh) podepisující komponenty,\ni) soupis spisů připojených pevným křížovým odkazem,\nj) soupis spisů připojených volným křížovým odkazem,\nk) uživatelské poznámky spisu se jménem uživatele a datem,\nl) příslušné části transakčního protokolu,\nm) soupis dokumentů ve spisu.\nSamostatné komponenty se řadí následujícím způsobem\n1) komponenta obsahující údaje podle písm. a) až k),\n2) komponenta obsahující příslušnou část transakčního protokolu (písm. l) ztvárněného v PDF/A, který opatří elektronickou pečetí a elektronickým časovým razítkem podle standardu PAdES,\n3) komponenta obsahující soupis dokumentů vložených ve spisu (písm. m), 4) jednotlivé dokumenty a jejich komponenty.\nNapříklad dokumenty se označí třímístným pořadovým číslem počínaje „001\" a každá jejich komponenta se (ve správném pořadí) označí dvoumístným pořadovým číslem komponenty za pomlčkou (například „001--02\").",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5213
          }
        },
        {
          "id": "id_aca844b283084fcda892",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí správcovské roli ztvárnění konfiguračních parametrů za účelem jejich vytištění.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5214
          }
        },
        {
          "id": "id_9b41dcc54e534ee3b598",
          "values": {
            "id_mkh1pocm7xx7x2o65": "5.2.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli vytvářet seznamy uživatelských rolí a jednotlivých uživatelů pro kontrolu jejich přístupu ke konkrétním entitám a seznamy entit pro kontrolu přístupových práv uživatelů k nim.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5f2bf2598df04241a5e8",
            "id_mkh21fijkx4bety3t": 5215
          }
        },
        {
          "id": "id_ef361b413ba547a0a2fe",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "UKLÁDÁNÍ A VYŘAZOVÁNÍ DOKUMENTŮ",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 6000
          }
        },
        {
          "id": "id_e86ea49d781c4e2d8af2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Skartační režimy",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ef361b413ba547a0a2fe",
            "id_mkh21fijkx4bety3t": 6100
          }
        },
        {
          "id": "id_dbada8f9db694861b4d5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje výlučně správcovským rolím vytvářet a upravovat skartační režim a přiřazovat jej ➡",
            "id_mkh1re80717c6gqi7": "a) nově otevíraným věcným skupinám,\nb) stávajícím věcným skupinám; v takovém případě je vytvořena nová věcná skupina se stejným spisovým znakem a popisem, do které jsou automaticky přetříděny otevřené spisy ze stávající věcné skupiny a tato věcná skupina je uzavřena,\nc) šablonám součástí typových spisů při jejich vzniku,\nd) nově vytvářeným druhům dokumentů.\nESSL zajistí, že znepřístupněný skartační režim nebude možné přiřadit podle písm. a) až d).\nTím nejsou dotčeny skartační režimy dokumentů podle předchozí právní úpravy.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6101
          }
        },
        {
          "id": "id_1aaa86dad1034e139b92",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL neumožní ➡",
            "id_mkh1re80717c6gqi7": "a) odstranit skartační režim, který je v eSSL používán,\nb) změnit přiřazení skartačního režimu k otevřené nebo uzavřené věcné skupině (požadavek 6.1.1 písm. b), součásti typového spisu (požadavek 6.1.1 písm. c) a požadavek 3.3.7) nebo druhu dokumentu.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6102
          }
        },
        {
          "id": "id_1054c5049a224f1497ed",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že skartační režim uplatňovaný na nově vytvořený dokument, spis, nebo díl typového spisu je děděn ➡",
            "id_mkh1re80717c6gqi7": "a) z mateřské věcné skupiny v případě spisu,\nb) ze spisu v případě dokumentu vloženého do tohoto spisu,\nc) z příslušné součásti typového spisu v případě jejího dílu,\nd) z dílu typového spisu v případě spisu vloženého do tohoto dílu.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6103
          }
        },
        {
          "id": "id_d4801f981d6440e18d15",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli vždy přidělit skartační režim každé věcné skupině na nejnižší úrovni hierarchie, součásti typového spisu na nejnižší úrovni hierarchie nebo druhu dokumentu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6104
          }
        },
        {
          "id": "id_eac1f081201a4a52bba1",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že každý skartační režim obsahuje ➡",
            "id_mkh1re80717c6gqi7": "a) jednoznačný identifikátor,\nb) skartační lhůtu,\nc) typ skartační operace (skartační znak „A\" nebo „S\"),\nd) spouštěcí událost.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6105
          }
        },
        {
          "id": "id_b80c28cae83f48359e39",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli stanovit pro skartační režim jednu z následujících spouštěcích událostí ➡",
            "id_mkh1re80717c6gqi7": "a) rok vyřízení spisu,\nb) rok uzavření spisu,\nc) rok založení spisu totožný s rokem jeho evidence,\nd) rok narození nebo vzniku subjektu,\ne) externí událost, u které nelze předem stanovit okamžik vzniku spouštěcí události (například formou užití slov „po skončení platnosti smlouvy\", „od likvidace skládky\" nebo „po zahájení insolvenčního řízení\"), s počtem let, po jejichž uplynutí eSSL vyzve posuzovatele skartační operace k posouzení, zda již externí spouštěcí událost nastala.\nSkartační režim přiřazený druhu dokumentu může obsahovat spouštěcí událost pouze a), b), e).",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6106
          }
        },
        {
          "id": "id_a72469de4dca4ea58ed6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje v rámci každého skartačního režimu tyto typy skartačních operací: ➡",
            "id_mkh1re80717c6gqi7": "a) návrh na trvalé uložení pro dokumenty trvalé hodnoty (dokumenty označené skartačním znakem „A\"),\nb) návrh na zničení (dokumenty označené skartačním znakem „S\").",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6107
          }
        },
        {
          "id": "id_75c1537b14c94bb48a62",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud jsou dokumentu, spisu nebo dílu typového spisu současně přiřazeny různé skartační režimy (s jinou skartační lhůtou nebo s jiným skartačním znakem nebo jinou spouštěcí událostí), vzniká konflikt skartačních režimů. ➡",
            "id_mkh1re80717c6gqi7": "Konflikty vznikají v následujících případech:\na) liší se skartační režim spisu a skartační režim v něm vloženého dokumentu, pokud má současně přiřazen skartační režim na základě druhu dokumentu,\nb) liší se skartační režim dílu typového spisu a skartační režim spisu zatříděného v tomto dílu, který byl změněn po vypořádání konfliktu skartačních režimů spisu podle písm. a) nebo po přetřídění typových spisů do nové věcné skupiny pro typové spisy podle požadavku 3.3.4 odst. 4),\nc) liší se skartační režimy spisů spojených pevným křížovým odkazem podle požadavku 4.1.2.\nESSL před uzavřením spisu nebo dílu typového spisu nebo při spojení dvou uzavřených spisů pevným křížovým odkazem (požadavek 4.1.4) zajišťuje automaticky vyřešení konfliktů, které jsou v daném okamžiku již řešitelné:\n1) Přidělením nejzávažnějšího skartačního režimu. Pokud alespoň jeden ze skartačních režimů v konfliktu obsahuje skartační znak „A\", bude v rámci výsledného skartačního režimu uplatněn skartační znak „A\", v ostatních případech bude uplatněn skartační znak „S\".\n2) Přidělením nejvzdálenějšího roku vyřazení, který byl stanoven na základě skartačních lhůt a externích spouštěcích událostí, pokud je skartační režimy obsahují a již nastaly. Skartační lhůty a spouštěcí události, které byly v konfliktu skartačních režimů, se poté pro účely vyřazení již neuplatní. Jestliže v době uzavření spisu nebo dílu typového spisu nenastala externí spouštěcí událost a není možné stanovit rok vyřazení, bude automatické vypořádání konfliktu skartačních režimů odloženo do provedení požadavku 6.1.6 písm. e) a požadavku 6.1.9.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6108
          }
        },
        {
          "id": "id_d7926db34b0d42bda2fd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud eSSL identifikuje externí spouštěcí událost podle požadavku 6.1.6, která nemá uveden rok, kdy nastala, eSSL po uplynutí lhůty pro kontrolu spouštěcí události počítané od uzavření spisu vyzve posuzovatele skartační operace, aby rozhodl, zda externí spouštěcí událost nastala. ➡",
            "id_mkh1re80717c6gqi7": "Jestliže spouštěcí událost\na) nastala, posuzovatel skartační operace zaznamená do metadat spisu rok, kdy pro spis spouštěcí událost nastala; obdobně se postupuje v případě dokumentu, který má přiřazen druh dokumentu obsahující skartační režim s externí spouštěcí událostí,\nb) nenastala, posuzovatel skartační operace potvrdí eSSL tuto skutečnost; eSSL vyzve znovu k rozhodnutí posuzovatele skartační operace po uplynutí počtu let stanovených při rozhodnutí, zda externí spouštěcí událost nastala.\nESSL zajistí, že posuzovatel skartační operace může\n1) pro součást typového spisu, pro spisy nebo pro dokumenty zatříděné ve věcné skupině podle předchozí právní úpravy kdykoli hromadně doplnit rok spouštěcí události,\n2) individuálně u spisu kdykoli doplnit rok spouštěcí události.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6109
          }
        },
        {
          "id": "id_502bb01515e1485b8037",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud uplyne skartační lhůta stanovená určitému dokumentu zatříděnému ve věcné skupině podle předchozí právní úpravy, spisu nebo dílu typového spisu skartačním režimem, eSSL vytvoří po vyřešení konfliktů skartačních režimů (požadavek 6.1.8) návrh na jejich vyřazení.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6110
          }
        },
        {
          "id": "id_fc202eccd5564bb98d75",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje řízení procesu výběru dokumentů ve skartačním řízení výlučně posuzovateli skartační operace.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6111
          }
        },
        {
          "id": "id_8a73a23514ad4fe88a68",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při přetřídění uplatní dědičnost skartačního režimu z nové mateřské věcné skupiny nebo z nové mateřské součásti typového spisu na přetřiďované spisy nebo dokumenty zatříděné ve věcné skupině podle předchozí právní úpravy.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6112
          }
        },
        {
          "id": "id_cbd7d609f2174047bf0f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje, aby posuzovatel skartační operace nastavil u věcné skupiny, spisu, typového spisu, součásti typového spisu nebo dílu typového spisu příkaz k pozastavení skartační operace. Toto pozastavení se vztahuje na všechny dceřiné entity věcné skupiny, spisu, typového spisu, součásti typového spisu a dílu typového spisu, na kterém bylo pozastavení skartační operace provedeno, i na entity propojené pevným křížovým odkazem s entitou, kde k pozastavení došlo. V případě dokumentů zatříděných ve věcné skupině podle předchozí právní úpravy se tento požadavek aplikuje obdobně.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6113
          }
        },
        {
          "id": "id_f207fed2e9cd401e9392",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že pozastavení skartační operace nepřerušuje plynutí skartační lhůty.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6114
          }
        },
        {
          "id": "id_45824c18b0f74d9ea381",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zabraňuje u entity (včetně jejích dceřiných entit), na kterou je uplatněno pozastavení skartační operace, ➡",
            "id_mkh1re80717c6gqi7": "a) znepřístupnění,\nb) zařazení do návrhu na vyřazení dokumentů.",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6115
          }
        },
        {
          "id": "id_a3614c1b83444392989b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.1.16",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje posuzovateli skartační operace odstranit pozastavení skartační operace.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e86ea49d781c4e2d8af2",
            "id_mkh21fijkx4bety3t": 6116
          }
        },
        {
          "id": "id_b811208131884fb3bae8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Skartační řízení",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ef361b413ba547a0a2fe",
            "id_mkh21fijkx4bety3t": 6200
          }
        },
        {
          "id": "id_efa203cbdbe44760b7c5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na základě pokynu posuzovatele skartační operace vytvoří seznam entit navržených k vyřazení, který je tvořen datovými balíčky SIP podle přílohy č. 2. ➡",
            "id_mkh1re80717c6gqi7": "Datový balíček SIP je tvořen podle požadavku 9.2.2 a na základě volby posuzovatele skartační operace\na) neobsahuje komponenty, nebo\nb) obsahuje komponenty.",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6201
          }
        },
        {
          "id": "id_27a6e22602f14e80a730",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vytvoří seznam entit podle požadavku 6.2.1 tak, aby jej mohl původce ➡",
            "id_mkh1re80717c6gqi7": "a) předat příslušnému archivu na technických nosičích dat, nebo\nb) vložit na portál pro zpřístupnění archiválií v digitální podobě na základě uživatelského oprávnění posuzovatele skartační operace, nebo\nc) předat automatizovaně příslušnému archivu prostřednictvím aplikačního rozhraní stanoveného Národním archivem, pokud bylo zveřejněno.",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6202
          }
        },
        {
          "id": "id_1dab353631ef47a386ac",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vždy zaznamená v datovém balíčku SIP vazbu na uložení analogových částí dokumentů a spisů, pokud existují.",
            "id_mkh1re80717c6gqi7": "V případě dokumentů v analogové podobě je nezbytné spolu s evidencí udržovat jednoznačnou vazbu na fyzické dokumenty, které musí být v souladu s rozhodnutím o výběru archiválií přeneseny nebo zničeny.",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6203
          }
        },
        {
          "id": "id_7005aa55963246a9b7cd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Příslušný archiv může v průběhu archivní prohlídky požádat prostřednictvím datové zprávy podle přílohy č. 4 o datové balíčky SIP obsahující komponenty. V takovém případě eSSL na základě seznamu, ve kterém je u identifikátorů entit uvedeno „předložit k výběru\", exportuje datové balíčky SIP s komponentami.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6204
          }
        },
        {
          "id": "id_6cbb60100f8c4051aedd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí vyznačení rozhodnutí o výběru archiválií na základě seznamu vytvořeného podle přílohy č. 4, který je zaslán příslušným archivem jako příloha protokolu o výběru archiválií: ➡",
            "id_mkh1re80717c6gqi7": "a) u entity s vyznačenou operací „vybrat za archiválii\" vytvoří datové balíčky SIP obsahující i komponenty a entity označí jako určené k přenosu nebo exportu do digitálního archivu (kapitola 6.3), a v případě analogových entit nebo jejich částí, k přenosu do příslušného archivu,\nb) u entity s vyznačenou operací „zničit\" tyto entity označí ke zničení (kapitola 6.3); přitom podporuje například prostřednictvím seznamů zničení odpovídajících entit v analogové podobě,\nc) u entity s vyznačenou operací „vyřadit z výběru\" eSSL vyzve posuzovatele skartační operace k úpravě skartačního režimu,\nd) u entity s vyznačenou operací „vybrat za archiválii\" nebo „zničit\" eSSL zaznamená Identifikátor skartačního řízení.",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6205
          }
        },
        {
          "id": "id_2f3cc1409f424b39a75b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní posuzovateli skartační operace stanovit, které entity s vyznačenou operací „vybrat za archiválii\" budou určeny k přenosu. Toto rozhodnutí lze uskutečnit ➡",
            "id_mkh1re80717c6gqi7": "a) jednotlivě pro konkrétní entity, nebo\nb) hromadně pro všechny entity označené „vybrat za archiválii\".",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6206
          }
        },
        {
          "id": "id_e54a9b6bfbe7407680b6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že pokud byl u spisu realizován požadavek 3.2.10, posuzovatel skartační operace může provést kontroly a související činnosti podle požadavku 3.2.9.",
            "id_mkh1re80717c6gqi7": "Tento požadavek umožní původci připravit skartační operaci v případě, že je mu příslušným archivem odebrán trvalý skartační souhlas.",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6207
          }
        },
        {
          "id": "id_c5eb2202afd04e8a9550",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.2.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vyznačí identifikátory digitálního archivu zaslané příslušným archivem v podobě seznamu podle přílohy č. 4 k příslušným entitám (příloha úředního záznamu o předání). Tím je export nebo přenos těchto entit úspěšně ukončen.",
            "id_mkh1re80717c6gqi7": "Současně musí být do příslušného archivu přeneseny i entity v analogové podobě.",
            "id_mkh1ruycu0iq9beiq": "id_b811208131884fb3bae8",
            "id_mkh21fijkx4bety3t": 6208
          }
        },
        {
          "id": "id_e02020b9e8404fc3b9e8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Přenos, export a import",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_ef361b413ba547a0a2fe",
            "id_mkh21fijkx4bety3t": 6300
          }
        },
        {
          "id": "id_fcb009ad8d324b32a326",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL přenáší, exportuje nebo importuje repliky entit, jejich metadata a příslušné části transakčního protokolu prostřednictvím příslušného schématu XML v příloze č. 7.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6301
          }
        },
        {
          "id": "id_6d21c301273143c1a505",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, aby přenos, export nebo import replik entit byl správcovskou rolí prováděn i hromadně na základě zvolených věcných skupin, spisů, typových spisů nebo součástí typových spisů.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6302
          }
        },
        {
          "id": "id_11f14fc9b1024de98af6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje, aby byla tatáž entita exportována více než jednou.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6303
          }
        },
        {
          "id": "id_9f2d51f5c5a4409e886c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při přenosu nebo exportu dokumentu, spisu, typového spisu, součásti typového spisu, dílu typového spisu nebo obsahu věcné skupiny provádí následující operace: ➡",
            "id_mkh1re80717c6gqi7": "a) přenos nebo export repliky obsahu stanovené věcné skupiny, spisu, dokumentu, typového spisu, součásti typového spisu nebo dílu typového spisu, včetně jejich metadat a příslušných částí transakčního protokolu,\nb) export všech replik hierarchicky nadřazených entit, včetně jejich metadat a příslušných částí transakčního protokolu,\nc) export replik spisů napojených nebo vložených do exportované nebo přenášené entity pevným křížovým odkazem, včetně jejich metadat a příslušných částí transakčního protokolu,\nd) přenos replik spisů napojených nebo vložených do exportované nebo přenášené entity pevným křížovým odkazem, včetně jejich metadat a příslušných částí transakčního protokolu, pokud jsou napojené nebo vložené spisy určeny k přenosu,\ne) ukončení přenosu podle požadavku 6.3.8.",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6304
          }
        },
        {
          "id": "id_2e0611aa0f39435d89de",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při importu repliky dokumentu, spisu, typového spisu, součásti typového spisu, dílu typového spisu nebo obsahu věcné skupiny umožní uživatelskou volbu: ➡",
            "id_mkh1re80717c6gqi7": "a) spisu, do kterého bude importován dokument,\nb) věcné skupiny, do které bude importován spis,\nc) cílové věcné skupiny, do které bude importován obsah zdrojové věcné skupiny,\nd) věcné skupiny pro typové spisy a součásti (v šabloně typového spisu), do které bude importován spis nebo díl typového spisu ze zvolené zdrojové součásti typového spisu,\ne) konkrétních dokumentů, spisů, typových spisů nebo součástí typových spisů, které mají být importovány,\nf) věcné skupiny do které bude importován dokument vyřízený podle předchozí právní úpravy nebo v samostatné evidenci nepoužívající spisy.\nESSL\n1) neumožní import spisu propojeného pevným křížovým odkazem, aniž by se importovaly všechny propojené spisy,\n2) při importu spisů do věcné skupiny zachová pevné křížové odkazy mezi spisy,\n3) podle uživatelské volby importuje entity hromadně,\n4) při importu typových spisů zajistí, že odpovídá název zdrojového typového spisu a název jeho součásti názvu cílového typového spisu a jeho součásti, jinak se postupuje podle požadavku 3.3.4 bez ohledu na to, zda je zdrojový spis otevřený nebo uzavřený,\n5) zaznamená přehled z technických důvodů neimportovaných entit a znázorní jej uživateli s možností ztvárnění tohoto přehledu.",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6305
          }
        },
        {
          "id": "id_94d2b56cb7b04abda317",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní import vyřízených dokumentů zatříděných přímo ve věcné skupině tak, že tyto dokumenty mohou být opět zařazeny ve věcné skupině.",
            "id_mkh1re80717c6gqi7": "Dokumenty bylo možné zatřiďovat do věcné skupiny podle předchozí právní úpravy.",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6306
          }
        },
        {
          "id": "id_531c9906be584778a848",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Součástí metadat replik entit podle požadavků 6.3.4 a 6.3.5 jsou příslušné záznamy ➡",
            "id_mkh1re80717c6gqi7": "a) jmenného rejstříku,\nb) číselníku podle požadavku 2.7.3.",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6307
          }
        },
        {
          "id": "id_e7aa765272a04269a70e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL uchovává spisy, typové spisy, součásti typového spisu, díly typového spisu, dokumenty, komponenty a metadata, které jsou přenášeny, a to alespoň do doby potvrzení úspěšnosti ukončeného přenosu jejich replik. Do této doby eSSL umožní opakování přenosu.",
            "id_mkh1re80717c6gqi7": "U přenesených entit se i po ukončeném přenosu ve zdrojovém systému trvale uchovává hlavička metadat a příslušné části transakčního protokolu.",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6308
          }
        },
        {
          "id": "id_35cc15e761c24d2f8c55",
          "values": {
            "id_mkh1pocm7xx7x2o65": "6.3.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí správcovské roli ➡",
            "id_mkh1re80717c6gqi7": "a) v kterémkoli okamžiku export spisového plánu a skartačních režimů podle přílohy č. 5,\nb) jako součást nastavení výchozí konfigurace eSSL import spisového plánu a skartačních režimů podle přílohy č. 5.",
            "id_mkh1ruycu0iq9beiq": "id_e02020b9e8404fc3b9e8",
            "id_mkh21fijkx4bety3t": 6309
          }
        },
        {
          "id": "id_b52f2583f51f4aa6b712",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "SPRÁVA A BEZPEČNOST",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 7000
          }
        },
        {
          "id": "id_722c0ae77af54875a9d0",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Přístup",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_b52f2583f51f4aa6b712",
            "id_mkh21fijkx4bety3t": 7100
          }
        },
        {
          "id": "id_d5db21da9b214e98a17a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL neumožňuje uživateli provést jakoukoli operaci, nemá-li přidělenu roli s patřičným oprávněním. ESSL musí uživatele úspěšně identifikovat a ověřit.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7101
          }
        },
        {
          "id": "id_cd89589fcf2a4b61a3ba",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli správu přístupových práv k entitám, ke kterým má tato role sama přiřazena přístupová práva.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7102
          }
        },
        {
          "id": "id_75f8184c85a746049a3d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli potvrdit, nebo odmítnout přiřazení přístupových práv k jakémukoliv dokumentu nebo spisu, která jí byla jinou rolí přiřazena.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7103
          }
        },
        {
          "id": "id_0affe133480b48fc8305",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje roli, která přiřadila přístupová práva k dokumentu nebo spisu, aby přiřazení zrušila, pokud již nebylo potvrzeno přiřazení.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7104
          }
        },
        {
          "id": "id_731e47cbcd23453aa3ee",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL do okamžiku uzavření spisu umožní uživatelské roli podle přístupových oprávnění změnit metadata dokumentu a spisu zapsaná uživatelskou rolí. Po uzavření spisu eSSL umožní správcovské roli změnit metadata dokumentu a spisu zapsaná uživatelskou rolí.",
            "id_mkh1re80717c6gqi7": "Tato funkce umožňuje například spisovně provádět případné opravy chyb uživatelů (například chyby při vkládání dat, chybné zařazení ve věcných skupinách apod.).",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7105
          }
        },
        {
          "id": "id_49cd9e3330ff440a8dab",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli využít konfiguraci oprávnění tak, aby byl konkrétní roli nebo uživateli před stanoveným datem, ke stanovenému datu nebo po stanoveném datu ➡",
            "id_mkh1re80717c6gqi7": "a) omezen přístup ke konkrétním typovým spisům, součástem typových spisů, spisům, dokumentům nebo komponentám,\nb) omezen přístup ke konkrétním věcným skupinám,\nc) omezen přístup k určitým vlastnostem a funkcím eSSL (například ke čtení, k aktualizaci nebo k mazání určitých prvků metadat),\nd) odmítnut přístup do eSSL.",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7106
          }
        },
        {
          "id": "id_65c27b5d59d846aa8bae",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli, aby ➡",
            "id_mkh1re80717c6gqi7": "a) přidělovala oprávnění roli a\nb) přiřadila jednoho nebo více uživatelů k jakékoli roli.",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7107
          }
        },
        {
          "id": "id_bc4b0843e9934001a543",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli definovat pro role přístupová práva stejně jako pro jednotlivé uživatele a přidělovat role jednotlivým uživatelům.",
            "id_mkh1re80717c6gqi7": "Tento požadavek umožňuje správcovským rolím spravovat a udržovat soubor přístupových práv spíše pro limitovaný počet rolí, než je udržovat pro velký počet jednotlivých uživatelů.",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7108
          }
        },
        {
          "id": "id_dd73da03523a499ebd50",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje posuzovateli skartační operace přetřídění entity v rámci věcných skupin (požadavek 3.1.9), změnu metadat entity (požadavek 7.1.5), nahlížení do komponent entity, pokud je entita uložena ve spisovně.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7109
          }
        },
        {
          "id": "id_44d1432eaf594d4c8052",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správu věcných skupin výlučně správcovské roli.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7110
          }
        },
        {
          "id": "id_59bd400b82a44f258ce4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.1.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli vyhledávání, zobrazení a změnu parametrů a nastavení eSSL, alespoň u ➡",
            "id_mkh1re80717c6gqi7": "a) číselníků (požadavky 2.7.3, 4.2.1),\nb) určeného časového období (požadavek 3.3.9),\nc) otevírání a uzavírání věcných skupin (kapitola 3.1),\nd) skartačních režimů (kapitola 6.1) a\ne) tvorbu šablon typových spisů (požadavek 3.3.6).",
            "id_mkh1ruycu0iq9beiq": "id_722c0ae77af54875a9d0",
            "id_mkh21fijkx4bety3t": 7111
          }
        },
        {
          "id": "id_e170b3c9bde941ffb434",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Změny, zničení a znepřístupnění dokumentů",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_b52f2583f51f4aa6b712",
            "id_mkh21fijkx4bety3t": 7200
          }
        },
        {
          "id": "id_87f25a24896a44b99837",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL neumožní zničení komponenty, dokumentu, spisu, typového spisu, součásti typového spisu nebo dílu typového spisu nebo jejich metadat, s výjimkou zničení ➡",
            "id_mkh1re80717c6gqi7": "a) po dokončeném skartačním řízení,\nb) na základě uděleného trvalého skartačního souhlasu,\nc) po úspěšném dokončení přenosu,\nd) po evidenčním převedení do jiné evidenční pomůcky,\ne) znepřístupněných dokumentů a spisů,\nf) samostatné komponenty došlého kontejneru po uzavření spisu, pokud došlo k úspěšnému vyjmutí všech obsažených komponent podle požadavku 2.4.3,\ng) prázdného dílu typového spisu podle požadavku 3.3.14 a 3.4.6.\nPři zničení musí být zachována hlavička metadat podle požadavku 7.2.9.",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7201
          }
        },
        {
          "id": "id_c1bf7254334345c2acb7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zabrání změně komponenty, která je ➡",
            "id_mkh1re80717c6gqi7": "a) schválena, pokud nedojde k odvolání schválení příslušnou rolí,\nb) komponentou doručeného dokumentu, s výjimkou provádění požadavků 2.4.1, 2.4.2 a 2.5.1.",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7202
          }
        },
        {
          "id": "id_923ddfd587704368b311",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní posuzovateli skartační operace zničení spisu nebo dokumentu na základě trvalého skartačního souhlasu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7203
          }
        },
        {
          "id": "id_7b6b0eda99314a509e44",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud eSSL provádí zničení spisu nebo dokumentu na základě trvalého skartačního souhlasu, eSSL zajistí, aby posuzovatel skartační operace vyznačil do metadat jednoznačný identifikátor nebo číslo jednací rozhodnutí o udělení trvalého skartačního souhlasu. ESSL zajistí, že o zničení lze na základě volby posuzovatele skartační operace vytvořit hlášení podle požadavku 7.3.8.",
            "id_mkh1re80717c6gqi7": "Požadavek slouží k zajištění průkaznosti oprávnění k uvedenému jednání a zajišťuje častý požadavek příslušného archivu na předkládání informačních hlášení, kterým archiv podmiňuje vydání trvalého skartačního souhlasu.",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7204
          }
        },
        {
          "id": "id_0609b322ee1746c88953",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zničí spisy, typové spisy, součásti typového spisu, díly typového spisu, dokumenty, metadata a ztvárnění příslušné části transakčního protokolu, které jsou přenášeny, jestliže obdrží potvrzení o úspěšném ukončení přenosu, a to s výjimkou metadat, která jsou uchovávána v hlavičkách metadat (požadavky 7.2.9 a 7.2.10).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7205
          }
        },
        {
          "id": "id_72d139d712034c2aabdf",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zničí spisy, díly typového spisu, dokumenty a metadata, které byly určeny ke zničení při skartačním řízení (požadavek 6.2.5 písm. b), a to s výjimkou metadat, která jsou uchovávána v hlavičkách metadat (požadavky 7.2.9 a 7.2.10).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7206
          }
        },
        {
          "id": "id_3afc212eb3d14da8be9f",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je v eSSL uplatněna výjimka podle požadavku 7.2.1, eSSL postupuje tak, že dokument zničí spolu s příslušnými metadaty, kromě metadat specifikovaných jako hlavička metadat (požadavek 7.2.9).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7207
          }
        },
        {
          "id": "id_9b9c56e0208140e4b675",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL v případě zničení dokumentu nebo spisu automaticky z metadat odstraní vazbu na dokument nebo spis ze všech záznamů ve jmenném rejstříku.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7208
          }
        },
        {
          "id": "id_94b9af5e96d74a80ac64",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL uchovává hlavičku metadat podle přílohy č. 8 popisující ➡",
            "id_mkh1re80717c6gqi7": "a) typové spisy,\nb) součásti typových spisů,\nc) díly typových spisů,\nd) spisy,\ne) dokumenty,\nf) komponenty.",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7209
          }
        },
        {
          "id": "id_b15a2d3a325a4acb8182",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli stanovit další metadata, která budou uchována jako hlavička metadat.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7210
          }
        },
        {
          "id": "id_29d1bf84245d4ac89480",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL nabízí konfigurační možnost dokumenty a spisy znepřístupnit.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7211
          }
        },
        {
          "id": "id_b2b6236cda90443a8877",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní znepřístupnění dokumentu nebo spisu ➡",
            "id_mkh1re80717c6gqi7": "a) uživateli, který dokument vytvořil a nepředal držení tohoto dokumentu jinému uživateli (první zpracovatel),\nb) správcovské roli v případě dokumentů nikdy nezařazených do spisů nebo spisů, které neobsahují dokumenty.\nESSL přitom vyžaduje, aby uživatelská nebo správcovská role vyznačila důvod znepřístupnění.",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7212
          }
        },
        {
          "id": "id_bde2acf34feb48d382f3",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, aby se znepřístupněné dokumenty a spisy při znázorňování a vyhledávání jevily jako zničené každé roli s výjimkou posuzovatele skartační operace.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7213
          }
        },
        {
          "id": "id_7bcf6d49cb4747d6a4ee",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL nedovolí uživatelské nebo správcovské roli provést znepřístupnění dokumentů nebo spisů jako hromadnou operaci.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7214
          }
        },
        {
          "id": "id_4074e7922037411db802",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, aby posuzovatel skartační operace mohl znepřístupněné dokumenty nebo spisy -- vyjma již zničených -- uvést do původního stavu (zpřístupnit).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7215
          }
        },
        {
          "id": "id_03f4a1f96ef44ccfacf2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.2.16",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní posuzovateli skartační operace zničit znepřístupněné dokumenty za stanovené období s výjimkou hlaviček metadat, případně eSSL zajistí automatické zničení znepřístupněných dokumentů po uplynutí lhůty nastavené správcovskou rolí.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_e170b3c9bde941ffb434",
            "id_mkh21fijkx4bety3t": 7216
          }
        },
        {
          "id": "id_6fec33bf14fc4715ab9c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Hlášení o stavu eSSL",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_b52f2583f51f4aa6b712",
            "id_mkh21fijkx4bety3t": 7300
          }
        },
        {
          "id": "id_0c753d4d062e43c1ab00",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zahrnuje funkce ztvárnění stavových hlášení o své správě, stejně jako statistických a jednorázových informací (dále „zprávy\") a jejich vytištění nebo uložení v digitální podobě (například pro zpracování tabulkovým procesorem).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7301
          }
        },
        {
          "id": "id_58b53a0c90bf43468b28",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL poskytuje alespoň zprávy o celkovém počtu spravovaných ➡",
            "id_mkh1re80717c6gqi7": "a) spisů a typových spisů,\nb) komponent tříděných podle datového formátu uvedeného v metadatu \"datový formát komponenty\"; uvede se datový formát a celkový počet komponent daného datového formátu,\nc) dokumentů a spisů v držení zvoleného zpracovatele,\nd) spisů, typových spisů a součástí typových spisů tříděných podle přístupových oprávnění jednotlivých uživatelů; uvede se jméno a příjmení uživatele, jeho uživatelská role a počty spisů, typových spisů a součástí typových spisů, pro které je aktuálním zpracovatelem.",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7303
          }
        },
        {
          "id": "id_405e214e0e244ed2ab6b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL poskytuje zprávy o fyzickém umístění analogových částí spisů a dílů typových spisů tříděných podle místa uložení.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7304
          }
        },
        {
          "id": "id_16b56658954449f8ba7c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL poskytuje alespoň zprávy o ➡",
            "id_mkh1re80717c6gqi7": "a) počtu přijatých dokumentů za stanovené období,\nb) počtu nově vytvořených spisů a typových spisů v jednotlivých věcných skupinách za stanovené období; věcné skupiny jsou seřazeny podle spisového a skartačního plánu,\nc) počtu spisů zatříděných v jednotlivých věcných skupinách za stanovené období nebo ke stanovenému datu; věcné skupiny jsou seřazeny podle spisového a skartačního plánu,\nd) všech věcných skupinách otevřených ke stanovenému datu; u každé věcné skupiny se uvede spisový znak.",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7305
          }
        },
        {
          "id": "id_45da8931c96b401baf8e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL poskytuje zprávu o výsledcích procesů importu, výběru archiválií, přenosu, exportu, zničení s uvedením věcných skupin, typových spisů, součástí typových spisů, dílů typových spisů, spisů a dokumentů, které byly úspěšně importovány, zničeny, znepřístupněny, přeneseny nebo exportovány, s uvedením případných chyb, které v průběhu procesů nastaly. Popis chyby identifikuje dokumenty, věcné skupiny, typové spisy, součásti typového spisu, díly typového spisu, spisy a dokumenty a s nimi spojená metadata, které nebyly úspěšně importovány, přeneseny, exportovány, zničeny.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7306
          }
        },
        {
          "id": "id_b46cd2e2fcdb42829548",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na vyžádání posuzovatele skartační operace poskytuje zprávu, která pro zadané období obsahuje údaje o provedeném znepřístupnění entit podle požadavku 7.2.12 v rozsahu: ➡",
            "id_mkh1re80717c6gqi7": "a) jednoznačný identifikátor znepřístupněného dokumentu a spisová značka spisu, pokud byl dokument do spisu zařazen a po vyjmutí z něj znepřístupněn v souladu s požadavkem 7.2.12 písm. a),\nb) spisová značka znepřístupněného spisu,\nc) věc znepřístupněného dokumentu a spisu,\nd) identifikace uživatele, který dokument znepřístupnil,\ne) důvod znepřístupnění.",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7307
          }
        },
        {
          "id": "id_e7b0ae359bf74d7fa668",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na vyžádání posuzovatele skartační operace poskytuje zprávu, která pro zadané období obsahuje údaje o provedeném zničení entit podle požadavku 7.2.1 písm. a) až d) v rozsahu: ➡",
            "id_mkh1re80717c6gqi7": "a) identifikace posuzovatele skartační operace,\nb) identifikace vydaného trvalého skartačního souhlasu,\nc) datum a čas provedení operace zničení,\nd) počet zničených dokumentů a spisů v rámci dílu typového spisu nebo určeného časového období věcné skupiny, ve které došlo ke zničení entit.",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7308
          }
        },
        {
          "id": "id_d357599a8aef4e0fb771",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.3.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL poskytuje zprávy o množství dokumentů, spisů a dílů typových spisů za stanovené období, kterým ke stanovenému datu uplynula skartační lhůta.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_6fec33bf14fc4715ab9c",
            "id_mkh21fijkx4bety3t": 7309
          }
        },
        {
          "id": "id_9c7883d74c484508af5a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Transakční protokol",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_b52f2583f51f4aa6b712",
            "id_mkh21fijkx4bety3t": 7400
          }
        },
        {
          "id": "id_0bc6455be15f4c28b1b7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vede po celou dobu provozu transakční protokol a nepřipustí změnu nebo zničení údajů v něm. ESSL na vyžádání správcovské role ztvární úplný obsah transakčního protokolu do XML za zadané časové období. XML schéma transakčního protokolu je popsané v příloze č. 6.",
            "id_mkh1re80717c6gqi7": "ESSL v případě technických omezení rozdělí ztvárnění transakčního protokolu do více samostatných komponent, přičemž jejich obsahy na sebe musí plynule navazovat.",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7401
          }
        },
        {
          "id": "id_8aca593030f9406e8bce",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje do transakčního protokolu alespoň údaje o přístupu k entitě, pokusu o přístup k entitě, každé změně stavu nebo manipulaci s entitami, změně metadat entity (zaznamená nový stav), včetně uživatelských záznamů a pokynů pro schvalování a oběh entity.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7402
          }
        },
        {
          "id": "id_99087937ddd14093a182",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje do transakčního protokolu alespoň údaje o vlastních změnách, změnách své konfigurace, nastavení a o změnách uživatelských oprávnění.",
            "id_mkh1re80717c6gqi7": "Tento požadavek umožňuje jednoznačně identifikovat verzi eSSL a čas jejího nasazení do produkčního provozu, změny konfigurace a nastavení eSSL.",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7403
          }
        },
        {
          "id": "id_7b5cb0f494f749a695e6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje do transakčního protokolu veškeré automaticky prováděné operace.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7404
          }
        },
        {
          "id": "id_a9006d6975924460a429",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje do transakčního protokolu veškeré operace se záznamy ve jmenném rejstříku, zejména jejich vytváření, úpravy, zničení a nahlížení na záznamy.",
            "id_mkh1re80717c6gqi7": "a) datum, kdy bylo pozastavení zavedeno, nebo odstraněno,\nb) identifikaci oprávněného uživatele,\nc) důvod pozastavení, nebo důvod odstranění pozastavení.",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7405
          }
        },
        {
          "id": "id_1184bf638eaa482a99f7",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje změnu spisového znaku věcné skupiny do transakčního protokolu, pokud provádí import podle požadavku 6.3.5.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7408
          }
        },
        {
          "id": "id_de9cba050ce346788efa",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje do transakčního protokolu údaje o zničení (fyzickém vymazání) dokumentu podle požadavku 7.2.7.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7409
          }
        },
        {
          "id": "id_a33db719606e4f1dbf93",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že každý záznam v transakčním protokolu obsahuje údaj o uživateli, který změnu stavu nebo manipulaci provedl, a o času provedení změny nebo manipulace.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7410
          }
        },
        {
          "id": "id_a6e3fa7567934942b8a3",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zapisuje do transakčního protokolu údaje o každém přihlášení nebo odhlášení uživatele.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7411
          }
        },
        {
          "id": "id_1a14167c85da486d902c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje dostupnost transakčního protokolu tak, aby byl na výzvu správcovské role znázorněn a ztvárněn.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7412
          }
        },
        {
          "id": "id_1ea3bf4f47bd459ba985",
          "values": {
            "id_mkh1pocm7xx7x2o65": "7.4.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při každé změně komponenty zapisuje do transakčního protokolu její hash a název použité hashovací funkce.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_9c7883d74c484508af5a",
            "id_mkh21fijkx4bety3t": 7413
          }
        },
        {
          "id": "id_96e0ae97ac364bd1a4fc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "ROZHRANÍ PRO PROPOJENÍ INFORMAČNÍCH SYSTÉMŮ SPRAVUJÍCÍCH DOKUMENTY",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 8000
          }
        },
        {
          "id": "id_f7ba5a663d4944d19c74",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Vazby mezi informačními systémy spravujícími dokumenty",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_96e0ae97ac364bd1a4fc",
            "id_mkh21fijkx4bety3t": 8100
          }
        },
        {
          "id": "id_c7fadee6818c45ac8020",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Rozhraní umožňuje synchronní i asynchronní komunikaci mezi informačními systémy spravujícími dokumenty původce, přičemž toto rozhraní je realizováno prostřednictvím webových služeb a schémat XSD uvedených v příloze č. 1.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8101
          }
        },
        {
          "id": "id_01d81f766c514f9fa57e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Každý informační systém spravující dokumenty (včetně eSSL) má pro účely komunikace původcem přidělen jednoznačný identifikátor, který je používán pro označení zdroje a cíle komunikace.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8102
          }
        },
        {
          "id": "id_b65b874dd1bd439b82ea",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Informační systém spravující dokumenty umožňuje, aby identifikace podle požadavku 8.1.2 mohla být rozšířena o zajišťovací prvky, které mohou být volitelně použity při zabezpečení dávek XML.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8103
          }
        },
        {
          "id": "id_0afdc6f48bce4b9dacbc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Rozhraní mezi informačními systémy spravujícími dokumenty je založeno na nedělitelných událostech podle požadavků 8.1.8 a 8.1.10 a pracuje s entitami a jejich metadaty. Každá událost je označena identifikátorem; identifikátor události je jednoznačný v rámci daného systému a jeho součástí je jednoznačný identifikátor systému podle požadavku 8.1.2.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8104
          }
        },
        {
          "id": "id_f7c2ba5cf3074894b616",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Při synchronní komunikaci volaná strana okamžitě vykoná požadovanou událost. Výsledek události je vrácen volající straně jako výsledek volání webové služby.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8105
          }
        },
        {
          "id": "id_42e8a82190ae4c668a17",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "V rámci jednoho volání synchronní webové služby podle požadavku 8.1.8 musí být jednotlivá událost buď zcela a bezezbytku zpracována, nebo v případě vzniku chyby nebo stavu, kdy příjemce aktivně odmítne událost zpracovat, nesmí být zpracována vůbec. Částečné zpracování události je nepřípustné.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8106
          }
        },
        {
          "id": "id_9989699d5cd34d739e28",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Při opakovaném příjmu identické události (události s identickým jednoznačným identifikátorem), která již byla jednou úspěšně provedena, musí volaná strana vrátit vždy stejný výsledek. Takové opakování se nesmí považovat za chybu. V případě, že je obsahem události vytvoření nové instance entity (například DokumentZalozeni, SpisZalozeni, DokumentPostoupeniZadost, SpisPostoupeniZadost, OsobaZalozeni), volaná strana událost podruhé nezpracuje, ale pouze volajícímu vrátí stejnou výslednou informaci jako při prvním úspěšném zpracování události.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8107
          }
        },
        {
          "id": "id_fb488bd296834f379475",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Rozhraní eSSL poskytuje alespoň následující funkce: ➡",
            "id_mkh1re80717c6gqi7": "a) SpisZalozeni -- založení spisu nad dokumentem. Je možné založit celý spis i s dokumenty v něm, nebo je spis založen nad existujícím dokumentem.\nb) DokumentZalozeni -- zaevidování nového dokumentu přijatého nebo vzniklého v informačním systému spravujícím dokumenty. Nepřenáší kompletní profil dokumentu, ale jen údaje, které dávají smysl při založení popsané typem tProfilDokumentuZalozeni.\nc) DokumentPostoupeniZadost -- žádost o postoupení dokumentu (převzetí dokumentu do výhradní správy volajícím systémem).\nd) SpisPostoupeniZadost -- žádost o postoupení spisu (převzetí spisu do výhradní správy volajícím systémem).\ne) SpisVraceniZadost -- žádost o vrácení spisu do výhradní správy.\nf) ProfilDokumentuZadost -- žádost o poskytnutí detailních informací o dokumentu.\ng) DokumentVraceniZadost -- žádost o vrácení dokumentu do výhradní správy.\nh) ProfilSpisuZadost -- žádost o poskytnutí detailních informací o spisu.\ni) ProfilTypovehoSpisuZadost -- žádost o poskytnutí detailních informací o typovém spisu.\nj) TypovySpisZalozeni -- služba pro založení typového spisu.\nk) SouborZadost -- žádost o poskytnutí obsahu zadané komponenty (pojem „soubor\" v kontextu popisu rozhraní je identický s pojmem „komponenta\").\nl) CiselnikZadost -- žádost o poskytnutí číselníku. Kód (název) číselníku zpravidla odpovídá názvu elementu, k němuž se číselník vztahuje. Pro určení číselníku se používá element IdCiselniku a ne Kod. Položky číselníku mohou přenášet větší množství nepovinných položek podle potřeby.\nm) CiselnikySeznam - služba vrací seznam všech dostupných číselníků.\nn) DavkySeznam -- služba umožní volajícímu systému získat seznam dávek, které jsou ve volaném systému pro daný volající systém připraveny.\no) DavkaZadost -- služba umožní volajícímu systému získat z volaného systému dávku.\np) Udalosti -- žádost o okamžité vykonání předaného pole událostí.\nq) WsTest -- funkce pro otestování komunikace. Pouze informuje o aktuální dostupnosti volaného systému.\nr) PrideleneSeznam -- funkce pro zaslání seznamu všech entit konkrétního uživatele v daném systému. Funkce umožňuje filtrování podle identifikátoru, druhu entity, data vytvoření a data poslední změny.\ns) ProfilOsobyZadost -- žádost o poskytnutí detailních informací o osobě ve jmenném rejstříku.\nt) OsobaUprava -- žádost o úpravu dat osoby ve jmenném rejstříku.\nu) OsobySeznam -- služba pro vyhledání osoby ve jmenném rejstříku.\nv) OsobaZalozeni -- založení osoby ve jmenném rejstříku.\nw) ermsAsyn -- přenos dávek obsahujících události a zprávy podle požadavku",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8108
          }
        },
        {
          "id": "id_d0cbf072a5f74b64a0e5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Rozhraní v rámci asynchronní komunikace sdružuje události do dávek. Součástí dávek jsou též zprávy o zpracování přijatých událostí. Dávka může obsahovat ➡",
            "id_mkh1re80717c6gqi7": "a) události,\nb) zprávy, nebo\nc) události a zprávy.",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8109
          }
        },
        {
          "id": "id_cdcd6e0fc4584d3e8151",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Rozhraní podporuje příjem alespoň následujících událostí: ➡",
            "id_mkh1re80717c6gqi7": "a) DokumentZalozeni -- založení nového dokumentu.\nb) DokumentUprava -- úprava metadat existujícího dokumentu.\nc) DokumentZruseni -- znepřístupnění existujícího dokumentu, který nikdy nebyl zařazen do spisu.\nd) DokumentOtevreni -- otevření dříve vyřízeného dokumentu.\ne) DokumentVyrizeni -- označení dokumentu za vyřízený. Podle konfigurace jiného informačního systému spravujícího dokumenty, resp. eSSL může být vyřízení dokumentu spojeno také s jeho uzavřením.\nf) DokumentPostoupeni -- předání dokumentu do výhradní správy jiného informačního systému spravujícího dokumenty, resp. eSSL (uplatní se vždy, když je předávána výhradní správa, tj. jak při předání z eSSL na informační systém spravující dokumenty, tak při předání z informačního systému spravujícího dokumenty na eSSL nebo mezi dvěma informačními systémy spravující dokumenty.\ng) DokumentVraceni -- vrácení zpracování dokumentu do eSSL. Reverzní událost k DokumentPostoupeni.\nh) DokumentVlozeniDoSpisu -- vložení dokumentu do spisu. Spis nesmí být uzavřen.\ni) DokumentVyjmutiZeSpisu -- vyjmutí dokumentu ze spisu. Dokument a spis musí existovat, spis nesmí být uzavřen.\nj) DokumentZmenaZpracovatele -- předání dokumentu jinému zpracovateli. Při předání mezi uživateli je v elementu „Autorizace\" původní zpracovatel, element „Prebirajici\" obsahuje údaje o novém zpracovateli. Při administrativním přidělení je administrátor v elementu „Autorizace\" a v elementu „Prebirajici\" je nový zpracovatel dokumentu. Pokud k události došlo jindy než v okamžiku zaevidování, je možno do elementu „predanoKdy\" uvést skutečné datum události.\nk) DokumentExterniSpousteciUdalost -- předání informace, že nastala událost, kterou je podmíněn začátek běhu skartační lhůty.\nl) DokumentSkartacniNavrh -- informace o zařazení dokumentu do skartačního návrhu s možností vynuceného vyjmutí ze skartačního návrhu v odpovědi na volání události.\nm) DokumentSkartovano -- předání informace, že nad dokumentem proběhlo skartační řízení.\nn) SpisZalozeni -- založení spisu. Nepřenáší kompletní profil spisu, ale jen údaje, které dávají smysl při založení popsané typem tProfilSpisuZalozeni.\no) SpisUprava -- úprava metadat existujícího spisu.\np) SpisPostoupeni -- předání spisu do výhradní správy jiného informačního systému spravujícího dokumenty, respektive eSSL.\nq) SpisVraceni -- vrácení zpracování spisu do eSSL. Reverzní událost ke SpisPostoupeni\nr) SpisOtevreni -- otevření dříve uzavřeného spisu.\ns) SpisUzavreni -- uzavření vyřízeného spisu.\nt) SpisZruseni -- znepřístupnění spisu, který neobsahuje dokumenty.\nu) SpisVyrizeni -- vyřízení spisu včetně všech vložených dokumentů. Podle konfigurace eSSL může být vyřízení spisu spojeno také s jeho uzavřením.\nv) SpisZmenaZpracovatele -- předání spisu a všech vložených dokumentů jinému zpracovateli. Při předání mezi uživateli je v elementu „Autorizace\" původní zpracovatel, element „Prebirajici\" obsahuje údaje o novém zpracovateli. Při administrativním přidělení je administrátor v elementu „Autorizace\" a v elementu „Prebirajici\" je nový zpracovatel spisu. Pokud k události došlo jindy než v okamžiku zaevidování, je možno do elementu „predanoKdy\" uvést skutečné datum události.\nw) SpisExterniSpousteciUdalost -- předání informace, že nastala událost, kterou je podmíněn začátek běhu skartační lhůty.\nx) SpisSkartacniNavrh -- informace o zařazení spisu do skartačního návrhu s možností vynuceného vyjmutí ze skartačního návrhu v odpovědi na volání události.\ny) SpisSkartovano -- předání informace, že nad spisem proběhlo skartační řízení.\nz) SpisVlozeniDoTypovehoSpisu -- vložení spisu do součásti typového spisu (otevřeného dílu součásti). Součást nesmí být uzavřena.\naa) SpisVyjmutiZTypovehoSpisu -- vyjmutí spisu ze součásti typového spisu. Spis a součást typového spisu musí existovat. Díl typového spisu nesmí být uzavřen.\nbb) DoruceniUprava -- změna metadat dokumentu týkajících se informací o přijetí původcem.\ncc) VypraveniZalozeni -- vytvoření zásilky pro odeslání dokumentu. Stav nové zásilky je „nevypraveno\".\ndd) VypraveniUprava -- úprava metadat zásilky.\nee) VypraveniVypraveno -- předání informace, že zásilka byla vypravena.\nff) VypraveniDoruceno -- zápis informací o doručení k zásilce.\ngg) VypraveniZruseni -- znepřístupnění zásilky.\nhh) VypraveniPredatVypravne -- pokyn k předání zásilky do výpravny k vypravení.\nii) SouborZalozeni -- založení komponenty. Událost je potřeba použít před použitím komponenty v dalších událostech, například DokumentPostoupeni. V události může být předán elektronický obsah přímo nebo pouze odkaz (identifikátor) na soubor a v takovém případě zdrojová evidence dokumentů poskytuje cílové evidenci dokumentů REST službu (adresu URL), která na základě identifikátoru vrátí elektronický obsah komponenty včetně mimeType. REST služba musí podporovat metodu GET, názvy parametrů jsou „HodnotaID\" a „ZdrojID\".\njj) SouborNovaVerze -- nahrazení stávající komponenty novou.\nkk) SouborZruseni -- odstranění komponenty. ll) SouborVlozitKDokumentu -- přiložení existující komponenty k dokumentu.\nmm) SouborVyjmoutZDokumentu -- odstranění komponenty z dokumentu. Komponenta nesmí být u tohoto dokumentu součástí zásilky, která je předána k vypravení.\nnn) SouborVlozitKVypraveni -- určení komponenty, že bude součástí zásilky.\noo) SouborVyjmoutZVypraveni -- určení komponenty, že nebude dále součástí zásilky.\npp) SouborOdemkniFinal -- událost zruší příznak konečného tvaru komponenty.\nqq) OdkazVytvoreni -- vytvoření nebo úprava pevného nebo volného křížového odkazu.\nrr) OdkazZruseni -- odstranění pevného nebo volného křížového odkazu. ss) UzivateleSeznam -- vrací seznam uživatelů systému. tt) FunkcniMista -- vrací funkční místa jednoho uživatele systému.",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8110
          }
        },
        {
          "id": "id_a782f4cf90ff42c0a25a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "V případě zpracování událostí v dávkách při asynchronní komunikaci jsou transakce realizovány na úrovni událostí, nikoliv dávek. Jedná se o rozdíl oproti synchronní komunikaci podle požadavku 8.1.6.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8111
          }
        },
        {
          "id": "id_430e6994a433452aaf82",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Po odeslání jedné dávky při asynchronní komunikaci nemusí odesílatel čekat s odesláním dalších dávek až do příjmu potvrzení o zpracování předchozí odeslané dávky příjemcem. Lze odesílat i několik po sobě jdoucích dávek bez čekání na jejich zpracování a potvrzení protistranou.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8112
          }
        },
        {
          "id": "id_9e56e3be2ba0418c968a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Číslování dávek je unikátní jen pro každou komunikaci přes rozhraní eSSL. Dávky jsou číslovány vzestupnou řadou s přírůstkem 1 (jedna). Pořadová čísla dávek na sebe musí navazovat v nepřerušené, spojité řadě.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8113
          }
        },
        {
          "id": "id_ddbe2bb5d7e24bada270",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.14",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pořadí dávek musí odpovídat pořadí dávek podle položky DatumVzniku uvedené v hlavičce každé dávky.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8114
          }
        },
        {
          "id": "id_2bc2ec9735684ccc9bc6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.15",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Události jsou číslovány vzestupnou řadou v rámci každé dávky. Pořadová čísla událostí nesmí svým pořadím odporovat pořadí zápisu událostí v XML souboru dávky. Číslo události nemusí být unikátní pro různé dávky. Počáteční hodnota, přírůstek ani spojitost číselné řady nejsou pro číslování událostí vyžadovány.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8115
          }
        },
        {
          "id": "id_17e10c62047f4b4dbc9e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.16",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Dávky musí být vždy zpracovávány sekvenčně. Následující dávku lze zpracovat, jen pokud byla úspěšně zpracována dávka předchozí. Pokud nastane při zpracování dávky chyba, potom se zpracování všech dávek zastaví a musí se realizovat opravné zaslání a zpracování dávky, ve které byla detekována chyba; poté musí následovat sekvenční odeslání všech následujících dávek, a to i v případě, že již byly dříve zaslány. Tedy od chybně zpracované dávky se musí znovu poslat postupně všechny dávky znovu, přičemž první musí být poslána opravená dávka, ve které byla detekována chyba.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8116
          }
        },
        {
          "id": "id_10789d38e2d44884ae4c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.17",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Každá dávka musí ve své hlavičce obsahovat identifikaci zdroje a cíle dávky.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8117
          }
        },
        {
          "id": "id_d377cddc384a47efa8a1",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.18",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Události jsou zpracovávány důsledně v pořadí, ve kterém jsou zapsány v dávce. Toto pořadí (umístění v dávce) musí odpovídat pořadí číselného označení událostí podle požadavku 8.1.15.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8118
          }
        },
        {
          "id": "id_d0eacca159e241569b33",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.19",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Událost musí být zpracována zcela, nebo nesmí být zpracována vůbec. Není přípustné částečné, neúplné zpracování jedné události. Jedná se o obdobu požadavku 8.1.6 pro asynchronní komunikaci.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8119
          }
        },
        {
          "id": "id_a02abc1f92b14bf3ab2e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.20",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Událost lze považovat za úspěšně odeslanou a zpracovanou příjemcem pouze v případě, že je zpracování potvrzeno v některé z následujících přijatých dávek.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8120
          }
        },
        {
          "id": "id_b0f67ffd800c4061808e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.21",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Dávku lze považovat za zpracovanou pouze v případě, že všechny v ní obsažené události byly protistranou potvrzeny jako úspěšně zpracované.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8121
          }
        },
        {
          "id": "id_1546214e74a74364a580",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.22",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Při potvrzení událostí je povoleno použít následující zjednodušení: Pokud je potvrzeno úspěšné zpracování poslední události v dávce, potom jsou tímto potvrzena úspěšná zpracování všech událostí této dávky.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8122
          }
        },
        {
          "id": "id_b036b931cdd64ebbaf46",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.23",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Komunikace podle požadavku 8.1.1 probíhá prostřednictvím protokolu https. Jako vyšší stupeň zabezpečení může https server při komunikaci vyžadovat autentizaci klienta klientským certifikátem.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8123
          }
        },
        {
          "id": "id_ea7f8a024d6f42e280b6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.24",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje zabezpečení integrity dat přenášených XML dávek elektronickou pečetí ve standardu podle platných právních předpisů. Použití nebo nepoužití tohoto zabezpečení závisí na konkrétní vazbě a eSSL musí umožňovat toto nastavení samostatně pro každou vazbu na jiný informační systém spravující dokumenty. Vztah mezi označením zdroje komunikace a konkrétním certifikátem elektronického podpisu nebo elektronické pečeti se nastaví při zavádění rozhraní, a to jako součást výchozí konfigurace komunikujících eSSL a informačním systémem spravujícím dokumenty.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8124
          }
        },
        {
          "id": "id_88192a96b532470d8082",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.25",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Přístup k entitám je vždy výhradní, tedy události týkající se dané entity smí vytvářet pouze systém, který má aktuálně entitu ve své výhradní správě. Změna výhradní správy z jednoho systému na druhý je možná pouze prostřednictvím příslušných událostí. Výjimka je přípustná pouze jedna a je popsána požadavkem 8.1.27.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8125
          }
        },
        {
          "id": "id_284dd860e03e49f58143",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.26",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Systém s aktuálně nevýhradní správou může požádat voláním synchronní metody rozhraní o postoupení spisu a/nebo dokumentu z výhradní správy druhého systému do své výhradní správy. Této žádosti o postoupení výhradní správy spisu a/nebo dokumentu druhý systém může, a nemusí vyhovět. V případě zamítnuté žádosti o převzetí do výhradní správy musí volaný systém navrátit chybový kód, který bude popisovat zdůvodnění takového odmítnutí.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8126
          }
        },
        {
          "id": "id_f80faec38ff843689cfc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.27",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL musí obsahovat správcovskou funkci, která zruší příznak výhradní správy entity informačním systémem spravujícím dokumenty (zejména v případě nefunkčnosti tohoto systému). U každé této servisní operace je třeba evidovat důvod a zaznamenat jej spolu s ostatními metadaty operace do transakčního protokolu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8127
          }
        },
        {
          "id": "id_28b8a19cbe8347a99a64",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.28",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "V rámci konfigurace vazby mezi eSSL a informačním systémem spravujícím dokumenty musí být ➡",
            "id_mkh1re80717c6gqi7": "a) sjednoceny všechny hodnoty ve všech propojených systémech, nebo\nb) vytvořeny a implementovány převodní můstky mezi hodnotami použitými v jednotlivých systémech.\nJedná se alespoň o následující metadata:\n1) uživatel („provedlKdo\", „novyZpracovatel\", „VlastniKdo\"),\n2) spisový a skartační plán („SpisovyPlan\"),\n3) spisový znak („SpisovyZnak\"),\n4) druh dokumentu („DruhDokumentu\"),\n5) podací deník („PodaciDenik\"),\n6) způsob vyřízení spisu nebo dokumentu („ZpusobVyrizeni\"),\n7) skartační režim,\n8) spouštěcí událost.",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8128
          }
        },
        {
          "id": "id_6ade7c73a4854ec0b0bd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.29",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní pomocí rozhraní postoupit entitu ke zpracování informačnímu systému spravujícímu dokumenty na žádost uživatele podanou prostřednictvím informačního systému spravujícího dokumenty. Uživatel informačního systému spravujícího dokumenty si může vyžádat seznam přidělených dokumentů, spisů a součástí typových spisů prostřednictvím informačního systému spravujícího dokumenty bez toho, že by musel pracovat s eSSL.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8129
          }
        },
        {
          "id": "id_deaa23370f7b4d66a173",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.30",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Identifikátor entity přiděluje vždy ten informační systém spravující dokumenty, který entitu zaeviduje jako první. Ostatní systémy musí identifikátor převzít.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8130
          }
        },
        {
          "id": "id_6d83487724534562ab7a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.31",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Označení zdroje identifikátoru podle požadavku 8.1.30 je shodné s identifikací podle požadavku 8.1.2 a musí být v rámci původce unikátní.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8131
          }
        },
        {
          "id": "id_991c8c567ab94495ab5d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "8.1.32",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "V případech, kdy je nutné mezi eSSL a informačním systémem spravujícím dokumenty vyměňovat, popřípadě modifikovat metadata nad rámec specifikace jednotlivých funkcí (požadavek 8.1.8) nebo událostí (požadavky 8.1.10 a 8.1.11), jsou funkce a události vybaveny obecným elementem „DoplnujiciData\", který slouží pro specifikaci takovýchto metadat. Výčet a rozsah následného užití těchto metadat závisí na implementaci rozhraní mezi eSSL a informačním systémem spravujícím dokumenty.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f7ba5a663d4944d19c74",
            "id_mkh21fijkx4bety3t": 8132
          }
        },
        {
          "id": "id_c8e76c69f8a741f6b4b1",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "METADATA",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 9000
          }
        },
        {
          "id": "id_f8c7897c4aee4139b81c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Obecné požadavky na metadata",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_c8e76c69f8a741f6b4b1",
            "id_mkh21fijkx4bety3t": 9100
          }
        },
        {
          "id": "id_201cebcf80fb4c258142",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli stanovit další metadata entit nad rámec přílohy č. 8 a definovat, který prvek metadat je povinný a který volitelný.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f8c7897c4aee4139b81c",
            "id_mkh21fijkx4bety3t": 9101
          }
        },
        {
          "id": "id_7a4f5c085c084c6fb874",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL podporuje alespoň následující formáty prvků metadat: ➡",
            "id_mkh1re80717c6gqi7": "a) alfabetické,\nb) alfanumerické,\nc) numerické,\nd) časové,\ne) logické („ANO/NE\").",
            "id_mkh1ruycu0iq9beiq": "id_f8c7897c4aee4139b81c",
            "id_mkh21fijkx4bety3t": 9102
          }
        },
        {
          "id": "id_d52b64f2995847c49bd5",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje správcovské roli stanovit, které hodnoty prvků metadat mají být zapsány a udržovány ručně a které výběrem z číselníku.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_f8c7897c4aee4139b81c",
            "id_mkh21fijkx4bety3t": 9103
          }
        },
        {
          "id": "id_d5c1225695054c159bee",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Požadavky na metadata datových balíčků SIP",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_c8e76c69f8a741f6b4b1",
            "id_mkh21fijkx4bety3t": 9200
          }
        },
        {
          "id": "id_fd4d5aa726774b0b8aa8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí vytvoření datového balíčku SIP přílohy č. 2 skládajícího se z adresáře (složky) ➡",
            "id_mkh1re80717c6gqi7": "a) pro provedení skartačního řízení (výběr archiválií),\nb) pro předání dokumentů do archivu.\nDatový balíček SIP (LABEL=\"Datový balíček pro předávání dokumentů a jejich metadat do archivu\") vytvořený podle písm. b) může být použit i pro provedení skartačního řízení (pro výběr archiválií).",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9201
          }
        },
        {
          "id": "id_84b880270cfd4d6fac7b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že datový balíček SIP je tvořen ➡",
            "id_mkh1re80717c6gqi7": "a) právě jedním dílem typového spisu, a to případně včetně entit, které k němu byly podle předchozí právní úpravy připojeny pevnými křížovými odkazy,\nb) právě jedním spisem,\nc) spisy, pokud jsou navzájem propojeny pevnými křížovými odkazy,\nd) právě jedním samostatným dokumentem, pokud byl podle předchozí právní úpravy zatříděn přímo do věcné skupiny.\nPísmeno d) se použije obdobně i na dokumenty samostatné evidence dokumentů, která sama nevytváří spisy.",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9202
          }
        },
        {
          "id": "id_755fa86cdecd4a898a77",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že datový balíček SIP obsahuje veškerá metadata a komponenty vložených entit.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9203
          }
        },
        {
          "id": "id_08ccd4531870408ab6e2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že součástí datového balíčku SIP jsou příslušné části transakčního protokolu ve formátu XML, které se týkají vložených entit.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9204
          }
        },
        {
          "id": "id_71fd00ab1df647dca443",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že adresář (složka) obsahuje soubor XML a případně adresář pro uložení dalších komponent. Do adresáře pro uložení dalších souborů, pokud je vytvářen, se vždy vkládají alespoň všechny verze komponenty, které již jsou ve výstupním datovém formátu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9205
          }
        },
        {
          "id": "id_c8cccd08f3894f0db51e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že soubor XML je pojmenován „mets.xml\". Příklad: jednoznacny_nazev_sip [dir] |-mets.xml",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9206
          }
        },
        {
          "id": "id_0d083b1e13364f47970a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že každý soubor XML popisuje právě jeden datový balíček SIP. Není možné v jednom souboru XML popisovat více datových balíčků SIP.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9207
          }
        },
        {
          "id": "id_bb9dc5d443ed480f9c23",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že základní logická struktura souboru XML podle přílohy č. 2 odpovídá předepsanému schématu XML METS 1.12. Obsah souboru XML je dále specifikován podmínkami použití prvků schématu XML METS podle přílohy č. 2, část 2. Tyto podmínky jsou závazné pro určení správnosti datového balíčku SIP.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9208
          }
        },
        {
          "id": "id_9c079df157014feabd9d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.9",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že znakovou sadou souboru XML je Unicode/UCS v kódování UTF 8 bez BOM (Byte order mark).",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9209
          }
        },
        {
          "id": "id_6dc5079280544995b3f2",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.10",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že komponenty se ukládají do adresáře (složky) s názvem „komponenty\". Příklad: ➡",
            "id_mkh1re80717c6gqi7": "jednoznacny_nazev_sip [dir] |-komponenty [dir]\n|-nazev_souboru_pdfA.pdf\n|-mets.xml",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9210
          }
        },
        {
          "id": "id_37832245ddb342f18ca6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.11",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že datový balíček SIP je komprimován do souboru v datovém formátu ZIP. ESSL zajistí, že soubor ZIP je pojmenován stejným způsobem jako adresář (složka) datového balíčku SIP. Příklad: ➡",
            "id_mkh1re80717c6gqi7": "jednoznacny_nazev_sip.zip\n|- jednoznacny_nazev_sip [dir]\n|-komponenty [dir]\n|-nazev_souboru_pdfA.pdf\n|-mets.xml",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9211
          }
        },
        {
          "id": "id_45a70f708e5e477088a8",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.12",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že název datového balíčku SIP je v rámci eSSL jedinečný, přičemž obsahuje pouze písmena latinské abecedy bez diakritiky, čísla a znaky „_\" (podtržítko) a „--\" (pomlčka) a jeho délka nepřekročí 64 znaků.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9212
          }
        },
        {
          "id": "id_70a40def1654466c87b6",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.2.13",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajistí, že v případě použití datového balíčku SIP pro předávání dokumentů a jejich metadat do příslušného archivu se hodnoty metadat neliší od metadat použitých v datovém balíčku SIP pro provedení skartačního řízení, s výjimkou informací o ukládacích jednotkách, množství, komponentách a skartačním řízení.",
            "id_mkh1re80717c6gqi7": "Datový balíček SIP pro předávání dokumentů a jejich metadat do příslušného archivu musí vždy obsahovat alespoň komponenty, které byly do výběru navrženy a které byly vybrány za archiválie. Datový balíček SIP může obsahovat komponenty navíc, například jinou verzi komponenty, komponentu s novým pořadovým číslem apod.\nDatové formáty všech komponent předávaných k trvalému uložení do příslušného archivu se řídí Formátovými pravidly Národního archivu. Aktuální Formátová pravidla Národního archivu jsou dostupná na <https://portal.nacr.cz/cro/uvodnistranka/formatova-pravidla-narodniho-archivu/>",
            "id_mkh1ruycu0iq9beiq": "id_d5c1225695054c159bee",
            "id_mkh21fijkx4bety3t": 9213
          }
        },
        {
          "id": "id_02c6bd751592421bbf6d",
          "values": {
            "id_mkh1pocm7xx7x2o65": "9.3",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Přílohy",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_c8e76c69f8a741f6b4b1",
            "id_mkh21fijkx4bety3t": 9300
          }
        },
        {
          "id": "id_6b6f771ea29a49a0b623",
          "values": {
            "id_mkh1pocm7xx7x2o65": "10",
            "id_mkh1qnmnopixirtd0": "Kapitola",
            "id_mkh1qykht8oczv5nv": "DOKUMENTACE ŽIVOTNÍHO CYKLU",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "",
            "id_mkh21fijkx4bety3t": 10000
          }
        },
        {
          "id": "id_c031b01191c548139d6c",
          "values": {
            "id_mkh1pocm7xx7x2o65": "10.1",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "Dokumentace informačního systému spravujícího dokumenty",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_6b6f771ea29a49a0b623",
            "id_mkh21fijkx4bety3t": 10100
          }
        },
        {
          "id": "id_ba9a9b744f6842c4becc",
          "values": {
            "id_mkh1pocm7xx7x2o65": "10.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Dokumentace informačního systému spravujícího dokumenty vedená původcem obsahuje alespoň tyto údaje: ➡",
            "id_mkh1re80717c6gqi7": "a) název a verze informačního systému spravujícího dokumenty jako obchodního produktu (pokud je informační systém spravující dokumenty tvořen více obchodními produkty, pak musí být uvedeny všechny názvy obchodních produktů a jejich verzí),\nb) obchodní firma dodavatele informačního systému spravujícího dokumenty,\nc) datum uvedení informačního systému spravujícího dokumenty do zkušebního provozu,\nd) datum uvedení informačního systému spravujícího dokumenty do řádného provozu,\ne) datum získání atestu eSSL a verze eSSL pro kterou atest platí,\nf) početní nebo kapacitní omezení uváděná dodavatelem, alespoň tato: - nejvyšší možný počet dokumentů, které je možné uložit a zpracovat v celém systému za stanovené časové období podle požadavku 2.7.2,\n- nejvyšší možný počet dokumentů, které je možné vložit do jednoho spisu vedeného v systému,\n- nejvyšší možný počet spisů, který je možné založit a zpracovat v celém systému za stanovené časové období podle požadavků 2.7.2 a 3.3.9,\n- maximálně možná datová velikost komponenty,\n- nejvyšší možný počet uživatelů,\n- nejvyšší možný počet uživatelských a správcovských rolí,\n- nejvyšší možný počet věcných skupin a jejich úrovní hierarchie, které je možné založit a zpracovat v celém systému,\n- nejvyšší možný počet skartačních režimů, které je možné založit a zpracovávat v celém systému.\ng) informace, zda byla do informačního systému spravujícího dokumenty migrována data z předcházejícího systému, a charakteristika těchto dat (zejména v jakém časovém rozmezí byla v dřívějším systému pořizována),\nh) informace, zda je informační systém spravující dokumenty pouze evidencí, nebo spravuje komponenty,\ni) odkaz na jiný informační systém spravující dokumenty, pokud je informační systém spravující dokumenty s ním propojen, a informace, zda se tak děje prostřednictvím rozhraní podle kapitoly 8.1,\nj) informace o významných změnách informačního systému spravujícího dokumenty (například informace o změnách datové struktury a migracích eSSL na jeho nové verze),\nk) datum ukončení provozu informačního systému spravujícího dokumenty,\nl) technická charakteristika informačního systému spravujícího dokumenty, zejména použité technologie a databáze,\nm) věcná charakteristika informačního systému spravujícího dokumenty, zejména určení části agendy původce, na niž se vztahuje (rozsah zpracovávaných dat),\nn) přehled právních předpisů vztahujících se k obsahu informačního systému spravujícího dokumenty, pokud se nejedná o eSSL,\no) údaje o poskytování otevřených dat nebo přístupu externích subjektů do informačního systému spravujícího dokumenty,\np) přehled správcovských rolí a správců informačního systému spravujícího dokumenty a jejich zařazení v organizační struktuře původce,\nq) přehled uživatelských rolí a jejich charakteristika.",
            "id_mkh1ruycu0iq9beiq": "id_c031b01191c548139d6c",
            "id_mkh21fijkx4bety3t": 10101
          }
        },
        {
          "id": "id_e957fcba5687471f9cea",
          "values": {
            "id_mkh1pocm7xx7x2o65": "10.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Dokumentace informačního systému spravujícího dokumenty vedená původcem musí být uložena v takové podobě, která zajistí její dostupnost a čitelnost lidskými smysly i v případě havárie informačního systému spravujícího dokumenty.",
            "id_mkh1re80717c6gqi7": "Požadavek neznamená, že předepsaná dokumentace musí být pouze v listinné podobě. Dokumentace může být i v elektronické podobě, ale musí být uložena mimo informační systém spravující dokumenty, kterého se týká.",
            "id_mkh1ruycu0iq9beiq": "id_c031b01191c548139d6c",
            "id_mkh21fijkx4bety3t": 10102
          }
        },
        {
          "id": "id_dc5dd23c41954302a70b",
          "values": {
            "id_mkh1pocm7xx7x2o65": "10.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL vede po celou dobu provozu detailní popis umožňující původci identifikovat ➡",
            "id_mkh1re80717c6gqi7": "a) verzi atestované eSSL (případně všech jejích částí),\nb) aktuálně provozovanou verzi eSSL nasazenou v produkčním prostředí,\nc) popis a rozsah změn provozované eSSL oproti atestované verzi,\nd) jaké patche byly aplikovány a\ne) zda byla s novou verzí změněna funkčnost eSSL, s uvedením důvodů a důsledků těchto změn pro původce.",
            "id_mkh1ruycu0iq9beiq": "id_c031b01191c548139d6c",
            "id_mkh21fijkx4bety3t": 10103
          }
        }
      ],
      "_filteredRecords": [
        {
          "id": "id_abc91b4a7e3e4a4db80c",
