        },
        {
          "id": "id_98631cb147234660a1df",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automaticky čísluje všechny verze komponent dokumentu.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2101
          }
        },
        {
          "id": "id_1b16260d747d409bb312",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je přijímaný dokument složen z několika komponent, eSSL přijme všechny jeho komponenty a dále spravuje dokument jako jedinou entitu tak, aby byly zachovány vztahy mezi komponentami a aby byla uchována struktura dokumentu.",
            "id_mkh1re80717c6gqi7": "ESSL současně automaticky zaznamená počet komponent do metadat dokumentu.",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2102
          }
        },
        {
          "id": "id_8cf3717bb11747d7ae49",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při příjmu komponenty dokumentu automaticky identifikuje její datový formát, včetně verze formátu podle vnitřní struktury komponenty. ESSL tyto informace ukládá do metadat komponenty.",
            "id_mkh1re80717c6gqi7": "Informace pro automatickou identifikaci datových formátů poskytuje například registr PRONOM (www.nationalarchives.gov.uk/PRONOM/).",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2103
          }
        },
        {
          "id": "id_564bfd04f16b4998879a",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL přijímá entity a metadata v souladu s XML schématy uvedenými v přílohách č. 1, 5, 6 a 8.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2104
          }
        },
        {
          "id": "id_b6feb099dd164c61815e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL od příjmu do vyřazení entity průběžně zaznamenává metadata v rozsahu podle přílohy č. 8.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2105
          }
        },
        {
          "id": "id_f4e7fef6d41e48d3b93e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožní předat doručený dokument příslušné fyzické osobě, pokud byl určen k rukám nebo do vlastních rukou.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2106
          }
        },
        {
          "id": "id_dd26599005f24dab9acd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.7",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL na pokyn uživatelské role při příjmu dokumentu neuloží komponentu dokumentu v případě, že se jedná o komponentu v nepřijímaném datovém formátu, nepřijímané velikosti nebo s jinou vadou, na jejímž základě je odesílatel vyzván k opravě vad dokumentu. ESSL nahradí neuloženou komponentu ztvárněním informací o důvodu jejího neuložení do nové komponenty.",
            "id_mkh1re80717c6gqi7": "ESSL vždy zaznamená údaje o odesílateli a datu doručení dokumentu bez ohledu na uložení, nebo neuložení jeho komponent.",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2107
          }
        },
        {
          "id": "id_daec939e2e0947b18264",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.1.8",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL při příjmu zaznamená do metadat velikost jednotlivých komponent obsažených v datové zprávě doručené datovou schránkou.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_1f0077e3c56248b5b76d",
            "id_mkh21fijkx4bety3t": 2108
          }
        },
        {
          "id": "id_5482b3599faa42418cfa",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2",
            "id_mkh1qnmnopixirtd0": "Podkapitola",
            "id_mkh1qykht8oczv5nv": "E-mailové schránky",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_abc91b4a7e3e4a4db80c",
            "id_mkh21fijkx4bety3t": 2200
          }
        },
        {
          "id": "id_223e4f031cd140cab359",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.1",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL zajišťuje stahování a odesílání e-mailových zpráv ➡",
            "id_mkh1re80717c6gqi7": "a) automatizované stahování a uložení e-mailových zpráv doručených na elektronické adresy podatelny,\nb) odesílání e-mailových zpráv prostřednictvím elektronické adresy podatelny.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2201
          }
        },
        {
          "id": "id_ab9f369f97a849028a5e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.2",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL prostřednictvím funkčního rozšíření poštovního klienta nebo prostředky eSSL umožňuje uživatelské roli přijetí touto rolí vybrané e-mailové zprávy, která byla doručena na jinou e-mailovou adresu, než je elektronická adresa podatelny.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2202
          }
        },
        {
          "id": "id_62cae93acd0140ce85c9",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.3",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "Pokud je e-mailová zpráva přijata, eSSL uchová jako samostatné komponenty dokumentu ➡",
            "id_mkh1re80717c6gqi7": "a) e-mailovou zprávu v původním formátu postupem podle požadavku 2.4.2,\nb) obsah (tělo) e-mailové zprávy a\nc) jednotlivé připojené přílohy.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2203
          }
        },
        {
          "id": "id_52c9468add1f45248bf4",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.4",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL z přijaté e-mailové zprávy automaticky vyjímá následující metadata (pokud jsou obsažena v hlavičce e-mailové zprávy): ➡",
            "id_mkh1re80717c6gqi7": "a) datum a čas odeslání e-mailové zprávy,\nb) předmět (věc),\nc) odesílatel e-mailové zprávy ve vazbě na jmenný rejstřík.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2204
          }
        },
        {
          "id": "id_e57deab1f6b64645a24e",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.5",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL umožňuje uživatelské roli při příjmu e-mailové zprávy upravit metadata automaticky vyjmutá z e-mailové zprávy podle požadavku 2.2.4.",
            "id_mkh1re80717c6gqi7": "",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2205
          }
        },
        {
          "id": "id_e05eac5ec1d7443f9cfd",
          "values": {
            "id_mkh1pocm7xx7x2o65": "2.2.6",
            "id_mkh1qnmnopixirtd0": "Požadavek",
            "id_mkh1qykht8oczv5nv": "ESSL automatizovaně zašle potvrzení ➡",
            "id_mkh1re80717c6gqi7": "a) o přijetí zprávy,\nb) o nepřijetí/vadě zprávy.",
            "id_mkh1ruycu0iq9beiq": "id_5482b3599faa42418cfa",
            "id_mkh21fijkx4bety3t": 2206
          }
        },
        {
