      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "Má název úkonu služby",
        "a_mwc9hh0csqr9ae": "e_mwc2p0or12tlpe",
        "a_mwc9hh0che9pfu": "Vlastnost",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/osvědčení-digitálního-úkonu/2024-10-17/#konceptuální-vlastnost-úkon-služby-veřejné-správy-má-název-úkonu-služby-https://slovník.gov.cz/agendový/104/pojem/má-název-úkonu-služby",
        "a_mwc9hh0c72g0xj": "Povinná",
        "a_mwc9hh0ct15cx9": "Podobně jako u služby se jedná o srozumitelný a výstižný název úkonu, aby bylo klientovi jasné, co je účelem úkonu. Název úkonu by měl výstižně popsat konkrétní krok (např. podání žádosti, výzva k doložení/doplnění žádosti, atd.).",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/agendový/104/pojem/má-název-úkonu-služby",
        "a_mwc9hh0carsoyj": "1 - 1"
      },
