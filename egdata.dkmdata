    {
      "id": "e_mwc2ksfkersad0",
      "createdAt": "2026-11-11T12:02:48.131Z",
      "name": "Digitální objekt - Poskytovatel",
      "typeId": "ty_mwc9hh0ci2786z",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "Poskytovatel",
        "a_mwc9hh0csqr9ae": "e_mwc2ksfk361o1m",
        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/digitální-objekty/2020-07-01/#vazba-digitální-objekt-poskytovatel",
        "a_mwc9hh0cxpdoes": "poskytovatel",
        "a_mwc9hh0cflm1k4": "Člověk či osoba",
        "a_mwc9hh0cl2xzqn": "https://ofn.gov.cz/lidé-a-osoby/2020-07-01/#třída-člověk-či-osoba",
        "a_mwc9hh0ct15cx9": "Poskytovatel digitálního objektu je člověk či osoba, která datovou sadu nebo databázi poskytuje. Může, ale nemusí disponovat některým z níže specifikovaných práv, resp. na daný digitální objekt se nemusí vztahovat některý z ochranných režimů uvedených dále v této specifikaci. Každý digitální objekt tedy má svého poskytovatele. Typicky se jedná o člověka či osobu, která se rozhodla digitální objekt, tj. obrázek, datovou sadu, databázi, atd., poskytnout.",
        "a_mwc9hh0c0zaw12": "Statutární město Brno",
        "a_mwc9hh0c2bpm1m": "e_mwc2k5xxk8ak7g"
      },
      "relations": [
        {
          "id": "r_mwc9hh0xon1hb9",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
    {
      "id": "e_mwc2ksfkj1rw9i",
      "createdAt": "2026-11-11T12:02:48.131Z",
      "name": "Digitální objekt - Kurátor",
      "typeId": "ty_mwc9hh0ci2786z",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "Kurátor",
        "a_mwc9hh0csqr9ae": "e_mwc2ksfk361o1m",
        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/digitální-objekty/2020-07-01/#vazba-digitální-objekt-kurátor",
        "a_mwc9hh0cxpdoes": "kurátor",
        "a_mwc9hh0cflm1k4": "Člověk či osoba",
        "a_mwc9hh0cl2xzqn": "https://ofn.gov.cz/lidé-a-osoby/2020-07-01/#třída-člověk-či-osoba",
        "a_mwc9hh0ct15cx9": "Kurátor digitálního objektu je osoba, která např. datovou sadu nebo databázi spravuje. Může, ale nemusí disponovat některým z níže specifikovaných práv, resp. na daný digitální objekt se nemusí vztahovat některý z ochranných režimů uvedených dále v této specifikaci. Každý digitální objekt tedy má svého kurátora. Typicky se jedná o člověka či osobu, která s digitálním objektem, tj. obrázkem, datovou sadou, databází, atd., pracuje a podrobně \"se vyzná\" v její struktuře a obsahu.",
        "a_mwc9hh0c0zaw12": "Martin Dvořák, Statutární město Brno",
        "a_mwc9hh0c2bpm1m": "e_mwc2k5xxk8ak7g"
      },
      "relations": [
        {
          "id": "r_mwc9hh0x69h8yb",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
