      "name": "Úkon služby veřejné správy (OFN Dokumenty z formulářů pro elektronické podání dle ZoPDS)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Úkon služby veřejné správy",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/dokumenty-z-formulářů-ZoPDS/2024-10-04/#konceptuální-třída-úkon-služby-veřejné-správy-https://slovník.gov.cz/agendový/104/pojem/úkon-služby-veřejné-správy",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/agendový/104/pojem/úkon-služby-veřejné-správy",
        "a_mwc9hh0c17vtci": "e_mwc24p272dkd10",
        "a_mwc9hh0cmu3imh": "2024-10-04",
        "a_mwc9hh0clw5omv": "Úkon představuje jednotnou a ucelenou interakci mezi klientem a OVM (úředníkem), která je realizována určeným obslužným kanálem na jednom OVM a která má právní následky. Pomocí úkonu či série úkonů klient usiluje o dosažení výstupu dané služby VS.",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/dokumenty-z-formulářů-ZoPDS/2024-10-04/příklady/",
        "a_mwc9hh0ceikb4p": [
          "XML"
        ],
        "a_mwc9hh0cf7acc9": 2
      },
      "relations": [
        {
          "id": "r_mwc9hh10innwl0",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
