    {
      "id": "e_mwc2ksgblvl9aj",
      "createdAt": "2026-11-11T12:02:48.131Z",
      "name": "Kontejner (OFN Sběrné dvory)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Kontejner",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/sběrné-dvory/2022-04-19/#třída-kontejner",
        "a_mwc9hh0cf7acc9": 3,
        "a_mwc9hh0c17vtci": "e_mwc24p279awj95",
        "a_mwc9hh0cmu3imh": "2022-04-19",
        "a_mwc9hh0clw5omv": "Tato třída reprezentuje velkoobjemový kontejner. Kontejner může být odvezen jenom speciálnímy vozidly. Svoz je zabezpečován nepravidelně dle potřeb Střediska sběrného odpadu. V ulicích města se běžně takéto kontejnery nevyskytují. Kromě níže specifikovaných vlastností a vazeb je možné u této třídy použít také vlastnosti a vazby třídy Věc, která je specifikována otevřenou formální normou Věc .",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/sběrné-dvory/2022-04-19/příklady/",
        "a_mwc9hh0ceikb4p": [
          "JSON-LD"
        ],
        "a_mwc9hh0clypjxd": [
          "e_mwc2ksehakvra8"
        ],
        "a_mwc9hh0cpcqe8h": [
          "e_mwc2ksgcnspd08"
        ],
        "a_mwc9hh0cqbnpoe": "- Typy odpadů – https://data.mvcr.gov.cz/zdroj/číselníky/typy-tříděného-odpadu"
      },
      "relations": [
