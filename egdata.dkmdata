        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/registr-práv-a-povinností/dokumenty-převodu-agend/2024-09-01/#konceptuální-třída-rozhodnutí",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/500/2004/pojem/rozhodnutí",
