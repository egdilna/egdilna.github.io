    {
      "id": "e_mwc2p0n6xv9ti7",
      "createdAt": "2026-11-11T12:06:05.412Z",
      "name": "Fyzická osoba [89/2012 Sb.] (OFN Společné části elektronických dokumentů)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Fyzická osoba",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/společné-části-elektronických-dokumentů/2024-10-04/#konceptuální-třída-fyzická-osoba-https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/fyzická-osoba",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/fyzická-osoba",
        "a_mwc9hh0c17vtci": "e_mwc24p27gih6i7",
        "a_mwc9hh0cmu3imh": "2024-10-04",
        "a_mwc9hh0clw5omv": "Každý člověk má vrozená, již samotným rozumem a citem poznatelná přirozená práva, a tudíž se považuje za osobu. Zákon stanoví jen meze uplatňování přirozených práv člověka a způsob jejich ochrany. Člověk má právní osobnost od narození až do smrti.",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/společné-části-elektronických-dokumentů/2024-10-04/příklady/",
        "a_mwc9hh0ceikb4p": [
          "XML"
        ],
        "a_mwc9hh0cf7acc9": 5,
        "a_mwc9hh0cpcqe8h": [
          "e_mwc2p0n70u9gt6"
        ]
      },
