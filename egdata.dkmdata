      "attributes": {
        "a_mwc9hh0cn2y8ry": "Právnická osoba",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/společné-části-elektronických-dokumentů/2024-10-04/#konceptuální-třída-právnická-osoba-https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/právnická-osoba",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/právnická-osoba",
        "a_mwc9hh0c17vtci": "e_mwc24p27gih6i7",
        "a_mwc9hh0cmu3imh": "2024-10-04",
        "a_mwc9hh0clw5omv": "Právnická osoba je organizovaný útvar, o kterém zákon stanoví, že má právní osobnost, nebo jehož právní osobnost zákon uzná. Právnická osoba může bez zřetele na předmět své činnosti mít práva a povinnosti, které se slučují s její právní povahou. Právnická osoba má právní osobnost od svého vzniku do svého zániku.",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/společné-části-elektronických-dokumentů/2024-10-04/příklady/",
        "a_mwc9hh0ceikb4p": [
          "XML"
