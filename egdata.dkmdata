    {
      "id": "e_mwc2p0n9osk5i5",
      "createdAt": "2026-11-11T12:06:05.412Z",
      "name": "Fyzická osoba [304/2013 Sb.] (OFN Společné části elektronických dokumentů)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Fyzická osoba",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/společné-části-elektronických-dokumentů/2024-10-04/#konceptuální-třída-fyzická-osoba-https://slovník.gov.cz/legislativní/sbírka/304/2013/pojem/fyzická-osoba",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/304/2013/pojem/fyzická-osoba",
        "a_mwc9hh0c17vtci": "e_mwc24p27gih6i7",
        "a_mwc9hh0cmu3imh": "2024-10-04",
        "a_mwc9hh0clw5omv": "Fyzické osoby, 1. které jsou podnikateli, mají bydliště v České republice a požádají o zápis, a 2. uvedené v § 43, které podnikají na území České republiky, a požádají o zápis Fyzickou osobou se pro potřeby § 42 rozumí a) státní občan členského státu Evropské unie, jiného státu tvořícího Evropský hospodářský prostor nebo Švýcarské konfederace, b) rodinný příslušník osoby uvedené v písmeni a) oprávněný pobývat na území České republiky, c) státní občan třetího státu, kterému bylo v členském státě Evropské unie přiznáno právní postavení dlouhodobě pobývajícího rezidenta, d) rodinný příslušník osoby uvedené v písmeni c), kterému bylo na území České republiky vydáno povolení k dlouhodobému pobytu, a e) další fyzická osoba, které vzniklo právo podnikat podle živnostenského zákona nebo jiného zákona.",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/společné-části-elektronických-dokumentů/2024-10-04/příklady/",
        "a_mwc9hh0ceikb4p": [
          "XML"
        ],
        "a_mwc9hh0clypjxd": [
          "e_mwc2p0n21d5hpg"
        ],
        "a_mwc9hh0cf7acc9": 0
      },
      "relations": [
