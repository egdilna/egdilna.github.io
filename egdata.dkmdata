        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/registr-práv-a-povinností/oprávnění-k-přístupu-k-údajům/2024-10-03/#konceptuální-vlastnost-role-je-oprávněním-pro-roli",
        "a_mwc9hh0cflm1k4": "Oprávnění k přístupu k údajům",
        "a_mwc9hh0cl2xzqn": "https://ofn.gov.cz/registr-práv-a-povinností/oprávnění-k-přístupu-k-údajům/2024-10-03/#konceptuální-třída-oprávnění-k-přístupu-k-údajům",
        "a_mwc9hh0c72g0xj": "Nepovinná",
        "a_mwc9hh0ct15cx9": "Určuje roli, pro kterou je oprávnění k přístupu k údajům definováno. Oprávnění k přístupu k údajům může být definováno pro více rolí. Jedna role může mít definováno více oprávnění.",
