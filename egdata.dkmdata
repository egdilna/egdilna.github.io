    {
      "id": "e_mwc2rakd3t8in4",
      "createdAt": "2026-11-11T12:07:51.554Z",
      "name": "Informační systém veřejné správy (OFN DCAT-AP-CZ: Datová rozhraní)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Informační systém veřejné správy",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/dcat-ap-cz-datová-rozhraní/2026-09-23/cs/#InformačníSystémVeřejnéSprávy",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/365/2000/pojem/informační-systém-veřejné-správy",
        "a_mwc9hh0c17vtci": "e_mwc24p27z2ac5j",
        "a_mwc9hh0cmu3imh": "2026-09-23",
        "a_mwc9hh0clw5omv": "Informačním systémem veřejné správy se rozumí funkční celek nebo jeho část zabezpečující cílevědomou a systematickou informační činnost pro účely výkonu veřejné správy nebo plnění jiných funkcí státu anebo dalších veřejnoprávních korporací. Každý informační systém veřejné správy zahrnuje data, která jsou uspořádána tak, aby bylo možné jejich zpracování a zpřístupnění, provozní údaje a dále technické a programové prostředky, případně jiné nástroje umožňující výkon informačních činností",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/dcat-ap-cz-datová-rozhraní/2026-09-23/cs/příklady/",
        "a_mwc9hh0cf7acc9": 1,
        "a_mwc9hh0cqbnpoe": "- Datová sada – https://ofn.gov.cz/dcat-ap-cz-datová-rozhraní/2026-09-23/cs/#DatováSada",
        "a_mwc9hh0cpcqe8h": [
          "e_mwc2rak94seisu"
        ]
      },
