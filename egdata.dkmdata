        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/osvědčení-digitálního-úkonu/2024-10-17/#konceptuální-vlastnost-úkon-služby-veřejné-správy-má-identifikátor-úkonu-služby-https://slovník.gov.cz/agendový/104/pojem/má-identifikátor-úkonu-služby",
        "a_mwc9hh0c72g0xj": "Povinná",
        "a_mwc9hh0ct15cx9": "Automaticky (stejně jako v případě služby VS) generovaný kód sloužící pro databázové zpracování údajů.",
