        "a_mwc9hh0csqr9ae": "e_mwc2rast1eomqb",
        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/slovníky/2026-02-26/cs/#Pojem.máTypObsahuÚdaje",
