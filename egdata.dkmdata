        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/#vyšší-územní-samosprávní-celek",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/347/1997/pojem/vyšší-územní-samosprávní-celek",
