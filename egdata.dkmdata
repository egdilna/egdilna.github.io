        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/slovníky/2026-02-26/cs/#Pojem.máZpůsobSdíleníÚdaje",
        "a_mwc9hh0cxpdoes": "máZpůsobSdíleníÚdaje",
