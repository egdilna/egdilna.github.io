    {
      "id": "e_mwc2p0t0rbxoa9",
      "createdAt": "2026-11-11T12:06:05.412Z",
      "name": "Činnost - Je vázána na činnost",
      "typeId": "ty_mwc9hh0ci2786z",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "Je vázána na činnost",
        "a_mwc9hh0csqr9ae": "e_mwc2p0pnlm8utx",
        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/registr-práv-a-povinností/služby/2024-10-03/#konceptuální-vlastnost-činnost-je-vázána-na-činnost",
        "a_mwc9hh0cflm1k4": "Služba veřejné správy",
        "a_mwc9hh0cl2xzqn": "https://ofn.gov.cz/registr-práv-a-povinností/služby/2024-10-03/#konceptuální-třída-služba-veřejné-správy",
        "a_mwc9hh0c72g0xj": "Nepovinná",
        "a_mwc9hh0ct15cx9": "Činnosti dle zákona o základních registrech, které jsou relevantní pro danou službu VS v celém jejím procesu (od zahájení až po ukončení). Přiřazením činnosti je služba VS vázána na konkrétní vnitřní procesy (mj. oprávnění na přístupy k základním registrům a/nebo údajům v jiných agendách) a dochází k předvybrání OVM poskytujících službu. Vazba mezi činností a službou VS je různá – jedné službě VS může odpovídat jedna činnost, ale zpravidla to tak není a služba VS odpovídá několika činnostem, nebo se v rámci jedné činnosti poskytuje více služeb VS. Orgány veřejné moci či kategorie orgánů veřejné moci (dále jen OVM) realizující službu VS vyplývají z uvedených činností.",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/agendový/104/pojem/je-vázána-na-činnost",
        "a_mwc9hh0carsoyj": "0 - ∞",
        "a_mwc9hh0c2bpm1m": "e_mwc2p0svak0s0f"
      },
      "relations": [
        {
          "id": "r_mwc9hh14jt0t2h",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
