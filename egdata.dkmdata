    },
    {
      "id": "e_mwc2p0or8xrtaj",
      "createdAt": "2026-11-11T12:06:05.412Z",
      "name": "Služba veřejné správy (OFN Osvědčení digitálního úkonu)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Služba veřejné správy",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/osvědčení-digitálního-úkonu/2024-10-17/#konceptuální-třída-služba-veřejné-správy-https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/služba-veřejné-správy",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/111/2009/pojem/služba-veřejné-správy",
        "a_mwc9hh0c17vtci": "e_mwc24p27xbq76e",
        "a_mwc9hh0cmu3imh": "2024-10-17",
        "a_mwc9hh0clw5omv": "Služba veřejné správy představuje funkci (činnost) úřadu, která je vědomě poskytnuta konkrétním OVM konkrétnímu příjemci služby podle příslušného právního předpisu tak, že přináší příjemci vnímanou hodnotu, ať už v podobě benefitu nebo splnění zákonné povinnosti. Evidují se pouze takové služby VS, během nichž dochází k interakci mezi OVM a klientem či naopak, nikoli k interakci mezi OVM a OVM. Na službu VS lze také pohlížet jako na dosažení práva či naplnění povinnosti klienta, které nelze splnit jinak než interakcí či sérií interakcí mezi klientem a OVM. Služba se dělí podle toho, zdali je iniciována klientem nebo vykonávaná z moci úřední. Každá služba se skládá z nejméně jednoho úkonu.",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/osvědčení-digitálního-úkonu/2024-10-17/příklady/",
        "a_mwc9hh0ceikb4p": [
          "XML"
        ],
        "a_mwc9hh0cf7acc9": 3,
        "a_mwc9hh0cpcqe8h": [
          "e_mwc2p0onxgnx4t"
        ]
      },
      "relations": [
        {
          "id": "r_mwc9hh11mcl7mg",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
    {
      "id": "e_mwc2p0osf5ilpj",
      "createdAt": "2026-11-11T12:06:05.412Z",
      "name": "Služba veřejné správy - Má název služby",
      "typeId": "ty_mwc9hh0ci2786z",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "Má název služby",
        "a_mwc9hh0csqr9ae": "e_mwc2p0or8xrtaj",
        "a_mwc9hh0che9pfu": "Vlastnost",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/osvědčení-digitálního-úkonu/2024-10-17/#konceptuální-vlastnost-služba-veřejné-správy-má-název-služby-https://slovník.gov.cz/agendový/104/pojem/má-název-služby",
        "a_mwc9hh0c72g0xj": "Povinná",
        "a_mwc9hh0ct15cx9": "Název by měl klientovi stručně a jasně vystihnout, o jakou službu se jedná. Důležité je, aby byl nezaměnitelný s jinou službou, ale stále velmi jednoduchý, srozumitelný a zapamatovatelný. Měřítkem je, že název služby je používaný (bude používán) v běžném hovoru lidí.",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/agendový/104/pojem/má-název-služby",
        "a_mwc9hh0carsoyj": "1 - 1"
      },
