        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/dcat-ap-cz-360-2023/2025-08-12/cs/#Distribuce.máZpůsobZískáníDatSdílenýchRozhraním",
