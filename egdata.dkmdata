        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/registr-práv-a-povinností/služby/2024-10-03/#konceptuální-vlastnost-služba-veřejné-správy-je-poskytována-v-rámci-agendy",
        "a_mwc9hh0cflm1k4": "Agenda",
        "a_mwc9hh0cl2xzqn": "https://ofn.gov.cz/registr-práv-a-povinností/služby/2024-10-03/#konceptuální-třída-agenda",
        "a_mwc9hh0c72g0xj": "Nepovinná",
        "a_mwc9hh0ct15cx9": "Přiřazuje úkon do agendy, v rámci které je vykonáván. Úkon je vždy vykonáván v právě jedné agendě. V jedné agendě může být vykonáváno více úkonů.",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/agendový/104/pojem/je-poskytována-v-rámci-agendy",
        "a_mwc9hh0carsoyj": "0 - 1",
        "a_mwc9hh0c2bpm1m": "e_mwc2p0pmozqmxp"
