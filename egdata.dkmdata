      "attributes": {
        "a_mwc9hh0cn2y8ry": "Orgán veřejné moci nebo soukromoprávní uživatel údajů",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/registr-práv-a-povinností/agendy/2024-10-03/#konceptuální-třída-orgán-veřejné-moci-nebo-soukromoprávní-uživatel-údajů",
