        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/dcat-ap-cz-datová-rozhraní/2026-09-23/cs/#SpecifikacePodmínekUžití.originálníDatabáze",
        "a_mwc9hh0cxpdoes": "originálníDatabáze",
