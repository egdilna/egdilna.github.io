      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "Odůvodnění nevhodnosti digitalizace úkonu",
        "a_mwc9hh0csqr9ae": "e_mwc2p0t1ffqtgz",
        "a_mwc9hh0che9pfu": "Vlastnost",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/registr-práv-a-povinností/služby/2024-10-03/#konceptuální-vlastnost-úkon-služby-veřejné-správy-odůvodnění-nevhodnosti-digitalizace-úkonu",
        "a_mwc9hh0c72g0xj": "Nepovinná",
        "a_mwc9hh0ct15cx9": "Obsahuje odůvodnění, proč úkon nelze digitalizovat. Může být např. vysvětleno, že je nutná fyzická přítomnost konkrétní osoby, nebo že dochází k převzetí fyzické karty/osvědčení, kterou není možné digitalizovat. Dále může jít o mezinárodní úmluvu nebo právní předpis s aplikační předností, který stanovuje, že se musí jednat o fyzický dokument.",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/agendový/104/pojem/odůvodnění-nevhodnosti-digitalizace-úkonu",
        "a_mwc9hh0carsoyj": "0 - 1"
