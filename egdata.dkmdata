    {
      "id": "e_mwc2raufjsxhm0",
      "createdAt": "2026-11-11T12:07:51.554Z",
      "name": "Fyzická osoba (OFN Rejstříky svazků obcí)",
      "typeId": "ty_mwc9hh0c4h1x3u",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cn2y8ry": "Fyzická osoba",
        "a_mwc9hh0cqgee9o": "https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/#fyzická-osoba",
        "a_mwc9hh0cta2lg5": "https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/fyzická-osoba",
        "a_mwc9hh0c17vtci": "e_mwc24p277c6dwd",
        "a_mwc9hh0cmu3imh": "2026-04-01",
        "a_mwc9hh0clw5omv": "Každý člověk má vrozená, již samotným rozumem a citem poznatelná přirozená práva, a tudíž se považuje za osobu. Zákon stanoví jen meze uplatňování přirozených práv člověka a způsob jejich ochrany. Člověk má právní osobnost od narození až do smrti.",
        "a_mwc9hh0c8tbzot": "https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/příklady/",
        "a_mwc9hh0ceikb4p": [
          "JSON-LD"
        ],
        "a_mwc9hh0cf7acc9": 3,
        "a_mwc9hh0cqbnpoe": "- Bydliště fyzické osoby – https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/#bydliště-fyzické-osoby",
        "a_mwc9hh0cpcqe8h": [
          "e_mwc2raudk6ff3d"
        ]
      },
      "relations": [
        {
          "id": "r_mwc9hh1b3cmml4",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
    {
      "id": "e_mwc2raugxomghj",
      "createdAt": "2026-11-11T12:07:51.554Z",
      "name": "Fyzická osoba - jméno fyzické osoby",
      "typeId": "ty_mwc9hh0ci2786z",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "jméno fyzické osoby",
        "a_mwc9hh0csqr9ae": "e_mwc2raufjsxhm0",
        "a_mwc9hh0che9pfu": "Vlastnost",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/#jméno-fyzické-osoby",
        "a_mwc9hh0cflm1k4": "xsd:string",
        "a_mwc9hh0cl2xzqn": "http://www.w3.org/2001/XMLSchema#string",
        "a_mwc9hh0c72g0xj": "Povinná",
        "a_mwc9hh0ct15cx9": "Jméno člověka je jeho osobní jméno a příjmení, popřípadě jeho další jména a rodné příjmení, která mu podle zákona náležejí. Každý člověk má právo užívat své jméno v právním styku, stejně jako právo na ochranu svého jména a na úctu k němu.",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/jméno-fyzické-osoby",
        "a_mwc9hh0carsoyj": "1 - 1"
      },
      "relations": [
        {
          "id": "r_mwc9hh1bn023f2",
          "relationTypeId": "rt_mwc9hh0bglc9i6",
          "targetId": "e_mwc410t61lhldw"
        }
      ],
      "updatedAt": "2026-11-11T15:16:10.715Z"
    },
    {
      "id": "e_mwc2raugg7ie89",
      "createdAt": "2026-11-11T12:07:51.554Z",
      "name": "Fyzická osoba - má bydliště fyzické osoby",
      "typeId": "ty_mwc9hh0ci2786z",
      "inInbox": false,
      "archived": false,
      "aspects": [],
      "customAttributes": [],
      "comments": [],
      "objects": [],
      "attributes": {
        "a_mwc9hh0cah7faf": "má bydliště fyzické osoby",
        "a_mwc9hh0csqr9ae": "e_mwc2raufjsxhm0",
        "a_mwc9hh0che9pfu": "Vazba",
        "a_mwc9hh0c7z3kll": "https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/#má-bydliště-fyzické-osoby",
        "a_mwc9hh0cflm1k4": "Bydliště fyzické osoby",
        "a_mwc9hh0cl2xzqn": "https://ofn.gov.cz/rejstříky-svazků-obcí/2026-04-01/cs/#bydliště-fyzické-osoby",
        "a_mwc9hh0c72g0xj": "Nepovinná",
        "a_mwc9hh0ct15cx9": "Člověk má bydliště v místě, kde se zdržuje s úmyslem žít tam s výhradou změny okolností trvale; takový úmysl může vyplývat z jeho prohlášení nebo z okolností případu. Uvádí-li člověk jako své bydliště jiné místo než své skutečné bydliště, může se každý dovolat i jeho skutečného bydliště. Proti tomu, kdo se v dobré víře dovolá uvedeného místa, nemůže člověk namítat, že má své skutečné bydliště v jiném místě.",
        "a_mwc9hh0ckui2pm": "https://slovník.gov.cz/legislativní/sbírka/89/2012/pojem/má-bydliště-fyzické-osoby",
        "a_mwc9hh0carsoyj": "0 - 1",
        "a_mwc9hh0c2bpm1m": "e_mwc2raudk6ff3d"
      },
