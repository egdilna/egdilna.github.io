    {
      "id": "typesslaszajisteniukonupodatelny",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Zajištění úkonů podatelny před přijetím dokumentu",
      "určuje": "",
      "příznaky": "",
      "description": "Musí se zajistit úkony před příjmem, tedy zejména čitelnost dokumentu, antivirová kontrola atd. Fyzicky zajišťuje čitelnost úředník, technicky zajišťuje buď ESSL, nebo si třeba pro antivirus volá externí aplikaci, rozhodně o tom ale učiní příslušné záznamy do transakčního protokolu. I pokud byla antivirová kontrola před evidencí v podatelně, musí se to zapsat do logu."
    },
    {
      "id": "esslmodulschvalovani",
      "layer": "application",
      "type": "ApplicationComponent",
      "stereotype": "Komponenta IS",
      "name": "Modul Schvalování a podepisování",
      "určuje": "",
      "příznaky": "",
      "description": "Modul ESSL, v němž se realizuje interní schvalování dokumentů a obsahů spisů pro účely vnitřního projednání a také se v něm realizuje jednotlivé či dávkové podepisování, pečetění a další opatřování validačních prvků."
