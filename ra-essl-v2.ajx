  "elements": [
    {
      "id": "procesodesilanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Odesílání dokumentů",
      "určuje": "§ 18 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces/procesy odesílání či zveřejňování dokumentů. Dokumenty se odesílají určeným kanálem, nebo se zveřejňují (na úřední desce či jinou formou). Součástí odesílání dokumentů je i vypravení dokumentu určeným kanálem, tedy předání poště, odeslání e-mailem, nebo datovou schránkou, apod. U veřejnoprávních původců platí, že vždy musí být odesílaný dokument opatřen validačními prvky, v elektronické podobě pak kvalifikovaným podpisem či pečetí a kvalifikovaným časovým razítkem."
    },
    {
      "id": "procespodepisovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Podepisování dokumentů a užívání razítek",
      "určuje": "§ 17 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces validace dokumentů. Analogové dokumenty se opatřují datumem, vlastnoručním podpisem či razítkem (nebo úředním razítkem), digitální dokumenty se opatřují elektronickým podpisem, elektronickou pečetí a časovým razítkem. Původce je povinen opatřit jakýkoliv odesílaný dokument kvalifikovaným elektronickým podpisem, nebo kvalifikovanou elektronickou pečetí. Vždy jej také opatří kvalifikovaným časovým razítkem. Podepisování a ověřování se realizuje službami kvalifikovaného poskytovatele."
    },
    {
      "id": "legislativavyhlaska2592012",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Právní předpis",
      "name": "Vyhláška 259/2012 o podrobnostech výkonu spisové služby",
      "určuje": "zákon 499/2004",
      "příznaky": "",
      "description": "Vyhláška č. 259/2012 Sb., o podrobnostech výkonu spisové služby / Vyhláška stanovuje povinnosti procesů a výkonu spisové služby u původců. Je prováděcím předpisem zákona 499/2004 / http://www.zakonyprolidi.cz/cs/2012-259"
    },
    {
      "id": "ssr",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Vnitřní předpis",
      "name": "Spisový a skartační řád",
      "určuje": "",
      "příznaky": "",
      "description": "Spisový řád je povinným vnitřním předpisem původce, který původce vydává pro upřesnění procesů výkonu spisové služby, jednotlivých evidencí, užívaného ESSL, výjimek z evicence a dalších podrobností."
    },
    {
      "id": "legislativazakon4992004",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Právní předpis",
      "name": "Zákon 499/2004 o archivnictví a spisové službě",
      "určuje": "",
      "příznaky": "",
      "description": "Zákon č. 499/2004 Sb., o archivnictví a spisové službě / Upravuje oblast archivů a péče o archiválie. Především ale upravuje povinnosti spisové služby a povinnosti původců a archivů v oblasti spisové služby, včetně elektronických systémů spisové služby. / http://www.zakonyprolidi.cz/cs/2004-499"
    },
    {
      "id": "legislativansesss",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Závazný předpis",
      "name": "Národní standard pro elektronické systémy spisové služby (NSESS)",
      "určuje": "",
      "příznaky": "",
      "description": "Národní standard pro elektronické systémy spisové služby / Závazný standard podle zákona 499/2004 a vyhlášky 259/2012 obsahuje technické závazné požadavky na ESSL a ISSD a jejich funkcionality."
    },
    {
      "id": "verejnopravnipuvodce",
      "layer": "business",
      "type": "BusinessRole",
      "stereotype": "Role organizace",
      "name": "Veřejnoprávní původce",
      "určuje": "§ 3 a související zákona 499/2004",
      "příznaky": "",
      "description": "Veřejnoprávními původci jsou: organizační složky státu, ozbrojené síly, bezpečnostní sbory, státní příspěvkové organizace, státní podniky, územní samosprávné celky, organizační složky územních samosprávných celků, právnické osoby zřízené nebo založené územními samosprávnými celky, vysoké školy, školy a školská zařízení s výjimkou mateřských škol, výchovných a ubytovacích zařízení a zařízení školního stravování (dále jen „školy“), zdravotní pojišťovny, veřejné výzkumné instituce, právnické osoby zřízené zákonem"
    },
    {
      "id": "procesyssl",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Skupina",
      "name": "Procesy výkonu spisové služby",
      "určuje": "vyhláška 259/2012",
      "příznaky": "",
      "description": "Soubor základních procesů výkonu spisové službu původcem, je určen zejména procesní vyhláškou. Vykonávají se v ESSL."
    },
    {
      "id": "procesevidovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Evidování dokumentů",
      "určuje": "§ 8 až § 10 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces evidování dokumentů v ESSL či v evidenční pomůcce. Dokument který je doručen se eviduje v ESSL (probíhá jeho zaevidování) a to samé platí i u dokumentu vzniklého z vlastní činnosti původce. Identifikátory evidovaného dokumentu je [Jednoznačný identifikátor] a [Číslo jednací]. Pokud je evidován v samostatné evidenci, je to [Evidenční číslo ze samostatné evidence]."
    },
    {
      "id": "procesobehdokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Oběh dokumentů",
      "určuje": "§ 13 odst. 2 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces/procesy oběhu dokumentů s evidencí v ESSL/EP. Oběhem dokumentu se myslí jeho předávání mezi spisovými uzly či uživateli v organizaci původce. Předávání se realizuje ESSL či ISSD a u digitálního dokumentu obíhá přímo dokument i s digitálním obsahem, u analogového dokumentu se fyzicky předává obsah a v ESSL či ISSD se potvrzuje předání a převzetí. Po vyřízení dokumentu je posledním krokem oběhu dokumentu jeho uložení do spisovny."
    },
    {
      "id": "procesoznacovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Označování dokumentů",
      "určuje": "§ 7 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces přidělování ČJ a označování dokumentů čísly a identifikátory. Přidělí se [Číslo jednací], nebo je-li dokument evidován v samostatné evidenci tak [Evidenční číslo ze samostatné evidence]. Dokumentu se přiděluje i [Jednoznačný identifikátor] pod kterým je veden po celou dobu jeho životního cyklu. Součástí označování je i zařazení jako druhu dokumentu podle Spisového plánu a přiřazení skartačního znaku a skartační lhůty."
    },
    {
      "id": "procesprevoddokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Převod dokumentů",
      "určuje": "",
      "příznaky": "",
      "description": "Procesy převodu dokumentů a formátů dokumentů. Změna formátu do výstupního formátu. Převod z analogové podoby do digitální a to s využitím mechanismu [Autorizovaná konverze] nebo [Jiná konverze]. Nebo konverze z digitální podoby do analogové podoby."
    },
    {
      "id": "procesprijemdokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Příjem dokumentů",
      "určuje": "§ 2 až § 6 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces příjmu doručených dokumentů podatelnou a jejich zaevidování a postoupení k vyřízení. Součástí jsou i kroky spojené s příjmem dokumentů, jako je ověření jeho úplnosti a čitelnosti, ověření formátu u digitálních dokumentů a také ověření validačních prvků u dokumentu. Po zaevidování se odesílateli digitálního dokumentu doručeného e-mailem také zašle potvrzovací zpráva z podatelny. Příjem vždy realizuje podatelna."
    },
    {
      "id": "procesrozdelovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Rozdělování dokumentů",
      "určuje": "§ 13 odst. 1 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces rozdělování dokumentů a jejich přiřazení k vyřízení. Realizuje podatelna po zaevidování dokumentu. Podatelna postoupí (přidělí) dokument uživateli nebo spisovému uzlu k vyřízení. Jakékoliv další předání či postoupení dokumentu je součástí procesu [Oběh dokumentů]."
    },
    {
      "id": "processkartacnirizeni",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Skartační řízení",
      "určuje": "§ 20 až § 21 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Skartační řízení je proces, ve kterém se realizuje vyřazování dokumentů původce. Původce zpracuje z ESSL skartační návrh ze souborů, kterým již uplynula skartační lhůta a zašle jej ve formě XML/SIP balíčku archivu. Archiv vyhodnotí a vydá pokyn k předání archiválií a zničení ostatních dokumentů."
    },
    {
      "id": "procesukladanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Ukládání dokumentů",
      "určuje": "§ 19 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Procesy ukládání dokumentů v ESSL či metadat v ESSL. U živých dokumentů v rámci spisů a u uzavřených a vyřízených dokumentů ve Spisovně."
    },
    {
      "id": "procesvedenijr",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Vedení jmenného rejstříku",
      "určuje": "§ 25 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Původce je v rámci elektronické spisové služby povinen vést pro evidenční pomůcku Jmenný rejstřík, kde uchovává údaje o subjektech a především o vazbách subjektl na dokumenty vedené v evidenční pomůcce. V JR se vedou jako subjekty odesílatelé, příjemci a dotčené osoby k dokumentům a v případě potřeby další subjekty. Je nutné aktualizovat údaje o subjektech ze základních registrů, buď v roli OVM, nebo v roli SPUÚ."
    },
    {
      "id": "procesvyhotovovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Vyhotovování dokumentů",
      "určuje": "§ 16 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces vytváření dokumentů a jejich vyhotovení do finálního tvaru a formátu, včetně opatření validačními prvky. Dokument se vytvoŕí buď reakcí na existující dokument, nebo z koncepcu jeho povýšením, nebo importem komponent do ESSL. Za vlastní dokument se považuje až dokument povýšený či zaevidovaný. Po vytvoření obsahu dokumentu se musí převést do výstupního formátu, zkontrolovat jeho náležitosti a opatřit validačními prvky."
    },
    {
      "id": "procesvyrazovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Vyřazování dokumentů",
      "určuje": "§ 21 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces vyřazování dokumentů buď ve skartačním řízení, nebo mimo něj"
    },
    {
      "id": "procesvyrizovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Vyřizování dokumentů",
      "určuje": "§ 14 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces vyřizování dokumentů s jeho evidencí v ESSL. Jedná se o faktické vyřizování dokumentu a související věci (ve spisu) a o evidenci kroků týkajících se práce s dokumentem v rámci jeho vyřizování."
    },
    {
      "id": "proceszarazovanidokumentu",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Zařazování dokumentů",
      "určuje": "§ 12 odst. 1 vyhlášky 259/2012",
      "příznaky": "",
      "description": "Proces zařazování dokumentů do spisů a věcných skupin. Dokument musí být vždy ve spisu. Pokud ale více dokumentů se týká téže věci, vytváří se spis a dokumenty se zařazují či vkládají do spisu."
    },
    {
      "id": "esslmoduladministrace",
      "layer": "application",
      "type": "ApplicationComponent",
      "stereotype": "Komponenta IS",
      "name": "Modul Administrace ESSL",
      "určuje": "",
      "příznaky": "",
      "description": "Modul ESSL, který slouží pro administraci ESSL a pro realizaci správcovských činností a funkcí."
    },
    {
      "id": "typesslasadministraceevidencekonverzi",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Evidence konverzí",
      "určuje": "",
      "příznaky": "",
      "description": "Každá autorizovaná či jiná konverze realizovaná systémem je zapsána spolu s příslušnými údaji do evidence konverzí, ke které má přístup pouze uživatel se správcovskou rolí."
    },
    {
      "id": "typesslasadministraceoddelenaadministrace",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Oddělený modul administrace",
      "určuje": "",
      "příznaky": "",
      "description": "Systém má zcela oddělený modul pro správu a administraci, který smí použít pouze uživatel se správcovskou rolí."
    },
    {
      "id": "typesslasadministraceprenosovenotifikace",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Přenosové notifikace a zprávy",
      "určuje": "",
      "příznaky": "",
      "description": "Systém poskytuje zprávu popisující každou chybu v průběhu procesu přenosu, exportu, zničení nebo smazání. Zpráva identifikuje dokumenty, seskupení a s nimi spojená metadata, při jejichž přenosu se vyskytly chyby, a entity, které nebyly úspěšně přeneseny, exportovány, zničeny nebo smazány. Dále systém po skončení vytvoří zprávu popisující všechny chyby, které nastaly v průběhu importu. Zpráva identifikuje dokumenty, seskupení a s nimi spojená metadata, při jejichž importu se vyskytly chyby, a entity, které nebyly úspěšně importovány."
    },
    {
      "id": "typesslasadministracesestavyoskartaci",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Sestavy o skartačním řízení",
      "určuje": "",
      "příznaky": "",
      "description": "Systém podává zprávu o výsledku procesu výběru archiválií s uvedením věcných skupin, spisů, typových spisů, součástí, dílů a dokumentů, které byly úspěšně zničeny, přeneseny nebo exportovány, s uvedením případných chyb, které v průběhu procesu nastaly."
    },
    {
      "id": "typesslasadministracespravaciselniku",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Správa číselníků",
      "určuje": "",
      "příznaky": "",
      "description": "Systém umožňuje správcovské roli konfigurovat nabídkové seznamy, (číselníky), z nichž uživatel vybírá hodnoty metadat pro jejich zápis."
    },
    {
      "id": "typesslasadministracespravauzivateluaroli",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Správa uživatelů a rolí",
      "určuje": "",
      "příznaky": "",
      "description": "Systém umožňuje správcovským rolím, aby: a) přidělovaly oprávnění uživatelům a rolím a b) přiřadily jednoho nebo více uživatelů k jakékoli roli."
    },
    {
      "id": "typesslasadministracespravcovskaeditace",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Správcovská změna údajů",
      "určuje": "",
      "příznaky": "",
      "description": "Správcovským rolím je umožněno změnit jakýkoli uživatelem zapsaný prvek metadat. Vždy se taková operace i s odůvodněním zapíše do transakčního protokolu k dané entitě."
    },
    {
      "id": "typesslasadministracestatistickeprehledy",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Statistické a správní přehledy",
      "určuje": "",
      "příznaky": "",
      "description": "Systém poskytuje správcovské roli nástroje pro vedení údajů nutných ke statistickým zpracováním informací o činnosti v rámci spisového plánu (včetně údajů o počtu a velikosti věcných skupin, spisů, typových spisů, součástí, dílů nebo dokumentů vytvořených, uzavřených, smazaných nebo zničených v průběhu daného období)."
    },
    {
      "id": "typesslasadministracestorno",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Stornování záznamu",
      "určuje": "",
      "příznaky": "",
      "description": "Systém nabízí správci konfigurační možnost dokument nebo rozpracovaný dokument smazat – vyloučit z užívání."
    },
    {
      "id": "typesslasadministracetp",
      "layer": "application",
      "type": "ApplicationService",
      "stereotype": "Služba uživatelské funkcionality",
      "name": "Zobrazení, procházení a export transakčního protokolu",
      "určuje": "",
      "příznaky": "",
