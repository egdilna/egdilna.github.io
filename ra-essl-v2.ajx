      "příznaky": "",
      "description": "Jmenný rejstřík je neoddělitelnou součástí ESSL a každé evidence dokumentů, udržuje údaje o subjektech a jejich vazbách na dokumenty."
    },
    {
      "id": "typesslasjrdatovkaprirazeni",
      "layer": "application",
